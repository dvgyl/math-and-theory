'DominationULC.galvin_zhang_conjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
'DominationULC.galvin_zhang_normalized' depends on axioms: [propext, Classical.choice, Quot.sound]
'DominationULC.path_domination_weighted' depends on axioms: [propext, Classical.choice, Quot.sound]
'DominationULC.cycle_domination_weighted' depends on axioms: [propext, Classical.choice, Quot.sound]
DominationULC.galvin_zhang_conjecture (n ell : ℕ) :
  DominationULC.UltraLogConcave n (DominationULC.dominationCount (DominationULC.pathPower n ell)) ∧
    DominationULC.UltraLogConcave n (DominationULC.dominationCount (DominationULC.cyclePower n ell))
DominationULC.galvin_zhang_normalized (n ell k : ℕ) (hk : 1 ≤ k) (hkn : k < n) :
  ↑(DominationULC.dominationCount (DominationULC.pathPower n ell) (k - 1)) / ↑(n.choose (k - 1)) *
        (↑(DominationULC.dominationCount (DominationULC.pathPower n ell) (k + 1)) / ↑(n.choose (k + 1))) ≤
      (↑(DominationULC.dominationCount (DominationULC.pathPower n ell) k) / ↑(n.choose k)) ^ 2 ∧
    ↑(DominationULC.dominationCount (DominationULC.cyclePower n ell) (k - 1)) / ↑(n.choose (k - 1)) *
        (↑(DominationULC.dominationCount (DominationULC.cyclePower n ell) (k + 1)) / ↑(n.choose (k + 1))) ≤
      (↑(DominationULC.dominationCount (DominationULC.cyclePower n ell) k) / ↑(n.choose k)) ^ 2
DominationULC.path_domination_weighted (n ell k : ℕ) (hk : 1 ≤ k) (hkn : k < n) :
  (k + 1) * (n - k + 1) * DominationULC.dominationCount (DominationULC.pathPower n ell) (k - 1) *
      DominationULC.dominationCount (DominationULC.pathPower n ell) (k + 1) ≤
    k * (n - k) * DominationULC.dominationCount (DominationULC.pathPower n ell) k ^ 2
DominationULC.cycle_domination_weighted (n ell k : ℕ) (hk : 1 ≤ k) (hkn : k < n) :
  (k + 1) * (n - k + 1) * DominationULC.dominationCount (DominationULC.cyclePower n ell) (k - 1) *
      DominationULC.dominationCount (DominationULC.cyclePower n ell) (k + 1) ≤
    k * (n - k) * DominationULC.dominationCount (DominationULC.cyclePower n ell) k ^ 2
'DominationULC.galvin_zhang_conjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
'DominationULC.galvin_zhang_normalized' depends on axioms: [propext, Classical.choice, Quot.sound]
'DominationULC.path_domination_weighted' depends on axioms: [propext, Classical.choice, Quot.sound]
'DominationULC.cycle_domination_weighted' depends on axioms: [propext, Classical.choice, Quot.sound]
