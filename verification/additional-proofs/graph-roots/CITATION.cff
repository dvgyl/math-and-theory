cff-version: 1.2.0
message: "Please cite the unpublished manuscript using the preferred citation."
title: "Sharp escape of complex domination roots in square flowers"
authors:
  - family-names: Goyal
    given-names: Dev D.
license: Apache-2.0
abstract: >-
  The largest modulus R_n of a domination root of n squares sharing one
  vertex satisfies an explicit Lambert-W upper bound and
  4n/R_n^2 = log(4n) - log log(4n) + o(1).
  Complete real-root classifications and motion are companion results.
  Lean sources cover all numbered theorem conclusions. Historical priority
  remains provisional.
preferred-citation:
  type: article
  title: "Sharp escape of complex domination roots in square flowers"
  authors:
    - family-names: Goyal
      given-names: Dev D.
  year: 2026
  notes: "Unpublished manuscript. No claim of first priority."
