noncomputable def traceTwo012Real35 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo012Real34 z k)-(traceTwo012Real28 z k)

theorem traceTwo012Step35_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.sub (traceTwo012Step34 k) (traceTwo012Step28 k)) (traceTwo012Step35 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step35 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step35 k) = traceTwo012Real35 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step35_identity k)]
  simp only [SparsePolynomial.eval_sub, eval_traceTwo012Step34, eval_traceTwo012Step28, traceTwo012Real35]


