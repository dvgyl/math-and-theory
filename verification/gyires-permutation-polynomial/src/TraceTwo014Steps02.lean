noncomputable def traceTwo014Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo014Real11 z k)

theorem traceTwo014Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo014Step11 k)) (traceTwo014Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo014Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo014Step12 k) = traceTwo014Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo014Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo014Step11, traceTwo014Real12]


