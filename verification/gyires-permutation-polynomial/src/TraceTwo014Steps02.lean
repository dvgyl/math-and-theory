theorem eval_traceTwo014Step11 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo014Step11 k) = traceTwo014Real11 z k := by
  rw [eval_of_same _ _ _ (traceTwo014Step11_identity k)]
