  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^10))

theorem traceTwo014Step10_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order010 k)) (traceTwo014Step10 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo014Step10 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo014Step10 k) = traceTwo014Real10 z k := by
  rw [eval_of_same _ _ _ (traceTwo014Step10_identity k)]
