  ((realA z k*realC z k))*(traceTwo017Real16 z k)

theorem traceTwo017Step17_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo017Step16 k)) (traceTwo017Step17 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo017Step17 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo017Step17 k) = traceTwo017Real17 z k := by
  rw [eval_of_same _ _ _ (traceTwo017Step17_identity k)]
