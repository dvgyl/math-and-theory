theorem fp_order_011_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpOrder010 k)) (fpOrder011 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_fpOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpOrder011 k) = (realA z k*realC z k)^11 := by
  rw [eval_of_same _ _ _ (fp_order_011_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpOrder010]
  rw [← pow_succ']


