theorem gap_order_019_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 19 (squareOrder019 k) (gramOrder019 k)) (gapOrder019 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_019_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder019 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder019 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder019 k) =
      permanentSquareExpr 19 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder019 z k
  · exact eval_cpOrder019 z k
  · simpa using eval_uOrder019 z k
  · simpa using eval_vOrder019 z k
  · simpa using eval_wOrder019 z k
  · exact eval_fpOrder019 z k
  · exact eval_signed_power (evaluator z) (fpOrder019 k) 19
      (realA z k*realC z k) (eval_fpOrder019 z k)

theorem eval_gramOrder019 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder019 k) =
      gramExpr 19 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 19 (realA z k) (realB z k) (realC z k)
    (fpOrder019 k) (t1Order019 k) (t2Order019 k)
    (eval_fpOrder019 z k) (eval_t1Order019 z k) (eval_t2Order019 z k)

theorem eval_gapOrder019 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder019 k) =
      rawGap 19 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_019_identity k)]
  exact eval_gapJoin (evaluator z) 19 (realA z k) (realB z k) (realC z k)
    (squareOrder019 k) (gramOrder019 k) (eval_squareOrder019 z k) (eval_gramOrder019 z k)

theorem chamber_order_019_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 19 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder019]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_019_coefficients k)

theorem cycle_order_019_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 19) a b c
    dimensionConstant 19 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 19 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 19 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 19 chamber_order_019_nonneg ha hb hc

