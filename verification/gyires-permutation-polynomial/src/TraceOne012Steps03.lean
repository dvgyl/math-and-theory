noncomputable def traceOne012Real13 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceOne012Real12 z k)+(traceOne012Real10 z k)

theorem traceOne012Step13_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceOne012Step12 k) (traceOne012Step10 k)) (traceOne012Step13 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne012Step13 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne012Step13 k) = traceOne012Real13 z k := by
  rw [eval_of_same _ _ _ (traceOne012Step13_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceOne012Step12, eval_traceOne012Step10, traceOne012Real13]


