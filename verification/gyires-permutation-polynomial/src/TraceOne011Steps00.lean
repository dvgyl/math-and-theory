theorem traceOne011Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (t1Order010 k)) (traceOne011Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne011Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne011Step01 k) = traceOne011Real01 z k := by
  rw [eval_of_same _ _ _ (traceOne011Step01_identity k)]
