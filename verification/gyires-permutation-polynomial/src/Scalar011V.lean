theorem v_order_011_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarVB k) (scalarVD k)
      (vOrder009 k) (vOrder010 k)) (vOrder011 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_vOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (vOrder011 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k))
        (SparsePolynomial.eval (evaluator z) (scalarVD k)) 11 := by
  rw [eval_of_same _ _ _ (v_order_011_identity k)]
  exact eval_scalarStep (evaluator z) (scalarVB k) (scalarVD k)
    (vOrder009 k) (vOrder010 k) 9
    (eval_vOrder009 z k) (eval_vOrder010 z k)

