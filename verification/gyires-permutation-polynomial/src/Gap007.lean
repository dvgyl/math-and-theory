theorem gap_order_007_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 7 (squareOrder007 k) (gramOrder007 k)) (gapOrder007 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_007_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder007 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder007 k) =
      permanentSquareExpr 7 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder007 z k
  · exact eval_cpOrder007 z k
  · simpa using eval_uOrder007 z k
  · simpa using eval_vOrder007 z k
  · simpa using eval_wOrder007 z k
  · exact eval_fpOrder007 z k
  · exact eval_signed_power (evaluator z) (fpOrder007 k) 7
      (realA z k*realC z k) (eval_fpOrder007 z k)

theorem eval_gramOrder007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder007 k) =
      gramExpr 7 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 7 (realA z k) (realB z k) (realC z k)
    (fpOrder007 k) (t1Order007 k) (t2Order007 k)
    (eval_fpOrder007 z k) (eval_t1Order007 z k) (eval_t2Order007 z k)

theorem eval_gapOrder007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder007 k) =
      rawGap 7 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_007_identity k)]
  exact eval_gapJoin (evaluator z) 7 (realA z k) (realB z k) (realC z k)
    (squareOrder007 k) (gramOrder007 k) (eval_squareOrder007 z k) (eval_gramOrder007 z k)

theorem chamber_order_007_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 7 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder007]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_007_coefficients k)

theorem cycle_order_007_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 7) a b c
    dimensionConstant 7 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 7 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 7 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 7 chamber_order_007_nonneg ha hb hc

