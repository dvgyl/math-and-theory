def squareOrder007 (k : Fin 3) : Polynomial :=
  squareJoin (apOrder007 k) (cpOrder007 k) (uOrder007 k) (vOrder007 k) (wOrder007 k) (fpOrder007 k)
    (SparsePolynomial.mul (SparsePolynomial.const ((-1 : ℤ)^7)) (fpOrder007 k))

def gramOrder007 (k : Fin 3) : Polynomial :=
  gramJoin (fpOrder007 k) (t1Order007 k) (t2Order007 k)

