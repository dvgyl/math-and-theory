noncomputable def apOrder022 : Fin 3 → Polynomial :=
  ![PackedData.decodeBlocks 47 2 [(1, 70368744177666)],
    PackedData.decodeBlocks 112 42 [(32, ), (13, )],
    PackedData.decodeBlocks 47 2 [(1, 70368744177666)]]

theorem ap_order_022_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareA k) (apOrder021 k)) (apOrder022 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_apOrder022 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (apOrder022 k) = (realA z k)^44 := by
  rw [eval_of_same _ _ _ (ap_order_022_identity k), SparsePolynomial.eval_mul,
    eval_squareA, eval_apOrder021]
  rw [← pow_add]

