noncomputable def traceOne011Real09 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceOne011Real08 z k)

theorem traceOne011Step09_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceOne011Step08 k)) (traceOne011Step09 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne011Step09 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne011Step09 k) = traceOne011Real09 z k := by
  rw [eval_of_same _ _ _ (traceOne011Step09_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceOne011Step08, traceOne011Real09]

