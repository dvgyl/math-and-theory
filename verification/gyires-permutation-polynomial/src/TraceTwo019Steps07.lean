noncomputable def traceTwo019Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo019Real31 z k)+(traceTwo019Real13 z k)

theorem traceTwo019Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo019Step31 k) (traceTwo019Step13 k)) (traceTwo019Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo019Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo019Step32 k) = traceTwo019Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo019Step32_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceTwo019Step31, eval_traceTwo019Step13, traceTwo019Real32]


