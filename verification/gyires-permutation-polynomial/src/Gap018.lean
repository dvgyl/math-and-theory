theorem gap_order_018_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 18 (squareOrder018 k) (gramOrder018 k)) (gapOrder018 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_018_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder018 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder018 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder018 k) =
      permanentSquareExpr 18 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder018 z k
  · exact eval_cpOrder018 z k
  · simpa using eval_uOrder018 z k
  · simpa using eval_vOrder018 z k
  · simpa using eval_wOrder018 z k
  · exact eval_fpOrder018 z k
  · exact eval_signed_power (evaluator z) (fpOrder018 k) 18
      (realA z k*realC z k) (eval_fpOrder018 z k)

theorem eval_gramOrder018 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder018 k) =
      gramExpr 18 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 18 (realA z k) (realB z k) (realC z k)
    (fpOrder018 k) (t1Order018 k) (t2Order018 k)
    (eval_fpOrder018 z k) (eval_t1Order018 z k) (eval_t2Order018 z k)

theorem eval_gapOrder018 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder018 k) =
      rawGap 18 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_018_identity k)]
  exact eval_gapJoin (evaluator z) 18 (realA z k) (realB z k) (realC z k)
    (squareOrder018 k) (gramOrder018 k) (eval_squareOrder018 z k) (eval_gramOrder018 z k)

theorem chamber_order_018_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 18 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder018]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_018_coefficients k)

theorem cycle_order_018_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 18) a b c
    dimensionConstant 18 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 18 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 18 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 18 chamber_order_018_nonneg ha hb hc

