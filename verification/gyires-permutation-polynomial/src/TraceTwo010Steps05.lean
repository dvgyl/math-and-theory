noncomputable def traceTwo010Real21 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo010Real20 z k)

theorem traceTwo010Step21_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo010Step20 k)) (traceTwo010Step21 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo010Step21 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo010Step21 k) = traceTwo010Real21 z k := by
  rw [eval_of_same _ _ _ (traceTwo010Step21_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo010Step20, traceTwo010Real21]

