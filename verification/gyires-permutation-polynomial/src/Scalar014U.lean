theorem u_order_014_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k)
      (uOrder012 k) (uOrder013 k)) (uOrder014 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (uOrder014 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 14 := by
  rw [eval_of_same _ _ _ (u_order_014_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uOrder012 k) (uOrder013 k) 12
    (eval_uOrder012 z k) (eval_uOrder013 z k)

