noncomputable def traceTwo018Real13 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo018Real12 z k)

theorem traceTwo018Step13_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo018Step12 k)) (traceTwo018Step13 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo018Step13 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step13 k) = traceTwo018Real13 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step13_identity k)]
