  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^14))

theorem traceTwo018Step14_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order014 k)) (traceTwo018Step14 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo018Step14 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step14 k) = traceTwo018Real14 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step14_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order014, traceTwo018Real14]

