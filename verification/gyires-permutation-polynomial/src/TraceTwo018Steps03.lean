theorem eval_traceTwo018Step16 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step16 k) = traceTwo018Real16 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step16_identity k)]
