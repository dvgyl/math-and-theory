noncomputable def traceOne015Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^14))

theorem traceOne015Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (t1Order014 k)) (traceOne015Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne015Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne015Step01 k) = traceOne015Real01 z k := by
  rw [eval_of_same _ _ _ (traceOne015Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_t1Order014, traceOne015Real01]

