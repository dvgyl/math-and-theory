noncomputable def traceTwo020Real08 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo020Real07 z k)

theorem traceTwo020Step08_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo020Step07 k)) (traceTwo020Step08 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step08 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step08 k) = traceTwo020Real08 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step08_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo020Step07, traceTwo020Real08]


