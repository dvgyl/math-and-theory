noncomputable def traceTwo015Real22 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(traceTwo015Real21 z k)

theorem traceTwo015Step22_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (traceTwo015Step21 k)) (traceTwo015Step22 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step22 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step22 k) = traceTwo015Real22 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step22_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramD, eval_traceTwo015Step21, traceTwo015Real22]

