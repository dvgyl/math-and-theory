theorem gap_order_015_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 15 (squareOrder015 k) (gramOrder015 k)) (gapOrder015 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_015_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder015 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder015 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder015 k) =
      permanentSquareExpr 15 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder015 z k
  · exact eval_cpOrder015 z k
  · simpa using eval_uOrder015 z k
  · simpa using eval_vOrder015 z k
  · simpa using eval_wOrder015 z k
  · exact eval_fpOrder015 z k
  · exact eval_signed_power (evaluator z) (fpOrder015 k) 15
      (realA z k*realC z k) (eval_fpOrder015 z k)

theorem eval_gramOrder015 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder015 k) =
      gramExpr 15 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 15 (realA z k) (realB z k) (realC z k)
    (fpOrder015 k) (t1Order015 k) (t2Order015 k)
    (eval_fpOrder015 z k) (eval_t1Order015 z k) (eval_t2Order015 z k)

theorem eval_gapOrder015 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder015 k) =
      rawGap 15 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_015_identity k)]
  exact eval_gapJoin (evaluator z) 15 (realA z k) (realB z k) (realC z k)
    (squareOrder015 k) (gramOrder015 k) (eval_squareOrder015 z k) (eval_gramOrder015 z k)

theorem chamber_order_015_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 15 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder015]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_015_coefficients k)

theorem cycle_order_015_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 15) a b c
    dimensionConstant 15 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 15 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 15 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 15 chamber_order_015_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
