def t1Order007Input (k : Fin 3) : Fin 4 → Polynomial :=
  ![oneInitial (gramD k) (gramE k) (gramF k) 3, t1Four k, t1Five k, t1Six k]

theorem t1_order_007_identity (k : Fin 3) :
    SparsePolynomial.same (oneStep (gramD k) (gramE k) (gramF k) (t1Order007Input k))
      (t1Order007 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_t1Order007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t1Order007 k) =
      Matrix.trace (PermutationTransfer.transferOne
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^7) := by
  rw [eval_of_same _ _ _ (t1_order_007_identity k)]
  have h := eval_oneStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (t1Order007Input k) 3 ?_
  · simpa using h
  · intro i
    fin_cases i
    · simpa [t1Order007Input] using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) (3 : Fin 4)
    · simpa [t1Order007Input] using eval_t1Four z k
    · simpa [t1Order007Input] using eval_t1Five z k
    · simpa [t1Order007Input] using eval_t1Six z k

