noncomputable def traceOne014Real04 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^11))

theorem traceOne014Step04_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t1Order011 k)) (traceOne014Step04 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne014Step04 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne014Step04 k) = traceOne014Real04 z k := by
  rw [eval_of_same _ _ _ (traceOne014Step04_identity k)]
