noncomputable def traceTwo016Real21 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo016Real20 z k)

theorem traceTwo016Step21_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo016Step20 k)) (traceTwo016Step21 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo016Step21 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo016Step21 k) = traceTwo016Real21 z k := by
  rw [eval_of_same _ _ _ (traceTwo016Step21_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo016Step20, traceTwo016Real21]

