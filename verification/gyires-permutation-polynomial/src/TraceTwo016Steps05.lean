noncomputable def traceTwo016Real22 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(traceTwo016Real21 z k)

theorem traceTwo016Step22_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (traceTwo016Step21 k)) (traceTwo016Step22 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo016Step22 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo016Step22 k) = traceTwo016Real22 z k := by
  rw [eval_of_same _ _ _ (traceTwo016Step22_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramD, eval_traceTwo016Step21, traceTwo016Real22]

