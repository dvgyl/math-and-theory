theorem w_order_008_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k)
      (wSix k 6) (wOrder007 k)) (wOrder008 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_wOrder008 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (wOrder008 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) 8 := by
  rw [eval_of_same _ _ _ (w_order_008_identity k)]
  exact eval_scalarStep (evaluator z) (scalarWB k) (scalarWD k)
    (wSix k 6) (wOrder007 k) 6
    (eval_wSix z k 6 (by omega)) (eval_wOrder007 z k)

