noncomputable def traceTwo017Real35 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo017Real34 z k)-(traceTwo017Real28 z k)

theorem traceTwo017Step35_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.sub (traceTwo017Step34 k) (traceTwo017Step28 k)) (traceTwo017Step35 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo017Step35 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo017Step35 k) = traceTwo017Real35 z k := by
  rw [eval_of_same _ _ _ (traceTwo017Step35_identity k)]
