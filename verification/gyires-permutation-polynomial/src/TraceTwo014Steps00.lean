theorem traceTwo014Step02_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (t2Order012 k)) (traceTwo014Step02 k) = true := by
  fin_cases k <;> decide +kernel

