theorem ap_five_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareA k) (apFour k)) (apFive k) = true := by
  fin_cases k <;> decide +kernel

theorem cp_five_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareC k) (cpFour k)) (cpFive k) = true := by
  fin_cases k <;> decide +kernel

theorem fp_five_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpFour k)) (fpFive k) = true := by
  fin_cases k <;> decide +kernel

def t1FiveInput (k : Fin 3) : Fin 4 → Polynomial := ![oneInitial (gramD k) (gramE k) (gramF k) 1, oneInitial (gramD k) (gramE k) (gramF k) 2, oneInitial (gramD k) (gramE k) (gramF k) 3, t1Four k]

theorem t1_five_identity (k : Fin 3) :
    SparsePolynomial.same (oneStep (gramD k) (gramE k) (gramF k) (t1FiveInput k)) (t1Five k) = true := by
  fin_cases k <;> decide +kernel

theorem t2_five_identity (k : Fin 3) :
    SparsePolynomial.same (twoInitial (gramD k) (gramE k) (gramF k) 5) (t2Five k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_apFive (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (apFive k) = (realA z k)^10 := by
  rw [eval_of_same _ _ _ (ap_five_identity k), SparsePolynomial.eval_mul,
    eval_squareA, eval_apFour]
  rw [← pow_add]

theorem eval_cpFive (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (cpFive k) = (realC z k)^10 := by
  rw [eval_of_same _ _ _ (cp_five_identity k), SparsePolynomial.eval_mul,
    eval_squareC, eval_cpFour]
  rw [← pow_add]

theorem eval_fpFive (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpFive k) = (realA z k*realC z k)^5 := by
  rw [eval_of_same _ _ _ (fp_five_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpFour]
  rw [← pow_succ']

theorem eval_t1Five (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t1Five k) =
      Matrix.trace (PermutationTransfer.transferOne
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^5) := by
  rw [eval_of_same _ _ _ (t1_five_identity k)]
  have h := eval_oneStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (t1FiveInput k) 1 ?_
  · simpa using h
  · intro i
    fin_cases i
    · simpa [t1FiveInput] using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) (1 : Fin 4)
    · simpa [t1FiveInput] using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) (2 : Fin 4)
    · simpa [t1FiveInput] using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) (3 : Fin 4)
    · simpa [t1FiveInput] using eval_t1Four z k

theorem eval_t2Five (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t2Five k) =
      Matrix.trace (PermutationTransfer.transferTwo
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^5) := by
  rw [eval_of_same _ _ _ (t2_five_identity k)]
  simpa using eval_twoInitial (evaluator z) (gramD k) (gramE k) (gramF k) (5 : Fin 6)

