  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^8))

theorem traceTwo014Step23_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order008 k)) (traceTwo014Step23 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo014Step23 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo014Step23 k) = traceTwo014Real23 z k := by
  rw [eval_of_same _ _ _ (traceTwo014Step23_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order008, traceTwo014Real23]

