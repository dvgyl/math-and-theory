theorem u_initial_zero (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.const 2) (uData k 0) = true := by
  fin_cases k <;> decide +kernel

theorem u_initial_one (k : Fin 3) :
    SparsePolynomial.same (scalarUB k) (uData k 1) = true := by
  fin_cases k <;> decide +kernel

theorem u_steps (k : Fin 3) (n : ℕ) (hn : n+2 ≤ 4) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k) (uData k n) (uData k (n+1)))
      (uData k (n+2)) = true := by
  have hn2 : n ≤ 2 := by omega
  interval_cases n <;> fin_cases k <;> decide +kernel

theorem eval_uData (z : Fin 3 → ℝ) (k : Fin 3) (n : ℕ) (hn : n ≤ 4) :
    SparsePolynomial.eval (evaluator z) (uData k n) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) n :=
  eval_scalar_prefix (evaluator z) (scalarUB k) (scalarUD k) (uData k) 4
    (u_initial_zero k) (u_initial_one k) (u_steps k) n hn

end MathAndTheory.Gyires.PermutationCoefficientStage
