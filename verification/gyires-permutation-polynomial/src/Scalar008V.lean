      powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k))
        (SparsePolynomial.eval (evaluator z) (scalarVD k)) 8 := by
  rw [eval_of_same _ _ _ (v_order_008_identity k)]
  exact eval_scalarStep (evaluator z) (scalarVB k) (scalarVD k)
    (vSix k 6) (vOrder007 k) 6
