theorem v_order_008_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarVB k) (scalarVD k)
      (vSix k 6) (vOrder007 k)) (vOrder008 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_vOrder008 (z : Fin 3 → ℝ) (k : Fin 3) :
