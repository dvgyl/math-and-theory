noncomputable def traceTwo016Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo016Real31 z k)+(traceTwo016Real13 z k)

theorem traceTwo016Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo016Step31 k) (traceTwo016Step13 k)) (traceTwo016Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo016Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo016Step32 k) = traceTwo016Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo016Step32_identity k)]
