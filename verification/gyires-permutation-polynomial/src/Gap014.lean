theorem gap_order_014_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 14 (squareOrder014 k) (gramOrder014 k)) (gapOrder014 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_014_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder014 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder014 k) =
      permanentSquareExpr 14 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder014 z k
  · exact eval_cpOrder014 z k
  · simpa using eval_uOrder014 z k
  · simpa using eval_vOrder014 z k
  · simpa using eval_wOrder014 z k
  · exact eval_fpOrder014 z k
  · exact eval_signed_power (evaluator z) (fpOrder014 k) 14
      (realA z k*realC z k) (eval_fpOrder014 z k)

theorem eval_gramOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder014 k) =
      gramExpr 14 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 14 (realA z k) (realB z k) (realC z k)
    (fpOrder014 k) (t1Order014 k) (t2Order014 k)
    (eval_fpOrder014 z k) (eval_t1Order014 z k) (eval_t2Order014 z k)

theorem eval_gapOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder014 k) =
      rawGap 14 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_014_identity k)]
  exact eval_gapJoin (evaluator z) 14 (realA z k) (realB z k) (realC z k)
    (squareOrder014 k) (gramOrder014 k) (eval_squareOrder014 z k) (eval_gramOrder014 z k)

theorem chamber_order_014_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 14 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder014]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_014_coefficients k)

theorem cycle_order_014_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 14) a b c
    dimensionConstant 14 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 14 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 14 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 14 chamber_order_014_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
