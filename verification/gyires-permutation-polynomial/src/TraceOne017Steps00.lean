noncomputable def traceOne017Real02 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^15))

theorem traceOne017Step02_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t1Order015 k)) (traceOne017Step02 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne017Step02 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne017Step02 k) = traceOne017Real02 z k := by
  rw [eval_of_same _ _ _ (traceOne017Step02_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t1Order015, traceOne017Real02]

