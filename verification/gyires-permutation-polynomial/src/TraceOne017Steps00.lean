noncomputable def traceOne017Real04 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^14))

theorem traceOne017Step04_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t1Order014 k)) (traceOne017Step04 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne017Step04 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne017Step04 k) = traceOne017Real04 z k := by
  rw [eval_of_same _ _ _ (traceOne017Step04_identity k)]
