theorem fp_order_014_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpOrder013 k)) (fpOrder014 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_fpOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpOrder014 k) = (realA z k*realC z k)^14 := by
  rw [eval_of_same _ _ _ (fp_order_014_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpOrder013]
  rw [← pow_succ']


