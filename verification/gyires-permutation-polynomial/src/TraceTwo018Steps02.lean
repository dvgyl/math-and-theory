noncomputable def traceTwo018Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo018Real11 z k)

theorem traceTwo018Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo018Step11 k)) (traceTwo018Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo018Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step12 k) = traceTwo018Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo018Step11, traceTwo018Real12]


