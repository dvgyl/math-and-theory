theorem gap_order_008_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 8 (squareOrder008 k) (gramOrder008 k)) (gapOrder008 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_008_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder008 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder008 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder008 k) =
      permanentSquareExpr 8 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder008 z k
  · exact eval_cpOrder008 z k
  · simpa using eval_uOrder008 z k
  · simpa using eval_vOrder008 z k
  · simpa using eval_wOrder008 z k
  · exact eval_fpOrder008 z k
  · exact eval_signed_power (evaluator z) (fpOrder008 k) 8
      (realA z k*realC z k) (eval_fpOrder008 z k)

theorem eval_gramOrder008 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder008 k) =
      gramExpr 8 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 8 (realA z k) (realB z k) (realC z k)
    (fpOrder008 k) (t1Order008 k) (t2Order008 k)
    (eval_fpOrder008 z k) (eval_t1Order008 z k) (eval_t2Order008 z k)

theorem eval_gapOrder008 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder008 k) =
      rawGap 8 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_008_identity k)]
  exact eval_gapJoin (evaluator z) 8 (realA z k) (realB z k) (realC z k)
    (squareOrder008 k) (gramOrder008 k) (eval_squareOrder008 z k) (eval_gramOrder008 z k)

theorem chamber_order_008_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 8 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder008]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_008_coefficients k)

theorem cycle_order_008_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 8) a b c
    dimensionConstant 8 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 8 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 8 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 8 chamber_order_008_nonneg ha hb hc

