theorem ap_four_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.pow (squareA k) 4) (apFour k) = true := by
  fin_cases k <;> decide +kernel

theorem cp_four_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.pow (squareC k) 4) (cpFour k) = true := by
  fin_cases k <;> decide +kernel

theorem fp_four_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.pow (gramF k) 4) (fpFour k) = true := by
  fin_cases k <;> decide +kernel

theorem t1_four_identity (k : Fin 3) :
    SparsePolynomial.same (oneStep (gramD k) (gramE k) (gramF k) (oneInitial (gramD k) (gramE k) (gramF k))) (t1Four k) = true := by
  fin_cases k <;> decide +kernel

theorem t2_four_identity (k : Fin 3) :
    SparsePolynomial.same (twoInitial (gramD k) (gramE k) (gramF k) 4) (t2Four k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_apFour (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (apFour k) = (realA z k)^8 := by
  rw [eval_of_same _ _ _ (ap_four_identity k), SparsePolynomial.eval_pow]
  simp only [eval_squareA, ← pow_mul]

theorem eval_cpFour (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (cpFour k) = (realC z k)^8 := by
  rw [eval_of_same _ _ _ (cp_four_identity k), SparsePolynomial.eval_pow]
  simp only [eval_squareC, ← pow_mul]

theorem eval_fpFour (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpFour k) = (realA z k*realC z k)^4 := by
  rw [eval_of_same _ _ _ (fp_four_identity k), SparsePolynomial.eval_pow]
  simp only [eval_gramF]

theorem eval_t1Four (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t1Four k) =
      Matrix.trace (PermutationTransfer.transferOne
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^4) := by
  rw [eval_of_same _ _ _ (t1_four_identity k)]
  have h := eval_oneStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (oneInitial (gramD k) (gramE k) (gramF k)) 0
    (fun i => by simpa using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) i)
  simpa using h

theorem eval_t2Four (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t2Four k) =
      Matrix.trace (PermutationTransfer.transferTwo
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^4) := by
  rw [eval_of_same _ _ _ (t2_four_identity k)]
  simpa using eval_twoInitial (evaluator z) (gramD k) (gramE k) (gramF k) (4 : Fin 6)

