theorem fp_order_016_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpOrder015 k)) (fpOrder016 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_fpOrder016 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpOrder016 k) = (realA z k*realC z k)^16 := by
  rw [eval_of_same _ _ _ (fp_order_016_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpOrder015]
  rw [← pow_succ']


