module

public import PackedPolynomialData
public import Powers020

@[expose] public section

namespace MathAndTheory.Gyires.PermutationCoefficientStage

open MathAndTheory.Gyires.PermutationFinite
open MathAndTheory.Gyires.PermutationCoefficientRecurrence

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

noncomputable def apOrder021 : Fin 3 → Polynomial :=
  ![PackedData.decodeBlocks 45 2 [(1, 17592186044418)],
    PackedData.decodeBlocks 107 40 [(32, ), (11, )],
    PackedData.decodeBlocks 45 2 [(1, 17592186044418)]]

theorem ap_order_021_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareA k) (apOrder020 k)) (apOrder021 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_apOrder021 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (apOrder021 k) = (realA z k)^42 := by
  rw [eval_of_same _ _ _ (ap_order_021_identity k), SparsePolynomial.eval_mul,
    eval_squareA, eval_apOrder020]
  rw [← pow_add]

