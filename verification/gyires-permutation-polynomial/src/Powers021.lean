theorem cp_order_021_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareC k) (cpOrder020 k)) (cpOrder021 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_cpOrder021 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (cpOrder021 k) = (realC z k)^42 := by
  rw [eval_of_same _ _ _ (cp_order_021_identity k), SparsePolynomial.eval_mul,
