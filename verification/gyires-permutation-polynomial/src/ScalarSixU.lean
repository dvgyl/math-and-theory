theorem u_six_zero (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.const 2) (uSix k 0) = true := by
  fin_cases k <;> decide +kernel

theorem u_six_one (k : Fin 3) :
    SparsePolynomial.same (scalarUB k) (uSix k 1) = true := by
  fin_cases k <;> decide +kernel

theorem u_six_steps (k : Fin 3) (n : ℕ) (hn : n+2 ≤ 6) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k) (uSix k n) (uSix k (n+1)))
      (uSix k (n+2)) = true := by
  have hn4 : n ≤ 4 := by omega
  interval_cases n <;> fin_cases k <;> decide +kernel

theorem eval_uSix (z : Fin 3 → ℝ) (k : Fin 3) (n : ℕ) (hn : n ≤ 6) :
    SparsePolynomial.eval (evaluator z) (uSix k n) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) n :=
  eval_scalar_prefix (evaluator z) (scalarUB k) (scalarUD k) (uSix k) 6
    (u_six_zero k) (u_six_one k) (u_six_steps k) n hn

