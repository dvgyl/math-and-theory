noncomputable def traceTwo018Real17 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo018Real16 z k)

theorem traceTwo018Step17_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo018Step16 k)) (traceTwo018Step17 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo018Step17 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step17 k) = traceTwo018Real17 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step17_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo018Step16, traceTwo018Real17]

