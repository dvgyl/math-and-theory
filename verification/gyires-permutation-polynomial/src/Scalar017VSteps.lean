noncomputable def scalarV017Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (SparsePolynomial.eval (evaluator z) (scalarVB k)) * (powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k)) (SparsePolynomial.eval (evaluator z) (scalarVD k)) 16)

theorem scalarV017Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (scalarVB k) (vOrder016 k)) (scalarV017Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_scalarV017Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (scalarV017Step01 k) = scalarV017Real01 z k := by
  rw [eval_of_same _ _ _ (scalarV017Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_vOrder016, scalarV017Real01]

