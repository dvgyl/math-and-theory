theorem fp_order_018_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpOrder017 k)) (fpOrder018 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_fpOrder018 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpOrder018 k) = (realA z k*realC z k)^18 := by
  rw [eval_of_same _ _ _ (fp_order_018_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpOrder017]
  rw [← pow_succ']


