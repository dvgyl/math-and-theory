  fin_cases k <;> decide +kernel

theorem eval_scalarV020Step03 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (scalarV020Step03 k) = scalarV020Real03 z k := by
  rw [eval_of_same _ _ _ (scalarV020Step03_identity k)]
