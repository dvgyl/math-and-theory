noncomputable def traceTwo013Real04 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^11))

theorem traceTwo013Step04_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order011 k)) (traceTwo013Step04 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo013Step04 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo013Step04 k) = traceTwo013Real04 z k := by
  rw [eval_of_same _ _ _ (traceTwo013Step04_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order011, traceTwo013Real04]


