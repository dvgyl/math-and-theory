noncomputable def traceTwo013Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^12))

theorem traceTwo013Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (t2Order012 k)) (traceTwo013Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo013Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo013Step01 k) = traceTwo013Real01 z k := by
  rw [eval_of_same _ _ _ (traceTwo013Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramD, eval_t2Order012, traceTwo013Real01]

