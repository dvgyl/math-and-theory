noncomputable def traceTwo017Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo017Real31 z k)+(traceTwo017Real13 z k)

theorem traceTwo017Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo017Step31 k) (traceTwo017Step13 k)) (traceTwo017Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo017Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo017Step32 k) = traceTwo017Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo017Step32_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceTwo017Step31, eval_traceTwo017Step13, traceTwo017Real32]


