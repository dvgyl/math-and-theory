noncomputable def traceTwo020Real35 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo020Real34 z k)-(traceTwo020Real28 z k)

theorem traceTwo020Step35_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.sub (traceTwo020Step34 k) (traceTwo020Step28 k)) (traceTwo020Step35 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step35 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step35 k) = traceTwo020Real35 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step35_identity k)]
  simp only [SparsePolynomial.eval_sub, eval_traceTwo020Step34, eval_traceTwo020Step28, traceTwo020Real35]


