  ((realA z k*realC z k))*(traceTwo016Real14 z k)

theorem traceTwo016Step15_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo016Step14 k)) (traceTwo016Step15 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo016Step15 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo016Step15 k) = traceTwo016Real15 z k := by
  rw [eval_of_same _ _ _ (traceTwo016Step15_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo016Step14, traceTwo016Real15]

