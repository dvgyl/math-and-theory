noncomputable def traceTwo016Real13 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo016Real12 z k)

theorem traceTwo016Step13_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo016Step12 k)) (traceTwo016Step13 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo016Step13 (z : Fin 3 → ℝ) (k : Fin 3) :
