theorem w_order_007_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k)
      (wSix k 5) (wSix k 6)) (wOrder007 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_wOrder007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (wOrder007 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) 7 := by
  rw [eval_of_same _ _ _ (w_order_007_identity k)]
  exact eval_scalarStep (evaluator z) (scalarWB k) (scalarWD k)
    (wSix k 5) (wSix k 6) 5
    (eval_wSix z k 5 (by omega)) (eval_wSix z k 6 (by omega))

