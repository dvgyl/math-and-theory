noncomputable def traceTwo019Real08 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo019Real07 z k)

theorem traceTwo019Step08_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo019Step07 k)) (traceTwo019Step08 k) = true := by
  fin_cases k <;> decide +kernel

