theorem gap_order_017_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 17 (squareOrder017 k) (gramOrder017 k)) (gapOrder017 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_017_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder017 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder017 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder017 k) =
      permanentSquareExpr 17 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder017 z k
  · exact eval_cpOrder017 z k
  · simpa using eval_uOrder017 z k
  · simpa using eval_vOrder017 z k
  · simpa using eval_wOrder017 z k
  · exact eval_fpOrder017 z k
  · exact eval_signed_power (evaluator z) (fpOrder017 k) 17
      (realA z k*realC z k) (eval_fpOrder017 z k)

theorem eval_gramOrder017 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder017 k) =
      gramExpr 17 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 17 (realA z k) (realB z k) (realC z k)
    (fpOrder017 k) (t1Order017 k) (t2Order017 k)
    (eval_fpOrder017 z k) (eval_t1Order017 z k) (eval_t2Order017 z k)

theorem eval_gapOrder017 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder017 k) =
      rawGap 17 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_017_identity k)]
  exact eval_gapJoin (evaluator z) 17 (realA z k) (realB z k) (realC z k)
    (squareOrder017 k) (gramOrder017 k) (eval_squareOrder017 z k) (eval_gramOrder017 z k)

theorem chamber_order_017_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 17 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder017]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_017_coefficients k)

theorem cycle_order_017_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 17) a b c
    dimensionConstant 17 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 17 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 17 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 17 chamber_order_017_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
