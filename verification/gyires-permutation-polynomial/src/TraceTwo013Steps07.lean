noncomputable def traceTwo013Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo013Real31 z k)+(traceTwo013Real13 z k)

theorem traceTwo013Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo013Step31 k) (traceTwo013Step13 k)) (traceTwo013Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo013Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo013Step32 k) = traceTwo013Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo013Step32_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceTwo013Step31, eval_traceTwo013Step13, traceTwo013Real32]


