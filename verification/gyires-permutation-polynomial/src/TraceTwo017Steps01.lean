noncomputable def traceTwo017Real08 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo017Real07 z k)

theorem traceTwo017Step08_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo017Step07 k)) (traceTwo017Step08 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo017Step08 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo017Step08 k) = traceTwo017Real08 z k := by
  rw [eval_of_same _ _ _ (traceTwo017Step08_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo017Step07, traceTwo017Real08]


