theorem v_order_014_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarVB k) (scalarVD k)
      (vOrder012 k) (vOrder013 k)) (vOrder014 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_vOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (vOrder014 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k))
        (SparsePolynomial.eval (evaluator z) (scalarVD k)) 14 := by
  rw [eval_of_same _ _ _ (v_order_014_identity k)]
  exact eval_scalarStep (evaluator z) (scalarVB k) (scalarVD k)
    (vOrder012 k) (vOrder013 k) 12
    (eval_vOrder012 z k) (eval_vOrder013 z k)

