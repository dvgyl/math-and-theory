noncomputable def traceTwo012Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo012Real11 z k)

theorem traceTwo012Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo012Step11 k)) (traceTwo012Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step12 k) = traceTwo012Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo012Step11, traceTwo012Real12]


