noncomputable def traceTwo012Real11 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo012Real10 z k)

theorem traceTwo012Step11_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo012Step10 k)) (traceTwo012Step11 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step11 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step11 k) = traceTwo012Real11 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step11_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo012Step10, traceTwo012Real11]

