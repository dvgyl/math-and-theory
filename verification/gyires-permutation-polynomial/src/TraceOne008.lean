def t1Order008Input (k : Fin 3) : Fin 4 → Polynomial :=
  ![t1Four k, t1Five k, t1Six k, t1Order007 k]

theorem t1_order_008_identity (k : Fin 3) :
    SparsePolynomial.same (oneStep (gramD k) (gramE k) (gramF k) (t1Order008Input k))
      (t1Order008 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_t1Order008 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t1Order008 k) =
      Matrix.trace (PermutationTransfer.transferOne
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^8) := by
  rw [eval_of_same _ _ _ (t1_order_008_identity k)]
  have h := eval_oneStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (t1Order008Input k) 4 ?_
  · simpa using h
  · intro i
    fin_cases i
    · simpa [t1Order008Input] using eval_t1Four z k
    · simpa [t1Order008Input] using eval_t1Five z k
    · simpa [t1Order008Input] using eval_t1Six z k
    · simpa [t1Order008Input] using eval_t1Order007 z k

