noncomputable def traceTwo012Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo012Real31 z k)+(traceTwo012Real13 z k)

theorem traceTwo012Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo012Step31 k) (traceTwo012Step13 k)) (traceTwo012Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step32 k) = traceTwo012Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step32_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceTwo012Step31, eval_traceTwo012Step13, traceTwo012Real32]


