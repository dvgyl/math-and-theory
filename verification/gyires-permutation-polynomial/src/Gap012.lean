theorem gap_order_012_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 12 (squareOrder012 k) (gramOrder012 k)) (gapOrder012 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_012_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder012 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder012 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder012 k) =
      permanentSquareExpr 12 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder012 z k
  · exact eval_cpOrder012 z k
  · simpa using eval_uOrder012 z k
  · simpa using eval_vOrder012 z k
  · simpa using eval_wOrder012 z k
  · exact eval_fpOrder012 z k
  · exact eval_signed_power (evaluator z) (fpOrder012 k) 12
      (realA z k*realC z k) (eval_fpOrder012 z k)

theorem eval_gramOrder012 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder012 k) =
      gramExpr 12 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 12 (realA z k) (realB z k) (realC z k)
    (fpOrder012 k) (t1Order012 k) (t2Order012 k)
    (eval_fpOrder012 z k) (eval_t1Order012 z k) (eval_t2Order012 z k)

theorem eval_gapOrder012 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder012 k) =
      rawGap 12 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_012_identity k)]
  exact eval_gapJoin (evaluator z) 12 (realA z k) (realB z k) (realC z k)
    (squareOrder012 k) (gramOrder012 k) (eval_squareOrder012 z k) (eval_gramOrder012 z k)

theorem chamber_order_012_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 12 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder012]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_012_coefficients k)

theorem cycle_order_012_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 12) a b c
    dimensionConstant 12 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 12 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 12 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 12 chamber_order_012_nonneg ha hb hc

