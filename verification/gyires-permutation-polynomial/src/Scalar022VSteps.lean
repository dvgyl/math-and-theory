noncomputable def scalarV022Real02 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (realA z k*realC z k) * (powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k)) (SparsePolynomial.eval (evaluator z) (scalarVD k)) 20)

theorem scalarV022Step02_identity (k : Fin 3) :
