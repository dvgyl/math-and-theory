noncomputable def scalarV022Step01 : Fin 3 → Polynomial :=
  ![PackedData.decodeBlocks 91 32 [(32, ), (32, ), (32, ), (32, ), (15, )],
    PackedData.decodeBlocks 128 52 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (2, 110927545958980999575352703539536707734902504768072615938296332014534264882496)],
    PackedData.decodeBlocks 111 37 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (20, )]]

noncomputable def scalarV022Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (SparsePolynomial.eval (evaluator z) (scalarVB k)) * (powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k)) (SparsePolynomial.eval (evaluator z) (scalarVD k)) 21)

theorem scalarV022Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (scalarVB k) (vOrder021 k)) (scalarV022Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_scalarV022Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (scalarV022Step01 k) = scalarV022Real01 z k := by
  rw [eval_of_same _ _ _ (scalarV022Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_vOrder021, scalarV022Real01]

