  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^15))

theorem traceTwo020Step18_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order015 k)) (traceTwo020Step18 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step18 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step18 k) = traceTwo020Real18 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step18_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order015, traceTwo020Real18]

