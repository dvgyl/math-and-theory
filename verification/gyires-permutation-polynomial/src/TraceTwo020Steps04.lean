noncomputable def traceTwo020Real20 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo020Real19 z k)

theorem traceTwo020Step20_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo020Step19 k)) (traceTwo020Step20 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step20 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step20 k) = traceTwo020Real20 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step20_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo020Step19, traceTwo020Real20]


