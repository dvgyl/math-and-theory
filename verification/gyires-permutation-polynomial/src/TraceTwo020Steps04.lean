  ((realA z k*realC z k))*(traceTwo020Real16 z k)

theorem traceTwo020Step17_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo020Step16 k)) (traceTwo020Step17 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step17 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step17 k) = traceTwo020Real17 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step17_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo020Step16, traceTwo020Real17]

