theorem v_order_013_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarVB k) (scalarVD k)
      (vOrder011 k) (vOrder012 k)) (vOrder013 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_vOrder013 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (vOrder013 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k))
        (SparsePolynomial.eval (evaluator z) (scalarVD k)) 13 := by
  rw [eval_of_same _ _ _ (v_order_013_identity k)]
  exact eval_scalarStep (evaluator z) (scalarVB k) (scalarVD k)
    (vOrder011 k) (vOrder012 k) 11
    (eval_vOrder011 z k) (eval_vOrder012 z k)

