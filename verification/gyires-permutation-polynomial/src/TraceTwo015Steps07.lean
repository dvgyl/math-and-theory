    SparsePolynomial.same (SparsePolynomial.add (traceTwo015Step01 k) (traceTwo015Step03 k)) (traceTwo015Step29 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step29 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step29 k) = traceTwo015Real29 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step29_identity k)]
