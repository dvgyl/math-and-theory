noncomputable def traceTwo015Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo015Real31 z k)+(traceTwo015Real13 z k)

theorem traceTwo015Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo015Step31 k) (traceTwo015Step13 k)) (traceTwo015Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step32 k) = traceTwo015Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step32_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceTwo015Step31, eval_traceTwo015Step13, traceTwo015Real32]


