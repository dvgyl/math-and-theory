theorem fp_order_019_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpOrder018 k)) (fpOrder019 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_fpOrder019 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpOrder019 k) = (realA z k*realC z k)^19 := by
  rw [eval_of_same _ _ _ (fp_order_019_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpOrder018]
  rw [← pow_succ']


