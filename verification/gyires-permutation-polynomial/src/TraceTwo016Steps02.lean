noncomputable def traceTwo016Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo016Real11 z k)

theorem traceTwo016Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo016Step11 k)) (traceTwo016Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo016Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo016Step12 k) = traceTwo016Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo016Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo016Step11, traceTwo016Real12]


