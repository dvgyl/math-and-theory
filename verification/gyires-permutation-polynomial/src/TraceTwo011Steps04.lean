noncomputable def traceTwo011Real17 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo011Real16 z k)

theorem traceTwo011Step17_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo011Step16 k)) (traceTwo011Step17 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo011Step17 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo011Step17 k) = traceTwo011Real17 z k := by
  rw [eval_of_same _ _ _ (traceTwo011Step17_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo011Step16, traceTwo011Real17]

