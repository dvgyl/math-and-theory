theorem traceTwo010Step25_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo010Step24 k)) (traceTwo010Step25 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo010Step25 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo010Step25 k) = traceTwo010Real25 z k := by
  rw [eval_of_same _ _ _ (traceTwo010Step25_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo010Step24, traceTwo010Real25]

