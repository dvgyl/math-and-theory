theorem w_order_013_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k)
      (wOrder011 k) (wOrder012 k)) (wOrder013 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_wOrder013 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (wOrder013 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) 13 := by
  rw [eval_of_same _ _ _ (w_order_013_identity k)]
  exact eval_scalarStep (evaluator z) (scalarWB k) (scalarWD k)
    (wOrder011 k) (wOrder012 k) 11
    (eval_wOrder011 z k) (eval_wOrder012 z k)

