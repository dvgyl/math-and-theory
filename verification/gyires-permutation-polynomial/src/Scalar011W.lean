theorem w_order_011_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k)
      (wOrder009 k) (wOrder010 k)) (wOrder011 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_wOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (wOrder011 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) 11 := by
  rw [eval_of_same _ _ _ (w_order_011_identity k)]
  exact eval_scalarStep (evaluator z) (scalarWB k) (scalarWD k)
    (wOrder009 k) (wOrder010 k) 9
    (eval_wOrder009 z k) (eval_wOrder010 z k)

