theorem w_order_014_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k)
      (wOrder012 k) (wOrder013 k)) (wOrder014 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_wOrder014 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (wOrder014 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) 14 := by
  rw [eval_of_same _ _ _ (w_order_014_identity k)]
  exact eval_scalarStep (evaluator z) (scalarWB k) (scalarWD k)
    (wOrder012 k) (wOrder013 k) 12
    (eval_wOrder012 z k) (eval_wOrder013 z k)

