theorem gap_order_020_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 20 (squareOrder020 k) (gramOrder020 k)) (gapOrder020 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_020_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder020 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder020 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder020 k) =
      permanentSquareExpr 20 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder020 z k
  · exact eval_cpOrder020 z k
  · simpa using eval_uOrder020 z k
  · simpa using eval_vOrder020 z k
  · simpa using eval_wOrder020 z k
  · exact eval_fpOrder020 z k
  · exact eval_signed_power (evaluator z) (fpOrder020 k) 20
      (realA z k*realC z k) (eval_fpOrder020 z k)

theorem eval_gramOrder020 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder020 k) =
      gramExpr 20 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 20 (realA z k) (realB z k) (realC z k)
    (fpOrder020 k) (t1Order020 k) (t2Order020 k)
    (eval_fpOrder020 z k) (eval_t1Order020 z k) (eval_t2Order020 z k)

theorem eval_gapOrder020 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder020 k) =
      rawGap 20 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_020_identity k)]
  exact eval_gapJoin (evaluator z) 20 (realA z k) (realB z k) (realC z k)
    (squareOrder020 k) (gramOrder020 k) (eval_squareOrder020 z k) (eval_gramOrder020 z k)

theorem chamber_order_020_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 20 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder020]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_020_coefficients k)

theorem cycle_order_020_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 20) a b c
    dimensionConstant 20 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 20 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 20 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 20 chamber_order_020_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
