def t2Order007Input (k : Fin 3) : Fin 6 → Polynomial :=
  ![twoInitial (gramD k) (gramE k) (gramF k) 1, twoInitial (gramD k) (gramE k) (gramF k) 2, twoInitial (gramD k) (gramE k) (gramF k) 3, t2Four k, t2Five k, t2Six k]

theorem t2_order_007_identity (k : Fin 3) :
    SparsePolynomial.same (twoStep (gramD k) (gramE k) (gramF k) (t2Order007Input k))
      (t2Order007 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_t2Order007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t2Order007 k) =
      Matrix.trace (PermutationTransfer.transferTwo
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^7) := by
  rw [eval_of_same _ _ _ (t2_order_007_identity k)]
  have h := eval_twoStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (t2Order007Input k) 1 ?_
  · simpa using h
  · intro i
    fin_cases i
    · simpa [t2Order007Input] using eval_twoInitial (evaluator z) (gramD k) (gramE k) (gramF k) (1 : Fin 6)
    · simpa [t2Order007Input] using eval_twoInitial (evaluator z) (gramD k) (gramE k) (gramF k) (2 : Fin 6)
    · simpa [t2Order007Input] using eval_twoInitial (evaluator z) (gramD k) (gramE k) (gramF k) (3 : Fin 6)
    · simpa [t2Order007Input] using eval_t2Four z k
    · simpa [t2Order007Input] using eval_t2Five z k
    · simpa [t2Order007Input] using eval_t2Six z k

