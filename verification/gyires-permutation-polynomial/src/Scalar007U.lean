theorem u_order_007_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k)
      (uSix k 5) (uSix k 6)) (uOrder007 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder007 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (uOrder007 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 7 := by
  rw [eval_of_same _ _ _ (u_order_007_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uSix k 5) (uSix k 6) 5
    (eval_uSix z k 5 (by omega)) (eval_uSix z k 6 (by omega))

