noncomputable def traceTwo011Real21 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo011Real20 z k)

theorem traceTwo011Step21_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo011Step20 k)) (traceTwo011Step21 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo011Step21 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo011Step21 k) = traceTwo011Real21 z k := by
  rw [eval_of_same _ _ _ (traceTwo011Step21_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo011Step20, traceTwo011Real21]

