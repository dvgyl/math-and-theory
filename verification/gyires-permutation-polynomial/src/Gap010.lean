theorem gap_order_010_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 10 (squareOrder010 k) (gramOrder010 k)) (gapOrder010 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_010_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder010 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder010 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder010 k) =
      permanentSquareExpr 10 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder010 z k
  · exact eval_cpOrder010 z k
  · simpa using eval_uOrder010 z k
  · simpa using eval_vOrder010 z k
  · simpa using eval_wOrder010 z k
  · exact eval_fpOrder010 z k
  · exact eval_signed_power (evaluator z) (fpOrder010 k) 10
      (realA z k*realC z k) (eval_fpOrder010 z k)

theorem eval_gramOrder010 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder010 k) =
      gramExpr 10 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 10 (realA z k) (realB z k) (realC z k)
    (fpOrder010 k) (t1Order010 k) (t2Order010 k)
    (eval_fpOrder010 z k) (eval_t1Order010 z k) (eval_t2Order010 z k)

theorem eval_gapOrder010 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder010 k) =
      rawGap 10 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_010_identity k)]
  exact eval_gapJoin (evaluator z) 10 (realA z k) (realB z k) (realC z k)
    (squareOrder010 k) (gramOrder010 k) (eval_squareOrder010 z k) (eval_gramOrder010 z k)

theorem chamber_order_010_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 10 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder010]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_010_coefficients k)

theorem cycle_order_010_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 10) a b c
    dimensionConstant 10 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 10 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 10 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 10 chamber_order_010_nonneg ha hb hc

