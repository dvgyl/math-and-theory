theorem u_order_011_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k)
      (uOrder009 k) (uOrder010 k)) (uOrder011 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (uOrder011 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 11 := by
  rw [eval_of_same _ _ _ (u_order_011_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uOrder009 k) (uOrder010 k) 9
    (eval_uOrder009 z k) (eval_uOrder010 z k)

