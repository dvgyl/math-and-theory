noncomputable def traceTwo019Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo019Real11 z k)

theorem traceTwo019Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo019Step11 k)) (traceTwo019Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo019Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo019Step12 k) = traceTwo019Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo019Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo019Step11, traceTwo019Real12]


