noncomputable def traceTwo012Real04 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^10))

theorem traceTwo012Step04_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order010 k)) (traceTwo012Step04 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step04 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step04 k) = traceTwo012Real04 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step04_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order010, traceTwo012Real04]


