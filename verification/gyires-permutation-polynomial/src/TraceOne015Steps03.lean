noncomputable def traceOne015Real13 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceOne015Real12 z k)+(traceOne015Real10 z k)

theorem traceOne015Step13_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceOne015Step12 k) (traceOne015Step10 k)) (traceOne015Step13 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne015Step13 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne015Step13 k) = traceOne015Real13 z k := by
  rw [eval_of_same _ _ _ (traceOne015Step13_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceOne015Step12, eval_traceOne015Step10, traceOne015Real13]


