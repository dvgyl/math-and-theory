  ((realB z k*(realA z k+realC z k)))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^9))

theorem traceTwo011Step02_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (t2Order009 k)) (traceTwo011Step02 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo011Step02 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo011Step02 k) = traceTwo011Real02 z k := by
  rw [eval_of_same _ _ _ (traceTwo011Step02_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_t2Order009, traceTwo011Real02]

