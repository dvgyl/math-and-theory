theorem w_six_zero (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.const 2) (wSix k 0) = true := by
  fin_cases k <;> decide +kernel

theorem w_six_one (k : Fin 3) :
    SparsePolynomial.same (scalarWB k) (wSix k 1) = true := by
  fin_cases k <;> decide +kernel

theorem w_six_steps (k : Fin 3) (n : ℕ) (hn : n+2 ≤ 6) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k) (wSix k n) (wSix k (n+1)))
      (wSix k (n+2)) = true := by
  have hn4 : n ≤ 4 := by omega
  interval_cases n <;> fin_cases k <;> decide +kernel

theorem eval_wSix (z : Fin 3 → ℝ) (k : Fin 3) (n : ℕ) (hn : n ≤ 6) :
    SparsePolynomial.eval (evaluator z) (wSix k n) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) n :=
  eval_scalar_prefix (evaluator z) (scalarWB k) (scalarWD k) (wSix k) 6
    (w_six_zero k) (w_six_one k) (w_six_steps k) n hn

