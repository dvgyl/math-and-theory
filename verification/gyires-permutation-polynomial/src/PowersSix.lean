theorem ap_six_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareA k) (apFive k)) (apSix k) = true := by
  fin_cases k <;> decide +kernel

theorem cp_six_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (squareC k) (cpFive k)) (cpSix k) = true := by
  fin_cases k <;> decide +kernel

theorem fp_six_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpFive k)) (fpSix k) = true := by
  fin_cases k <;> decide +kernel

def t1SixInput (k : Fin 3) : Fin 4 → Polynomial := ![oneInitial (gramD k) (gramE k) (gramF k) 2, oneInitial (gramD k) (gramE k) (gramF k) 3, t1Four k, t1Five k]

theorem t1_six_identity (k : Fin 3) :
    SparsePolynomial.same (oneStep (gramD k) (gramE k) (gramF k) (t1SixInput k)) (t1Six k) = true := by
  fin_cases k <;> decide +kernel

theorem t2_six_identity (k : Fin 3) :
    SparsePolynomial.same (twoStep (gramD k) (gramE k) (gramF k) (twoInitial (gramD k) (gramE k) (gramF k))) (t2Six k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_apSix (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (apSix k) = (realA z k)^12 := by
  rw [eval_of_same _ _ _ (ap_six_identity k), SparsePolynomial.eval_mul,
    eval_squareA, eval_apFive]
  rw [← pow_add]

theorem eval_cpSix (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (cpSix k) = (realC z k)^12 := by
  rw [eval_of_same _ _ _ (cp_six_identity k), SparsePolynomial.eval_mul,
    eval_squareC, eval_cpFive]
  rw [← pow_add]

theorem eval_fpSix (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpSix k) = (realA z k*realC z k)^6 := by
  rw [eval_of_same _ _ _ (fp_six_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpFive]
  rw [← pow_succ']

theorem eval_t1Six (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t1Six k) =
      Matrix.trace (PermutationTransfer.transferOne
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^6) := by
  rw [eval_of_same _ _ _ (t1_six_identity k)]
  have h := eval_oneStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (t1SixInput k) 2 ?_
  · simpa using h
  · intro i
    fin_cases i
    · simpa [t1SixInput] using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) (2 : Fin 4)
    · simpa [t1SixInput] using eval_oneInitial (evaluator z) (gramD k) (gramE k) (gramF k) (3 : Fin 4)
    · simpa [t1SixInput] using eval_t1Four z k
    · simpa [t1SixInput] using eval_t1Five z k

theorem eval_t2Six (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (t2Six k) =
      Matrix.trace (PermutationTransfer.transferTwo
        ((realA z k)^2+(realB z k)^2+(realC z k)^2)
        (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^6) := by
  rw [eval_of_same _ _ _ (t2_six_identity k)]
  have h := eval_twoStep (evaluator z) (gramD k) (gramE k) (gramF k)
    (twoInitial (gramD k) (gramE k) (gramF k)) 0
    (fun i => by simpa using eval_twoInitial (evaluator z) (gramD k) (gramE k) (gramF k) i)
  simpa using h

