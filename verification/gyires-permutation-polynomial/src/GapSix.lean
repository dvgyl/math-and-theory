def squareSix (k : Fin 3) : Polynomial :=
  squareJoin (apSix k) (cpSix k) (uSix k 6) (vSix k 6) (wSix k 6) (fpSix k)
    (SparsePolynomial.mul (SparsePolynomial.const ((-1 : ℤ)^6)) (fpSix k))

def gramSix (k : Fin 3) : Polynomial := gramJoin (fpSix k) (t1Six k) (t2Six k)

