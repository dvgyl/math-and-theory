theorem gap_six_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 6 (squareSix k) (gramSix k)) (gapSix k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_six_coefficients (k : Fin 3) : SparsePolynomial.coeffsNonneg (gapSix k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareSix (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareSix k) =
      permanentSquareExpr 6 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apSix z k
  · exact eval_cpSix z k
  · simpa using eval_uSix z k 6 (by omega)
  · simpa using eval_vSix z k 6 (by omega)
  · simpa using eval_wSix z k 6 (by omega)
  · exact eval_fpSix z k
  · exact eval_signed_power (evaluator z) (fpSix k) 6 (realA z k*realC z k) (eval_fpSix z k)

theorem eval_gramSix (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramSix k) =
      gramExpr 6 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 6 (realA z k) (realB z k) (realC z k)
    (fpSix k) (t1Six k) (t2Six k) (eval_fpSix z k) (eval_t1Six z k) (eval_t2Six z k)

theorem eval_gapSix (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapSix k) =
      rawGap 6 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_six_identity k)]
  exact eval_gapJoin (evaluator z) 6 (realA z k) (realB z k) (realC z k)
    (squareSix k) (gramSix k) (eval_squareSix z k) (eval_gramSix z k)

theorem chamber_six_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 6 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapSix]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _ (gap_six_coefficients k)

theorem cycle_order_six_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 6) a b c
    dimensionConstant 6 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 6 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 6 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 6 chamber_six_nonneg ha hb hc

