noncomputable def traceTwo015Real08 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo015Real07 z k)

theorem traceTwo015Step08_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo015Step07 k)) (traceTwo015Step08 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step08 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step08 k) = traceTwo015Real08 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step08_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo015Step07, traceTwo015Real08]


