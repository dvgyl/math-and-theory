noncomputable def traceTwo012Real25 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo012Real24 z k)

theorem traceTwo012Step25_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo012Step24 k)) (traceTwo012Step25 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step25 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step25 k) = traceTwo012Real25 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step25_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo012Step24, traceTwo012Real25]

