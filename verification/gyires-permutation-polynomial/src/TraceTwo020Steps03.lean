noncomputable def traceTwo020Real16 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo020Real15 z k)

theorem traceTwo020Step16_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo020Step15 k)) (traceTwo020Step16 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step16 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step16 k) = traceTwo020Real16 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step16_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo020Step15, traceTwo020Real16]


