    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo015Step12 k)) (traceTwo015Step13 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step13 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step13 k) = traceTwo015Real13 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step13_identity k)]
