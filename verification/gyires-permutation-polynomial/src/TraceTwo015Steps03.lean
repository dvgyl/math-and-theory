  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^11))

theorem traceTwo015Step14_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order011 k)) (traceTwo015Step14 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step14 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step14 k) = traceTwo015Real14 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step14_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order011, traceTwo015Real14]

