noncomputable def traceTwo019Real16 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo019Real15 z k)

theorem traceTwo019Step16_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo019Step15 k)) (traceTwo019Step16 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo019Step16 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo019Step16 k) = traceTwo019Real16 z k := by
  rw [eval_of_same _ _ _ (traceTwo019Step16_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo019Step15, traceTwo019Real16]


