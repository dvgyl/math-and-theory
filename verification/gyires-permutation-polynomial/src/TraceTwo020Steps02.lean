noncomputable def traceTwo020Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo020Real11 z k)

theorem traceTwo020Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo020Step11 k)) (traceTwo020Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step12 k) = traceTwo020Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo020Step11, traceTwo020Real12]


