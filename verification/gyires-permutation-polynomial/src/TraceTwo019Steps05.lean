  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(traceTwo019Real21 z k)

theorem traceTwo019Step22_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (traceTwo019Step21 k)) (traceTwo019Step22 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo019Step22 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo019Step22 k) = traceTwo019Real22 z k := by
  rw [eval_of_same _ _ _ (traceTwo019Step22_identity k)]
