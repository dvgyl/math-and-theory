theorem left_inverse : ∀ r i, inverse r (representative r i) = i := by decide +kernel
theorem right_inverse : ∀ r i, representative r (inverse r i) = i := by decide +kernel
def permutation (r : Fin 60) : Equiv.Perm (Fin 6) where
  toFun := representative r
  invFun := inverse r
  left_inv := left_inverse r
  right_inv := right_inverse r
