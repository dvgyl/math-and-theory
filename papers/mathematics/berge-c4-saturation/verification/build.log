info: BergeC4/AxiomAudit.lean:75:0: @BergeC4.glued_saturated : ∀ {n₀ t : ℕ} [inst : NeZero n₀] {B : Finset (Finset (Fin n₀))} {K : Finset (Finset (Fin 5))},
  BergeC4.IsThreeUniform B →
    ¬BergeC4.ContainsBergeC4 B →
      BergeC4.PathSaturated B →
        (∀ (a : Fin n₀), a ≠ 0 → BergeC4.Reach1 B 0 a ∨ BergeC4.Reach2 B 0 a) →
          BergeC4.IsThreeUniform K →
            K.card = 3 →
              BergeC4.PathSaturated K →
                (∀ (a : Fin 5), a ≠ 0 → BergeC4.Reach1 K 0 a ∧ BergeC4.Reach2 K 0 a) →
                  BergeC4.IsBergeC4Saturated (BergeC4.glued n₀ t B K) ∧ (BergeC4.glued n₀ t B K).card = B.card + 3 * t
