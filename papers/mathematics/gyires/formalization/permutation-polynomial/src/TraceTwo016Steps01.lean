theorem eval_traceTwo016Step05 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo016Step05 k) = traceTwo016Real05 z k := by
  rw [eval_of_same _ _ _ (traceTwo016Step05_identity k)]
