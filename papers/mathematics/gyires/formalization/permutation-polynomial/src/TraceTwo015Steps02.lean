noncomputable def traceTwo015Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo015Real11 z k)

theorem traceTwo015Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo015Step11 k)) (traceTwo015Step12 k) = true := by
  fin_cases k <;> decide +kernel

