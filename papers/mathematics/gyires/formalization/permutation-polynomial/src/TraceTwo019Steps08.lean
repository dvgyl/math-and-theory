noncomputable def traceTwo019Real35 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo019Real34 z k)-(traceTwo019Real28 z k)

theorem traceTwo019Step35_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.sub (traceTwo019Step34 k) (traceTwo019Step28 k)) (traceTwo019Step35 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo019Step35 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo019Step35 k) = traceTwo019Real35 z k := by
  rw [eval_of_same _ _ _ (traceTwo019Step35_identity k)]
  simp only [SparsePolynomial.eval_sub, eval_traceTwo019Step34, eval_traceTwo019Step28, traceTwo019Real35]


