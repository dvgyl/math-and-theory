noncomputable def traceOne012Real02 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^10))

theorem traceOne012Step02_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t1Order010 k)) (traceOne012Step02 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne012Step02 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne012Step02 k) = traceOne012Real02 z k := by
  rw [eval_of_same _ _ _ (traceOne012Step02_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t1Order010, traceOne012Real02]

