noncomputable def traceOne012Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^11))

theorem traceOne012Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (t1Order011 k)) (traceOne012Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne012Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne012Step01 k) = traceOne012Real01 z k := by
  rw [eval_of_same _ _ _ (traceOne012Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_t1Order011, traceOne012Real01]

