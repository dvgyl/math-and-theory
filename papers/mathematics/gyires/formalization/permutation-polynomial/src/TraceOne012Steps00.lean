noncomputable def traceOne012Real04 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferOne ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^9))

theorem traceOne012Step04_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t1Order009 k)) (traceOne012Step04 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne012Step04 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne012Step04 k) = traceOne012Real04 z k := by
  rw [eval_of_same _ _ _ (traceOne012Step04_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t1Order009, traceOne012Real04]


