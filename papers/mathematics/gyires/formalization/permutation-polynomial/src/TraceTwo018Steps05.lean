  ((realA z k*realC z k))*(traceTwo018Real20 z k)

theorem traceTwo018Step21_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo018Step20 k)) (traceTwo018Step21 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo018Step21 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step21 k) = traceTwo018Real21 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step21_identity k)]
