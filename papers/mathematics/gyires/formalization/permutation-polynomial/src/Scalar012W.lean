theorem w_order_012_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k)
      (wOrder010 k) (wOrder011 k)) (wOrder012 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_wOrder012 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (wOrder012 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) 12 := by
  rw [eval_of_same _ _ _ (w_order_012_identity k)]
  exact eval_scalarStep (evaluator z) (scalarWB k) (scalarWD k)
    (wOrder010 k) (wOrder011 k) 10
    (eval_wOrder010 z k) (eval_wOrder011 z k)

