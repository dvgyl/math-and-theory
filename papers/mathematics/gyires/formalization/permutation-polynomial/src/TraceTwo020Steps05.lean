noncomputable def traceTwo020Real24 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo020Real23 z k)

theorem traceTwo020Step24_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo020Step23 k)) (traceTwo020Step24 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step24 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step24 k) = traceTwo020Real24 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step24_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo020Step23, traceTwo020Real24]


