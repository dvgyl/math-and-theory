noncomputable def traceTwo020Real22 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(traceTwo020Real21 z k)

theorem traceTwo020Step22_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (traceTwo020Step21 k)) (traceTwo020Step22 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step22 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step22 k) = traceTwo020Real22 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step22_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramD, eval_traceTwo020Step21, traceTwo020Real22]

