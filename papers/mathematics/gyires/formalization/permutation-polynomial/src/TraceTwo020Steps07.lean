  (traceTwo020Real31 z k)+(traceTwo020Real13 z k)

theorem traceTwo020Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo020Step31 k) (traceTwo020Step13 k)) (traceTwo020Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step32 k) = traceTwo020Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step32_identity k)]
