noncomputable def traceTwo020Real04 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^18))

theorem traceTwo020Step04_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (t2Order018 k)) (traceTwo020Step04 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step04 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step04 k) = traceTwo020Real04 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step04_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_t2Order018, traceTwo020Real04]


