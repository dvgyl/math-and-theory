module

public import PackedPolynomialData
public import Scalar021U
public import Scalar021V
public import Scalar021W
public import Powers021
public import TraceOne021
public import TraceTwo021

@[expose] public section

namespace MathAndTheory.Gyires.PermutationCoefficientStage

open MathAndTheory.Gyires.PermutationFinite
open MathAndTheory.Gyires.PermutationCoefficientRecurrence

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

noncomputable def squareOrder021 (k : Fin 3) : Polynomial :=
  squareJoin (apOrder021 k) (cpOrder021 k) (uOrder021 k) (vOrder021 k) (wOrder021 k) (fpOrder021 k)
    (SparsePolynomial.mul (SparsePolynomial.const ((-1 : ℤ)^21)) (fpOrder021 k))

noncomputable def gramOrder021 (k : Fin 3) : Polynomial :=
  gramJoin (fpOrder021 k) (t1Order021 k) (t2Order021 k)

noncomputable def gapOrder021 : Fin 3 → Polynomial :=
  ![PackedData.decodeBlocks 254 156 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (18, )],
    PackedData.decodeBlocks 254 156 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (18, )],
    PackedData.decodeBlocks 263 165 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (18, )]]

theorem gap_order_021_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 21 (squareOrder021 k) (gramOrder021 k)) (gapOrder021 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_021_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder021 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder021 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder021 k) =
      permanentSquareExpr 21 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder021 z k
  · exact eval_cpOrder021 z k
  · simpa using eval_uOrder021 z k
  · simpa using eval_vOrder021 z k
  · simpa using eval_wOrder021 z k
  · exact eval_fpOrder021 z k
  · exact eval_signed_power (evaluator z) (fpOrder021 k) 21
      (realA z k*realC z k) (eval_fpOrder021 z k)

theorem eval_gramOrder021 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder021 k) =
      gramExpr 21 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 21 (realA z k) (realB z k) (realC z k)
    (fpOrder021 k) (t1Order021 k) (t2Order021 k)
    (eval_fpOrder021 z k) (eval_t1Order021 z k) (eval_t2Order021 z k)

theorem eval_gapOrder021 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder021 k) =
      rawGap 21 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_021_identity k)]
  exact eval_gapJoin (evaluator z) 21 (realA z k) (realB z k) (realC z k)
    (squareOrder021 k) (gramOrder021 k) (eval_squareOrder021 z k) (eval_gramOrder021 z k)

theorem chamber_order_021_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 21 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder021]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_021_coefficients k)

theorem cycle_order_021_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 21) a b c
    dimensionConstant 21 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 21 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 21 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 21 chamber_order_021_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
