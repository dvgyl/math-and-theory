theorem u_order_009_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k)
      (uOrder007 k) (uOrder008 k)) (uOrder009 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder009 (z : Fin 3 → ℝ) (k : Fin 3) :
