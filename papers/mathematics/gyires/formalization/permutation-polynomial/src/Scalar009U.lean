      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 9 := by
  rw [eval_of_same _ _ _ (u_order_009_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uOrder007 k) (uOrder008 k) 7
    (eval_uOrder007 z k) (eval_uOrder008 z k)

