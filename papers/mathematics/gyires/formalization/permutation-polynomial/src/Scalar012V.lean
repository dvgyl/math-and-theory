theorem v_order_012_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarVB k) (scalarVD k)
      (vOrder010 k) (vOrder011 k)) (vOrder012 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_vOrder012 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (vOrder012 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k))
        (SparsePolynomial.eval (evaluator z) (scalarVD k)) 12 := by
  rw [eval_of_same _ _ _ (v_order_012_identity k)]
  exact eval_scalarStep (evaluator z) (scalarVB k) (scalarVD k)
    (vOrder010 k) (vOrder011 k) 10
    (eval_vOrder010 z k) (eval_vOrder011 z k)

