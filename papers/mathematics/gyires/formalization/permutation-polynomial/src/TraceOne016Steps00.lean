theorem eval_traceOne016Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne016Step01 k) = traceOne016Real01 z k := by
  rw [eval_of_same _ _ _ (traceOne016Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_t1Order015, traceOne016Real01]

