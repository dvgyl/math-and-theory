noncomputable def traceTwo013Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo013Real11 z k)

theorem traceTwo013Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo013Step11 k)) (traceTwo013Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo013Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo013Step12 k) = traceTwo013Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo013Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo013Step11, traceTwo013Real12]


