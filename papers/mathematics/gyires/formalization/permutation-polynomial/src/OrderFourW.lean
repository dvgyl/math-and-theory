theorem w_initial_zero (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.const 2) (wData k 0) = true := by
  fin_cases k <;> decide +kernel

theorem w_initial_one (k : Fin 3) :
    SparsePolynomial.same (scalarWB k) (wData k 1) = true := by
  fin_cases k <;> decide +kernel

theorem w_steps (k : Fin 3) (n : ℕ) (hn : n+2 ≤ 4) :
    SparsePolynomial.same (scalarStep (scalarWB k) (scalarWD k) (wData k n) (wData k (n+1)))
      (wData k (n+2)) = true := by
  have hn2 : n ≤ 2 := by omega
  interval_cases n <;> fin_cases k <;> decide +kernel

theorem eval_wData (z : Fin 3 → ℝ) (k : Fin 3) (n : ℕ) (hn : n ≤ 4) :
    SparsePolynomial.eval (evaluator z) (wData k n) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarWB k))
        (SparsePolynomial.eval (evaluator z) (scalarWD k)) n :=
  eval_scalar_prefix (evaluator z) (scalarWB k) (scalarWD k) (wData k) 4
    (w_initial_zero k) (w_initial_one k) (w_steps k) n hn

end MathAndTheory.Gyires.PermutationCoefficientStage
