theorem gap_order_013_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 13 (squareOrder013 k) (gramOrder013 k)) (gapOrder013 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_013_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder013 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder013 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder013 k) =
      permanentSquareExpr 13 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder013 z k
  · exact eval_cpOrder013 z k
  · simpa using eval_uOrder013 z k
  · simpa using eval_vOrder013 z k
  · simpa using eval_wOrder013 z k
  · exact eval_fpOrder013 z k
  · exact eval_signed_power (evaluator z) (fpOrder013 k) 13
      (realA z k*realC z k) (eval_fpOrder013 z k)

theorem eval_gramOrder013 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder013 k) =
      gramExpr 13 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 13 (realA z k) (realB z k) (realC z k)
    (fpOrder013 k) (t1Order013 k) (t2Order013 k)
    (eval_fpOrder013 z k) (eval_t1Order013 z k) (eval_t2Order013 z k)

theorem eval_gapOrder013 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder013 k) =
      rawGap 13 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_013_identity k)]
  exact eval_gapJoin (evaluator z) 13 (realA z k) (realB z k) (realC z k)
    (squareOrder013 k) (gramOrder013 k) (eval_squareOrder013 z k) (eval_gramOrder013 z k)

theorem chamber_order_013_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 13 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder013]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_013_coefficients k)

theorem cycle_order_013_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 13) a b c
    dimensionConstant 13 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 13 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 13 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 13 chamber_order_013_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
