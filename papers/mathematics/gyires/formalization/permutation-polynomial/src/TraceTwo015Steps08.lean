    SparsePolynomial.same (SparsePolynomial.add (traceTwo015Step32 k) (traceTwo015Step17 k)) (traceTwo015Step33 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step33 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step33 k) = traceTwo015Real33 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step33_identity k)]
