noncomputable def traceTwo015Real35 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo015Real34 z k)-(traceTwo015Real28 z k)

theorem traceTwo015Step35_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.sub (traceTwo015Step34 k) (traceTwo015Step28 k)) (traceTwo015Step35 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step35 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step35 k) = traceTwo015Real35 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step35_identity k)]
  simp only [SparsePolynomial.eval_sub, eval_traceTwo015Step34, eval_traceTwo015Step28, traceTwo015Real35]


