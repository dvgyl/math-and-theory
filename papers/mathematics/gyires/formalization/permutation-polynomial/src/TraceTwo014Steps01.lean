noncomputable def traceTwo014Real08 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo014Real07 z k)

theorem traceTwo014Step08_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo014Step07 k)) (traceTwo014Step08 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo014Step08 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo014Step08 k) = traceTwo014Real08 z k := by
  rw [eval_of_same _ _ _ (traceTwo014Step08_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo014Step07, traceTwo014Real08]


