      (uOrder010 k) (uOrder011 k)) (uOrder012 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder012 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (uOrder012 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 12 := by
  rw [eval_of_same _ _ _ (u_order_012_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uOrder010 k) (uOrder011 k) 10
    (eval_uOrder010 z k) (eval_uOrder011 z k)

end MathAndTheory.Gyires.PermutationCoefficientStage
