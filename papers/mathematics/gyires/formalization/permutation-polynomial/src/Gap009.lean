    SparsePolynomial.eval (evaluator z) (gapOrder009 k) =
      rawGap 9 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_009_identity k)]
  exact eval_gapJoin (evaluator z) 9 (realA z k) (realB z k) (realC z k)
    (squareOrder009 k) (gramOrder009 k) (eval_squareOrder009 z k) (eval_gramOrder009 z k)

theorem chamber_order_009_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 9 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder009]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_009_coefficients k)

theorem cycle_order_009_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 9) a b c
    dimensionConstant 9 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 9 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 9 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 9 chamber_order_009_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
