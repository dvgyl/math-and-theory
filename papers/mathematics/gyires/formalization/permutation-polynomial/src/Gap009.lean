theorem gap_order_009_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 9 (squareOrder009 k) (gramOrder009 k)) (gapOrder009 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_009_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder009 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder009 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder009 k) =
      permanentSquareExpr 9 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder009 z k
  · exact eval_cpOrder009 z k
  · simpa using eval_uOrder009 z k
  · simpa using eval_vOrder009 z k
  · simpa using eval_wOrder009 z k
  · exact eval_fpOrder009 z k
  · exact eval_signed_power (evaluator z) (fpOrder009 k) 9
      (realA z k*realC z k) (eval_fpOrder009 z k)

theorem eval_gramOrder009 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder009 k) =
      gramExpr 9 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 9 (realA z k) (realB z k) (realC z k)
    (fpOrder009 k) (t1Order009 k) (t2Order009 k)
    (eval_fpOrder009 z k) (eval_t1Order009 z k) (eval_t2Order009 z k)

