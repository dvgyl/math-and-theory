noncomputable def traceTwo017Real22 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(traceTwo017Real21 z k)

theorem traceTwo017Step22_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (traceTwo017Step21 k)) (traceTwo017Step22 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo017Step22 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo017Step22 k) = traceTwo017Real22 z k := by
  rw [eval_of_same _ _ _ (traceTwo017Step22_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramD, eval_traceTwo017Step21, traceTwo017Real22]

