theorem gap_order_011_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 11 (squareOrder011 k) (gramOrder011 k)) (gapOrder011 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_011_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder011 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder011 k) =
      permanentSquareExpr 11 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder011 z k
  · exact eval_cpOrder011 z k
  · simpa using eval_uOrder011 z k
  · simpa using eval_vOrder011 z k
  · simpa using eval_wOrder011 z k
  · exact eval_fpOrder011 z k
  · exact eval_signed_power (evaluator z) (fpOrder011 k) 11
      (realA z k*realC z k) (eval_fpOrder011 z k)

theorem eval_gramOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder011 k) =
      gramExpr 11 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 11 (realA z k) (realB z k) (realC z k)
    (fpOrder011 k) (t1Order011 k) (t2Order011 k)
    (eval_fpOrder011 z k) (eval_t1Order011 z k) (eval_t2Order011 z k)

theorem eval_gapOrder011 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder011 k) =
      rawGap 11 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_011_identity k)]
  exact eval_gapJoin (evaluator z) 11 (realA z k) (realB z k) (realC z k)
    (squareOrder011 k) (gramOrder011 k) (eval_squareOrder011 z k) (eval_gramOrder011 z k)

theorem chamber_order_011_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 11 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder011]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_011_coefficients k)

theorem cycle_order_011_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 11) a b c
    dimensionConstant 11 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 11 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 11 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 11 chamber_order_011_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
