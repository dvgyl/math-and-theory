theorem v_order_010_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarVB k) (scalarVD k)
      (vOrder008 k) (vOrder009 k)) (vOrder010 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_vOrder010 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (vOrder010 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k))
        (SparsePolynomial.eval (evaluator z) (scalarVD k)) 10 := by
  rw [eval_of_same _ _ _ (v_order_010_identity k)]
  exact eval_scalarStep (evaluator z) (scalarVB k) (scalarVD k)
    (vOrder008 k) (vOrder009 k) 8
    (eval_vOrder008 z k) (eval_vOrder009 z k)

