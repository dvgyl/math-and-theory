  (traceOne017Real11 z k)+(traceOne017Real06 z k)

theorem traceOne017Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceOne017Step11 k) (traceOne017Step06 k)) (traceOne017Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne017Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne017Step12 k) = traceOne017Real12 z k := by
  rw [eval_of_same _ _ _ (traceOne017Step12_identity k)]
