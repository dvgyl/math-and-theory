    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo015Step24 k)) (traceTwo015Step25 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step25 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step25 k) = traceTwo015Real25 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step25_identity k)]
