noncomputable def traceTwo012Real08 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo012Real07 z k)

theorem traceTwo012Step08_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo012Step07 k)) (traceTwo012Step08 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step08 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step08 k) = traceTwo012Real08 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step08_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo012Step07, traceTwo012Real08]


