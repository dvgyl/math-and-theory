theorem gap_order_016_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 16 (squareOrder016 k) (gramOrder016 k)) (gapOrder016 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_016_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder016 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder016 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder016 k) =
      permanentSquareExpr 16 (realA z k) (realB z k) (realC z k) := by
  apply eval_squareJoin
  · exact eval_apOrder016 z k
  · exact eval_cpOrder016 z k
  · simpa using eval_uOrder016 z k
  · simpa using eval_vOrder016 z k
  · simpa using eval_wOrder016 z k
  · exact eval_fpOrder016 z k
  · exact eval_signed_power (evaluator z) (fpOrder016 k) 16
      (realA z k*realC z k) (eval_fpOrder016 z k)

theorem eval_gramOrder016 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder016 k) =
      gramExpr 16 (realA z k) (realB z k) (realC z k) :=
  eval_gramJoin (evaluator z) 16 (realA z k) (realB z k) (realC z k)
    (fpOrder016 k) (t1Order016 k) (t2Order016 k)
    (eval_fpOrder016 z k) (eval_t1Order016 z k) (eval_t2Order016 z k)

theorem eval_gapOrder016 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder016 k) =
      rawGap 16 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_016_identity k)]
  exact eval_gapJoin (evaluator z) 16 (realA z k) (realB z k) (realC z k)
    (squareOrder016 k) (gramOrder016 k) (eval_squareOrder016 z k) (eval_gramOrder016 z k)

theorem chamber_order_016_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 16 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder016]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_016_coefficients k)

theorem cycle_order_016_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 16) a b c
    dimensionConstant 16 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 16 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 16 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 16 chamber_order_016_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
