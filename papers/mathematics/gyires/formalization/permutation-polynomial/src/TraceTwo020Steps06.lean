  ((realA z k*realC z k))*(traceTwo020Real25 z k)

theorem traceTwo020Step26_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo020Step25 k)) (traceTwo020Step26 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo020Step26 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo020Step26 k) = traceTwo020Real26 z k := by
  rw [eval_of_same _ _ _ (traceTwo020Step26_identity k)]
