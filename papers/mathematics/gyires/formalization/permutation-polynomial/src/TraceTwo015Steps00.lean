noncomputable def traceTwo015Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (((realA z k)^2+(realB z k)^2+(realC z k)^2))*(Matrix.trace (PermutationTransfer.transferTwo ((realA z k)^2+(realB z k)^2+(realC z k)^2) (realB z k*(realA z k+realC z k)) (realA z k*realC z k)^14))

theorem traceTwo015Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramD k) (t2Order014 k)) (traceTwo015Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo015Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo015Step01 k) = traceTwo015Real01 z k := by
  rw [eval_of_same _ _ _ (traceTwo015Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramD, eval_t2Order014, traceTwo015Real01]

