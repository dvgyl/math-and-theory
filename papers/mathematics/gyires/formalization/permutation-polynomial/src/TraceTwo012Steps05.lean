noncomputable def traceTwo012Real21 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realA z k*realC z k))*(traceTwo012Real20 z k)

theorem traceTwo012Step21_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (traceTwo012Step20 k)) (traceTwo012Step21 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo012Step21 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo012Step21 k) = traceTwo012Real21 z k := by
  rw [eval_of_same _ _ _ (traceTwo012Step21_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramF, eval_traceTwo012Step20, traceTwo012Real21]

