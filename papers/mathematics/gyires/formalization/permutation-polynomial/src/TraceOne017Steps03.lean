  (traceOne017Real12 z k)+(traceOne017Real10 z k)

theorem traceOne017Step13_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceOne017Step12 k) (traceOne017Step10 k)) (traceOne017Step13 k) = true := by
  fin_cases k <;> decide +kernel

