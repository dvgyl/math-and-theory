    PackedData.decodeBlocks 105 35 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (29, )]]

noncomputable def scalarV021Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (SparsePolynomial.eval (evaluator z) (scalarVB k)) * (powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k)) (SparsePolynomial.eval (evaluator z) (scalarVD k)) 20)

theorem scalarV021Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (scalarVB k) (vOrder020 k)) (scalarV021Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_scalarV021Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (scalarV021Step01 k) = scalarV021Real01 z k := by
  rw [eval_of_same _ _ _ (scalarV021Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_vOrder020, scalarV021Real01]

