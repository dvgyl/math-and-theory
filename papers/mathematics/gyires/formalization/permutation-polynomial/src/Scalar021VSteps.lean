noncomputable def scalarV021Step01 : Fin 3 → Polynomial :=
  ![PackedData.decodeBlocks 86 30 [(32, ), (32, ), (32, ), (32, ), (4, 31288872596497706285083327990600756357343318531850446119341054807723080603575793748747378114517612369056)],
