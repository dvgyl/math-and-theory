noncomputable def traceTwo014Real32 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo014Real31 z k)+(traceTwo014Real13 z k)

theorem traceTwo014Step32_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceTwo014Step31 k) (traceTwo014Step13 k)) (traceTwo014Step32 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo014Step32 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo014Step32 k) = traceTwo014Real32 z k := by
  rw [eval_of_same _ _ _ (traceTwo014Step32_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceTwo014Step31, eval_traceTwo014Step13, traceTwo014Real32]


