noncomputable def traceTwo010Real12 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  ((realB z k*(realA z k+realC z k)))*(traceTwo010Real11 z k)

theorem traceTwo010Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramE k) (traceTwo010Step11 k)) (traceTwo010Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo010Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo010Step12 k) = traceTwo010Real12 z k := by
  rw [eval_of_same _ _ _ (traceTwo010Step12_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_gramE, eval_traceTwo010Step11, traceTwo010Real12]


