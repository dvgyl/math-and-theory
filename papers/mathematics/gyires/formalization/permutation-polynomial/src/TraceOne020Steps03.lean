noncomputable def traceOne020Real13 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceOne020Real12 z k)+(traceOne020Real10 z k)

theorem traceOne020Step13_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceOne020Step12 k) (traceOne020Step10 k)) (traceOne020Step13 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne020Step13 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne020Step13 k) = traceOne020Real13 z k := by
  rw [eval_of_same _ _ _ (traceOne020Step13_identity k)]
  simp only [SparsePolynomial.eval_add, eval_traceOne020Step12, eval_traceOne020Step10, traceOne020Real13]


