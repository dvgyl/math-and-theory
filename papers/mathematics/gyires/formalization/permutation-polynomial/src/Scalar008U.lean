theorem u_order_008_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k)
      (uSix k 6) (uOrder007 k)) (uOrder008 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder008 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (uOrder008 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 8 := by
  rw [eval_of_same _ _ _ (u_order_008_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uSix k 6) (uOrder007 k) 6
    (eval_uSix z k 6 (by omega)) (eval_uOrder007 z k)

