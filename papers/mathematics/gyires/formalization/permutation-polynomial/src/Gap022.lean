module

public import Join022Steps03

@[expose] public section

namespace MathAndTheory.Gyires.PermutationCoefficientStage

open MathAndTheory.Gyires.PermutationFinite
open MathAndTheory.Gyires.PermutationCoefficientRecurrence

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

noncomputable def squareOrder022 (k : Fin 3) : Polynomial := join022Step11 k

noncomputable def gramOrder022 (k : Fin 3) : Polynomial := join022Step14 k

noncomputable def gapOrder022 : Fin 3 → Polynomial :=
  ![PackedData.decodeBlocks 268 165 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (11, )],
    PackedData.decodeBlocks 268 165 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (11, )],
    PackedData.decodeBlocks 278 175 [(32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (32, ), (11, )]]

theorem gap_order_022_identity (k : Fin 3) :
    SparsePolynomial.same (gapJoin 22 (squareOrder022 k) (gramOrder022 k)) (gapOrder022 k) = true := by
  fin_cases k <;> decide +kernel

theorem gap_order_022_coefficients (k : Fin 3) :
    SparsePolynomial.coeffsNonneg (gapOrder022 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_squareOrder022 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (squareOrder022 k) =
      permanentSquareExpr 22 (realA z k) (realB z k) (realC z k) := by
  change SparsePolynomial.eval (evaluator z) (join022Step11 k) = _
  rw [eval_join022Step11]
  dsimp only [join022Real01, join022Real02, join022Real03, join022Real04, join022Real05, join022Real06, join022Real07, join022Real08, join022Real09, join022Real10, join022Real11]
  have h : SparsePolynomial.eval (evaluator z)
      (squareJoin (apOrder022 k) (cpOrder022 k) (uOrder022 k) (vOrder022 k) (wOrder022 k)
        (fpOrder022 k) (SparsePolynomial.mul (SparsePolynomial.const ((-1 : ℤ)^22)) (fpOrder022 k))) =
      permanentSquareExpr 22 (realA z k) (realB z k) (realC z k) := by
    apply eval_squareJoin
    · exact eval_apOrder022 z k
    · exact eval_cpOrder022 z k
    · simpa using eval_uOrder022 z k
    · simpa using eval_vOrder022 z k
    · simpa using eval_wOrder022 z k
    · exact eval_fpOrder022 z k
    · exact eval_signed_power (evaluator z) (fpOrder022 k) 22
        (realA z k*realC z k) (eval_fpOrder022 z k)
  simpa only [squareJoin, SparsePolynomial.eval_add, SparsePolynomial.eval_mul] using h

theorem eval_gramOrder022 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gramOrder022 k) =
      gramExpr 22 (realA z k) (realB z k) (realC z k) := by
  change SparsePolynomial.eval (evaluator z) (join022Step14 k) = _
  rw [eval_join022Step14]
  dsimp only [join022Real07, join022Real12, join022Real13, join022Real14]
  have h := eval_gramJoin (evaluator z) 22 (realA z k) (realB z k) (realC z k)
    (fpOrder022 k) (t1Order022 k) (t2Order022 k)
    (eval_fpOrder022 z k) (eval_t1Order022 z k) (eval_t2Order022 z k)
  simpa only [gramJoin, SparsePolynomial.eval_add, SparsePolynomial.eval_mul] using h

theorem eval_gapOrder022 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (gapOrder022 k) =
      rawGap 22 (realA z k) (realB z k) (realC z k) := by
  rw [eval_of_same _ _ _ (gap_order_022_identity k)]
  exact eval_gapJoin (evaluator z) 22 (realA z k) (realB z k) (realC z k)
    (squareOrder022 k) (gramOrder022 k) (eval_squareOrder022 z k) (eval_gramOrder022 z k)

theorem chamber_order_022_nonneg (z : Fin 3 → ℝ) (hz : ∀ i, 0 ≤ z i) (k : Fin 3) :
    0 ≤ rawGap 22 (realA z k) (realB z k) (realC z k) := by
  rw [← eval_gapOrder022]
  exact SparsePolynomial.eval_nonneg_of_check _
    (SparsePolynomial.primeEvaluation_nonneg PermutationCoefficients.primes z hz) _
    (gap_order_022_coefficients k)

theorem cycle_order_022_both_gram {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    let A := PermutationMatrixBridge.polynomialMatrix (finRotate 22) a b c
    dimensionConstant 22 * (A*A.transpose).permanent ≤ A.permanent^2 ∧
      dimensionConstant 22 * (A.transpose*A).permanent ≤ A.permanent^2 := by
  apply both_gram_of_rawGap_nonneg 22 (by omega) ha hb hc
  exact rawGap_nonneg_of_chambers 22 chamber_order_022_nonneg ha hb hc

end MathAndTheory.Gyires.PermutationCoefficientStage
