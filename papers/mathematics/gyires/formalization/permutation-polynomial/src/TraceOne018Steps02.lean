  (traceOne018Real11 z k)+(traceOne018Real06 z k)

theorem traceOne018Step12_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.add (traceOne018Step11 k) (traceOne018Step06 k)) (traceOne018Step12 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceOne018Step12 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceOne018Step12 k) = traceOne018Real12 z k := by
  rw [eval_of_same _ _ _ (traceOne018Step12_identity k)]
