theorem fp_order_020_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (gramF k) (fpOrder019 k)) (fpOrder020 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_fpOrder020 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (fpOrder020 k) = (realA z k*realC z k)^20 := by
  rw [eval_of_same _ _ _ (fp_order_020_identity k), SparsePolynomial.eval_mul,
    eval_gramF, eval_fpOrder019]
  rw [← pow_succ']


