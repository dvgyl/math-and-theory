noncomputable def scalarV015Real01 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (SparsePolynomial.eval (evaluator z) (scalarVB k)) * (powerSum (SparsePolynomial.eval (evaluator z) (scalarVB k)) (SparsePolynomial.eval (evaluator z) (scalarVD k)) 14)

theorem scalarV015Step01_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.mul (scalarVB k) (vOrder014 k)) (scalarV015Step01 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_scalarV015Step01 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (scalarV015Step01 k) = scalarV015Real01 z k := by
  rw [eval_of_same _ _ _ (scalarV015Step01_identity k)]
  simp only [SparsePolynomial.eval_mul, eval_vOrder014, scalarV015Real01]

