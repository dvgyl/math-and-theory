theorem u_order_013_identity (k : Fin 3) :
    SparsePolynomial.same (scalarStep (scalarUB k) (scalarUD k)
      (uOrder011 k) (uOrder012 k)) (uOrder013 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_uOrder013 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (uOrder013 k) =
      powerSum (SparsePolynomial.eval (evaluator z) (scalarUB k))
        (SparsePolynomial.eval (evaluator z) (scalarUD k)) 13 := by
  rw [eval_of_same _ _ _ (u_order_013_identity k)]
  exact eval_scalarStep (evaluator z) (scalarUB k) (scalarUD k)
    (uOrder011 k) (uOrder012 k) 11
    (eval_uOrder011 z k) (eval_uOrder012 z k)

