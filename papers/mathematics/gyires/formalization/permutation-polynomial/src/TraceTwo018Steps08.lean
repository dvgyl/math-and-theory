noncomputable def traceTwo018Real35 (z : Fin 3 → ℝ) (k : Fin 3) : ℝ :=
  (traceTwo018Real34 z k)-(traceTwo018Real28 z k)

theorem traceTwo018Step35_identity (k : Fin 3) :
    SparsePolynomial.same (SparsePolynomial.sub (traceTwo018Step34 k) (traceTwo018Step28 k)) (traceTwo018Step35 k) = true := by
  fin_cases k <;> decide +kernel

theorem eval_traceTwo018Step35 (z : Fin 3 → ℝ) (k : Fin 3) :
    SparsePolynomial.eval (evaluator z) (traceTwo018Step35 k) = traceTwo018Real35 z k := by
  rw [eval_of_same _ _ _ (traceTwo018Step35_identity k)]
  simp only [SparsePolynomial.eval_sub, eval_traceTwo018Step34, eval_traceTwo018Step28, traceTwo018Real35]


