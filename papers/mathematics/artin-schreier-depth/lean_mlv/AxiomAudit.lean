/-!
# Transitive axiom audit of every declaration defined by a production module

The environment is traversed directly. No blacklist or public-name heuristic is
used to choose declarations: private helpers, generated declarations, structure
constructors/projections, and unnamed instances are included by defining module.
`Lean.collectAxioms` is the same transitive collector used by `#print axioms`.
JSON records and a checked count summary are consumed by verify_cached.py.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000

open Lean Elab Command in
run_cmd do
  let modules : Array Name := #[`ASDepthTheorem, `AdditiveGalois, `AlgebraicResidue, `ClosureTransport, `FirstAccumulation, `FirstBlock, `FirstBlockContainment, `HahnASRoot, `HahnApproximation, `HahnBoundary, `HahnFinite, `HahnFrobenius, `HahnSupport, `HenselianAlgebraicGlue, `HenselianBridge, `HenselianKrasner, `HenselianRationalNorm, `HenselianStandardBridge, `LegacyCompat, `MLVChains, `MLVComparison, `MLVCorrespondence, `MLVDepth, `MLVDepthOne, `MLVGauss, `MLVIntrinsic, `MLVLinearNormalForm, `MLVReverse, `MLVSource2024, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.AlgebraicExtension.NormFormula, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.AlgebraicExtension.NormFormulaAbsoluteValue, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.AlgebraicExtension.NormFormulaCoefficients, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.AlgebraicExtension.NormFormulaIntegralClosure, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.AlgebraicExtension.UniqueValuationSubring, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.Completeness, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.PrincipalAdicCompleteness, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.Theory.AbsoluteValues, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.Theory.Core, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.Theory.ExponentialValuations, `Nyll.ValuedFieldTheory.Valuation.AbsoluteValue.ValuationSubring, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.AdicPower, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.Basic, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.ChevalleyExtension, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.Complete, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.Extensions, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.Henselian, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.HenselianFinite, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.HenselianValuationExtension, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.ResidueField, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.ValuationExtension, `Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.ValuationTransport, `Nyll.ValuedFieldTheory.Valuation.HenselLemma, `Nyll.ValuedFieldTheory.Valuation.Henselian.AlgebraicExtensionUniqueness, `Nyll.ValuedFieldTheory.Valuation.Henselian.AlgebraicIntegralClosure, `Nyll.ValuedFieldTheory.Valuation.Henselian.CoprimeFactorLifting, `Nyll.ValuedFieldTheory.Valuation.Henselian.Core, `Nyll.ValuedFieldTheory.Valuation.Henselian.EtaleLifting, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.AdicLimits, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.Assembly, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.Basic, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.CoefficientMinimum, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.Complete, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.DegreeBounds, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.DivisionBounds, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.ErrorPowers, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.FiniteApproximation, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.InfiniteApproximation, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.Iteration, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.PrincipalLimits, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.Step, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.Truncation, `Nyll.ValuedFieldTheory.Valuation.Henselian.Factorization.WeakLimits, `Nyll.ValuedFieldTheory.Valuation.Henselian.IrreduciblePolynomialBounds, `Nyll.ValuedFieldTheory.Valuation.Henselian.IrreduciblePolynomialLifting, `Nyll.ValuedFieldTheory.Valuation.Henselian.MonicFactorization, `Nyll.ValuedFieldTheory.Valuation.Henselian.NonmonicReduction, `Nyll.ValuedFieldTheory.Valuation.Henselian.PrimitiveFactorization, `Nyll.ValuedFieldTheory.Valuation.Henselian.PrimitiveReduction, `Nyll.ValuedFieldTheory.Valuation.Henselian.SimpleRootFactorization, `Nyll.ValuedFieldTheory.Valuation.Henselian.StandardEtaleLifting, `Nyll.ValuedFieldTheory.Valuation.Henselian.UniqueExtensionReduction, `Nyll.ValuedFieldTheory.Valuation.Henselian.ValuationExtensionCriterion, `Nyll.ValuedFieldTheory.Valuation.UniqueRing, `OkutsuDepth, `OreFace, `StandardTowerCriterion, `SupportAssembly, `SupportClosure, `TowerApproximation, `TowerClosureConverse, `TowerDepthObstruction, `TowerFirstBlock, `TowerForward, `TowerForwardAbstract, `TowerForwardAssembly, `TowerForwardEmbedding, `TowerForwardFinite, `TowerForwardPrimitive, `TowerForwardRoots, `TowerMLVCriterion]
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  let env ← getEnv
  for moduleName in modules do
    unless (env.getModuleIdx? moduleName).isSome do
      throwError m!"Production module missing from environment: {moduleName}"
  let declarations ← env.constants.foldM
    (init := (#[] : Array (Name × Name × String))) fun acc name info => do
      match env.getModuleIdxFor? name with
      | none => pure acc
      | some index =>
        let owner := env.header.moduleNames[index.toNat]!
        if modules.contains owner then
          let kind := match info with
            | .axiomInfo _ => "axiom"
            | .defnInfo _ => "definition"
            | .thmInfo _ => "theorem"
            | .opaqueInfo _ => "opaque"
            | .quotInfo _ => "quotient"
            | .inductInfo _ => "inductive"
            | .ctorInfo _ => "constructor"
            | .recInfo _ => "recursor"
          pure (acc.push (owner, name, kind))
        else
          pure acc
  let declarations := declarations.qsort (fun a b => Name.lt a.2.1 b.2.1)
  let mut rejected : Array Name := #[]
  for (owner, name, kind) in declarations do
    let axioms ← collectAxioms name
    let axioms := axioms.qsort Name.lt
    if axioms.any (fun ax => !allowed.contains ax) then
      rejected := rejected.push name
    let record := Json.mkObj [
      ("module", toJson owner.toString),
      ("name", toJson name.toString),
      ("kind", toJson kind),
      ("axioms", toJson (axioms.map Name.toString))]
    logInfo m!"NTC_AXIOM_DECL {record.compress}"
  let mut counts : List (String × Json) := []
  for moduleName in modules do
    let count := (declarations.filter (fun entry => entry.1 == moduleName)).size
    if count == 0 then
      throwError m!"Production module had zero audited declarations: {moduleName}"
    counts := counts ++ [(moduleName.toString, toJson count)]
  let summary := Json.mkObj [
    ("schema", toJson (1 : Nat)),
    ("collector", toJson "Lean.collectAxioms"),
    ("selection", toJson "Environment.getModuleIdxFor? defining module; no name blacklist"),
    ("modules", toJson (modules.map Name.toString)),
    ("counts", Json.mkObj counts),
    ("total", toJson declarations.size),
    ("allowed_axioms", toJson (allowed.map Name.toString))]
  logInfo m!"NTC_AXIOM_SUMMARY {summary.compress}"
  unless rejected.isEmpty do
    throwError m!"Nonstandard transitive axioms in declarations: {rejected.toList}"
