import Mathlib

/-!
# Primitive generators with coefficients in an infinite constant field

For a finite separable extension generated by finitely many elements, a
linear combination with coefficients in any given infinite subfield can
be primitive.  The proof excludes finitely many roots of actual difference
polynomials for pairs of embeddings.  No normality premise is required.
-/

noncomputable section
set_option maxHeartbeats 1200000

open IntermediateField Polynomial
open scoped BigOperators

namespace NTCThird

/-- An infinite coefficient field supplies a nonvanishing evaluation of
every nonzero polynomial over an extension field. -/
theorem exists_constant_eval_ne_zero
    {k A : Type*} [Field k] [Field A] [Algebra k A] [Infinite k]
    (P : A[X]) (hP : P ≠ 0) :
    ∃ c : k, P.eval (algebraMap k A c) ≠ 0 := by
  by_contra h
  push Not at h
  have hinfinite : (Set.range (algebraMap k A)).Infinite :=
    Set.infinite_range_of_injective (algebraMap k A).injective
  apply hinfinite
  apply (Polynomial.finite_setOfPred_isRoot hP).subset
  rintro x ⟨c, rfl⟩
  exact h c

/-- A finite separable extension has a primitive linear combination of any
finite generating family using coefficients from an infinite constant
subfield.  The displayed coefficients are successive powers of one actual
constant, selected by avoiding the finitely many embedding collisions. -/
theorem exists_primitive_constant_combination
    {k K M A : Type*} [Field k] [Field K] [Field M] [Field A]
    [Algebra k K] [Algebra K M] [Algebra K A]
    [Algebra k M] [Algebra k A]
    [IsScalarTower k K M] [IsScalarTower k K A]
    [Infinite k] [FiniteDimensional K M] [Algebra.IsSeparable K M]
    (hsplits : ∀ x : M, ((minpoly K x).map (algebraMap K A)).Splits)
    (n : ℕ) (z : Fin n → M)
    (hgen : IntermediateField.adjoin K (Set.range z) = ⊤) :
    ∃ c : k, K⟮∑ i : Fin n, algebraMap k M (c ^ (i : ℕ)) * z i⟯ = ⊤ := by
  classical
  let H := M →ₐ[K] A
  let P : H → H → A[X] := fun φ ψ =>
    ∑ i : Fin n, Polynomial.monomial (i : ℕ) (φ (z i) - ψ (z i))
  have hcoeff : ∀ (φ ψ : H) (i : Fin n),
      (P φ ψ).coeff (i : ℕ) = φ (z i) - ψ (z i) := by
    intro φ ψ i
    simp [P, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Fin.val_inj]
  have hgenA : Algebra.adjoin K (Set.range z) = ⊤ := by
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
      (fun x _ => (IsIntegral.of_finite K x).isAlgebraic), hgen]
    rfl
  have hP : ∀ φ ψ : H, φ ≠ ψ → P φ ψ ≠ 0 := by
    intro φ ψ hne hzero
    apply hne
    apply AlgHom.ext_of_adjoin_eq_top hgenA
    rintro x ⟨i, rfl⟩
    have h : (P φ ψ).coeff (i : ℕ) = 0 :=
      congrArg (fun Q : A[X] => Q.coeff (i : ℕ)) hzero
    rw [hcoeff] at h
    exact sub_eq_zero.mp h
  let I := {ij : H × H // ij.1 ≠ ij.2}
  let Q : A[X] := ∏ ij : I, P ij.val.1 ij.val.2
  have hQ : Q ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro ij _
    exact hP _ _ ij.property
  obtain ⟨c, hc⟩ := exists_constant_eval_ne_zero (k := k) Q hQ
  let θ : M := ∑ i : Fin n, algebraMap k M (c ^ (i : ℕ)) * z i
  have hconstants : ∀ (φ : H) (b : k),
      φ (algebraMap k M b) = algebraMap k A b := by
    intro φ b
    rw [IsScalarTower.algebraMap_apply k K M, φ.commutes,
      ← IsScalarTower.algebraMap_apply k K A]
  have heval : ∀ φ ψ : H,
      (P φ ψ).eval (algebraMap k A c) = φ θ - ψ θ := by
    intro φ ψ
    simp only [P, Polynomial.eval_finsetSum, Polynomial.eval_monomial,
      θ, map_sum, map_mul, hconstants, map_pow]
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  refine ⟨c, ?_⟩
  apply (Field.primitive_element_iff_algHom_eq_of_eval' K A hsplits θ).mpr
  intro φ ψ heq
  apply Classical.byContradiction
  intro hne
  let ij : I := ⟨(φ, ψ), hne⟩
  have hprod : (∏ ij : I, (P ij.val.1 ij.val.2).eval (algebraMap k A c)) ≠ 0 := by
    simpa only [Q, Polynomial.eval_prod] using hc
  have hnonzero := Finset.prod_ne_zero_iff.mp hprod ij (Finset.mem_univ ij)
  apply hnonzero
  rw [heval]
  exact sub_eq_zero.mpr heq

/-- Finite-type form of the same primitive constant-combination theorem. -/
theorem exists_primitive_constant_combination_fintype
    {k K M A : Type*} [Field k] [Field K] [Field M] [Field A]
    [Algebra k K] [Algebra K M] [Algebra K A]
    [Algebra k M] [Algebra k A]
    [IsScalarTower k K M] [IsScalarTower k K A]
    [Infinite k] [FiniteDimensional K M] [Algebra.IsSeparable K M]
    (hsplits : ∀ x : M, ((minpoly K x).map (algebraMap K A)).Splits)
    {ι : Type*} [Fintype ι] (z : ι → M)
    (hgen : IntermediateField.adjoin K (Set.range z) = ⊤) :
    ∃ c : ι → k, K⟮∑ i : ι, algebraMap k M (c i) * z i⟯ = ⊤ := by
  classical
  let e := Fintype.equivFin ι
  have hrange : Set.range (fun j : Fin (Fintype.card ι) => z (e.symm j)) =
      Set.range z := by
    ext x
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨e.symm j, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e i, by simp⟩
  obtain ⟨c, hc⟩ := exists_primitive_constant_combination (k := k) hsplits
    (Fintype.card ι) (fun j => z (e.symm j)) (by rw [hrange]; exact hgen)
  refine ⟨fun i => c ^ (e i : ℕ), ?_⟩
  have hsum : (∑ i : ι, algebraMap k M (c ^ (e i : ℕ)) * z i) =
      ∑ j : Fin (Fintype.card ι), algebraMap k M (c ^ (j : ℕ)) * z (e.symm j) := by
    simpa only [Equiv.symm_apply_apply] using
      e.sum_comp (fun j => algebraMap k M (c ^ (j : ℕ)) * z (e.symm j))
  rw [hsum]
  exact hc

end NTCThird
