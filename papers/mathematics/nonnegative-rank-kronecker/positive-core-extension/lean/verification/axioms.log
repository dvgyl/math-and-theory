@PositiveCore.tensor_obstruction_of_score : ∀ {s : Type u_1} {t : Type u_2} [Fintype s] [inst : Fintype t]
  (A : Matrix (Fin 4) (Fin 4) ℝ) (B : Matrix s t ℝ),
  MatCKronecker.EntryNonneg A →
    MatCKronecker.EntryNonneg B →
      (∀ (j : Fin 4), A 0 j + A 2 j = A 1 j + A 3 j) →
        (∀ (i : Fin 4), A i 0 + A i 2 = A i 1 + A i 3) →
          PositiveCore.ConeObstruction.mass A / 2 < PositiveCore.ConeObstruction.score A →
            ∀ (i0 : s) (j0 : t),
              0 < B i0 j0 →
                (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) A B).rank <
                  MatCKronecker.nnrank (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) A B)
