module

public import MatCP1Converse.RankDecomposition

@[expose] public section

noncomputable section

namespace MatCP1Converse

section Reachable

variable {F V W Z : Type*} [Field F]
  [AddCommGroup V] [Module F V] [AddCommGroup W] [Module F W]
  [AddCommGroup Z] [Module F Z]

/-- The actual reachable subspace generated by all iterates of a linear map. -/
def pencilReachable (A : V →ₗ[F] V) (B : W →ₗ[F] V) : Submodule F V :=
  Submodule.span F {v | ∃ (k : ℕ) (w : W), v = (A ^ k) (B w)}

theorem pencilReachable_contains_range (A : V →ₗ[F] V) (B : W →ₗ[F] V) :
    LinearMap.range B ≤ pencilReachable A B := by
  rintro v ⟨w, rfl⟩
  apply Submodule.subset_span
  exact ⟨0, w, by simp⟩

theorem pencilReachable_invariant (A : V →ₗ[F] V) (B : W →ₗ[F] V) :
    ∀ v ∈ pencilReachable A B, A v ∈ pencilReachable A B := by
  have hh : pencilReachable A B ≤ (pencilReachable A B).comap A := by
    apply Submodule.span_le.mpr
    rintro v ⟨k, w, rfl⟩
    apply Submodule.subset_span
    exact ⟨k + 1, w, by simp [pow_succ', Module.End.mul_apply]⟩
  exact fun v hv => hh hv

theorem pencilReachable_le_kernel (A : V →ₗ[F] V) (B : W →ₗ[F] V) (C : V →ₗ[F] Z)
    (h : ∀ k : ℕ, C.comp ((A ^ k).comp B) = 0) :
    pencilReachable A B ≤ LinearMap.ker C := by
  apply Submodule.span_le.mpr
  rintro v ⟨k, w, rfl⟩
  exact LinearMap.congr_fun (h k) w

end Reachable

section MixedFactors

variable {F V W Z : Type*} [Field F]
  [AddCommGroup V] [Module F V] [AddCommGroup W] [Module F W]
  [AddCommGroup Z] [Module F Z] [FiniteDimensional F V]

/-- Actual constant mixed factors for the normalized pair, with the exact sum of
factor dimensions. The reachable subspace and a complement are constructed. -/
theorem exists_normalized_linear_mixed_factorization
    (A : V →ₗ[F] V) (B : W →ₗ[F] V) (C : V →ₗ[F] Z)
    (hMom : ∀ k : ℕ, C.comp ((A ^ k).comp B) = 0) :
    ∃ (S T : Submodule F V)
      (U : S →ₗ[F] (V × Z)) (Q : (V × W) →ₗ[F] T)
      (R0 R1 : (V × W) →ₗ[F] S) (L0 L1 : T →ₗ[F] (V × Z)),
      Module.finrank F S + Module.finrank F T = Module.finrank F V ∧
      Function.Injective U ∧ Function.Surjective Q ∧
      (LinearMap.id.prodMap (0 : W →ₗ[F] Z)) = U.comp R0 + L0.comp Q ∧
      ((A.coprod B).prod (C.coprod (0 : W →ₗ[F] Z))) = U.comp R1 + L1.comp Q := by
  classical
  let S := pencilReachable A B
  obtain ⟨T, hST⟩ := S.exists_isCompl
  let pS := S.projectionOnto T hST
  let pT := T.projectionOnto S hST.symm
  have hsum (v : V) : (pS v : V) + (pT v : V) = v :=
    S.projection_add_projection_eq_self hST v
  have hAS := pencilReachable_invariant A B
  have hBS := pencilReachable_contains_range A B
  have hSC := pencilReachable_le_kernel A B C hMom
  let AR : S →ₗ[F] S := (A.comp S.subtype).codRestrict S (fun v => hAS v v.property)
  let BR : W →ₗ[F] S := B.codRestrict S (fun w => hBS ⟨w, rfl⟩)
  let U : S →ₗ[F] (V × Z) := S.subtype.prod 0
  let Q : (V × W) →ₗ[F] T := pT.comp (LinearMap.fst F V W)
  let R0 : (V × W) →ₗ[F] S := pS.comp (LinearMap.fst F V W)
  let R1 : (V × W) →ₗ[F] S := AR.comp R0 + BR.comp (LinearMap.snd F V W)
  let L0 : T →ₗ[F] (V × Z) := T.subtype.prod 0
  let L1 : T →ₗ[F] (V × Z) := (A.comp T.subtype).prod (C.comp T.subtype)
  refine ⟨S, T, U, Q, R0, R1, L0, L1, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [Module.finrank_prod] using (S.prodEquivOfIsCompl T hST).finrank_eq
  · intro u v huv
    exact Subtype.ext (congrArg Prod.fst huv)
  · intro t
    refine ⟨((t : V), 0), ?_⟩
    simp [Q, pT]
  · apply LinearMap.ext
    rintro ⟨v, w⟩
    apply Prod.ext
    · exact (hsum v).symm
    · simp [U, Q, R0, L0]
  · apply LinearMap.ext
    rintro ⟨v, w⟩
    apply Prod.ext
    · change A v + B w = (A (pS v) + B w) + A (pT v)
      have hh : A (pS v) + A (pT v) = A v := by rw [← map_add, hsum]
      rw [← hh]
      abel
    · change C v + 0 = 0 + C (pT v)
      have hc : C (pS v) = 0 := hSC (pS v).property
      have hh := congrArg C (hsum v)
      simpa only [map_add, hc, zero_add, add_zero] using hh.symm

end MixedFactors

section MatrixFactors

variable {F n p q : Type*} [Field F]
  [Fintype n] [Fintype p] [Fintype q]
  [DecidableEq n] [DecidableEq p] [DecidableEq q]

open Matrix

omit [Fintype p] [DecidableEq p] in
theorem rank_product_to_blocks (A : Matrix n n F) (B : Matrix n q F)
    (C : Matrix p n F) (D : Matrix p q F) :
    (LinearEquiv.sumArrowLequivProdArrow n p F F).symm.toLinearMap.comp
      ((((Matrix.toLin' A).coprod (Matrix.toLin' B)).prod
        ((Matrix.toLin' C).coprod (Matrix.toLin' D))).comp
        (LinearEquiv.sumArrowLequivProdArrow n q F F).toLinearMap) =
      Matrix.toLin' (fromBlocks A B C D) := by
  apply LinearMap.ext
  intro v
  funext i
  cases i <;>
    simp [Matrix.toLin'_apply, Matrix.fromBlocks_mulVec,
      LinearEquiv.sumArrowLequivProdArrow] <;> rfl

omit [Fintype p] [DecidableEq p] in
/-- Literal normalized-pencil mixed factorization from the genuine normal-rank
bound. All factors are constant matrices except the two displayed affine pairs;
the dimensions add to the actual full rank of the constant coefficient. -/
theorem normalized_pencil_mixed_factorization
    (A : Matrix n n F) (B : Matrix n q F) (C : Matrix p n F) (D : Matrix p q F)
    (hRank : (rankNormalizedPencil A B C D).normalRank ≤ Fintype.card n) :
    ∃ (a b : ℕ) (U : Matrix (n ⊕ p) (Fin a) F) (V : Matrix (Fin b) (n ⊕ q) F)
      (R0 R1 : Matrix (Fin a) (n ⊕ q) F) (L0 L1 : Matrix (n ⊕ p) (Fin b) F),
      a + b = Fintype.card n ∧
      Function.Injective U.mulVec ∧ Function.Surjective V.mulVec ∧
      fromBlocks (1 : Matrix n n F) (0 : Matrix n q F) (0 : Matrix p n F) 0 =
        U * R0 + L0 * V ∧
      fromBlocks A B C D = U * R1 + L1 * V := by
  classical
  obtain ⟨hD, hMom⟩ := normalized_pencil_all_moments A B C D hRank
  have hm : ∀ k : ℕ, (Matrix.toLin' C).comp
      (((Matrix.toLin' A) ^ k).comp (Matrix.toLin' B)) = 0 := by
    intro k
    have hh := congrArg Matrix.toLin' (hMom k)
    simpa only [Matrix.toLin'_mul, Matrix.toLin'_pow, map_zero,
      LinearMap.comp_assoc] using hh
  obtain ⟨S, T, U, V, R0, R1, L0, L1, hdim, hU, hV, h0, h1⟩ :=
    exists_normalized_linear_mixed_factorization (Matrix.toLin' A) (Matrix.toLin' B)
      (Matrix.toLin' C) hm
  let eS := (Module.finBasis F S).equivFun
  let eT := (Module.finBasis F T).equivFun
  let en := LinearEquiv.sumArrowLequivProdArrow n q F F
  let em := LinearEquiv.sumArrowLequivProdArrow n p F F
  let Um := LinearMap.toMatrix' (em.symm.toLinearMap.comp (U.comp eS.symm.toLinearMap))
  let Vm := LinearMap.toMatrix' (eT.toLinearMap.comp (V.comp en.toLinearMap))
  let Rm := fun R : ((n → F) × (q → F)) →ₗ[F] S =>
    LinearMap.toMatrix' (eS.toLinearMap.comp (R.comp en.toLinearMap))
  let Lm := fun L : T →ₗ[F] ((n → F) × (p → F)) =>
    LinearMap.toMatrix' (em.symm.toLinearMap.comp (L.comp eT.symm.toLinearMap))
  refine ⟨Module.finrank F S, Module.finrank F T, Um, Vm, Rm R0, Rm R1,
    Lm L0, Lm L1, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [Module.finrank_pi, Module.finrank_self, mul_one] using hdim
  · intro v w hvw
    have hh : em.symm (U (eS.symm v)) = em.symm (U (eS.symm w)) := by
      simpa only [Um, LinearMap.toMatrix'_mulVec, LinearMap.comp_apply,
        LinearEquiv.coe_coe] using hvw
    exact eS.symm.injective (hU (em.symm.injective hh))
  · intro v
    obtain ⟨w, hw⟩ := hV (eT.symm v)
    refine ⟨en.symm w, ?_⟩
    simp only [Vm, LinearMap.toMatrix'_mulVec, LinearMap.comp_apply,
      LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply, hw]
  · apply Matrix.toLin'.injective
    have hblock : Matrix.toLin'
        (fromBlocks (1 : Matrix n n F) (0 : Matrix n q F) (0 : Matrix p n F) 0) =
        em.symm.toLinearMap.comp
          ((LinearMap.id.prodMap (0 : (q → F) →ₗ[F] (p → F))).comp en.toLinearMap) := by
      rw [← rank_product_to_blocks]
      congr 2
      apply LinearMap.ext
      rintro ⟨v, w⟩
      simp
    rw [hblock, h0]
    apply LinearMap.ext
    intro v
    simp [Um, Vm, Rm, Lm, Matrix.toLin'_mul, map_add]
  · apply Matrix.toLin'.injective
    have hblock : Matrix.toLin' (fromBlocks A B C D) =
        em.symm.toLinearMap.comp
          ((((Matrix.toLin' A).coprod (Matrix.toLin' B)).prod
            ((Matrix.toLin' C).coprod (0 : (q → F) →ₗ[F] (p → F)))).comp en.toLinearMap) := by
      rw [hD, ← rank_product_to_blocks]
      simp only [map_zero, em, en]
    rw [hblock, h1]
    apply LinearMap.ext
    intro v
    simp [Um, Vm, Rm, Lm, Matrix.toLin'_mul, map_add]

end MatrixFactors

end MatCP1Converse
