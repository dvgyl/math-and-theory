info: MatCP1Converse/RankDecompositionAudit.lean:5:0: MatCP1Converse.normalized_pencil_all_moments.{u_1, u_2, u_3, u_4} {F : Type u_1} {n : Type u_2} {p : Type u_3}
  {q : Type u_4} [Field F] [Fintype n] [Fintype q] [DecidableEq n] (A : Matrix n n F) (B : Matrix n q F)
  (C : Matrix p n F) (D : Matrix p q F)
  (hRank : (MatCP1Converse.rankNormalizedPencil A B C D).normalRank ≤ Fintype.card n) :
  D = 0 ∧ ∀ (j : ℕ), C * A ^ j * B = 0
info: MatCP1Converse/RankDecompositionAudit.lean:6:0: MatCP1Converse.normalized_pencil_mixed_factorization.{u_1, u_2, u_3, u_4} {F : Type u_1} {n : Type u_2} {p : Type u_3}
  {q : Type u_4} [Field F] [Fintype n] [Fintype q] [DecidableEq n] [DecidableEq q] (A : Matrix n n F) (B : Matrix n q F)
  (C : Matrix p n F) (D : Matrix p q F)
  (hRank : (MatCP1Converse.rankNormalizedPencil A B C D).normalRank ≤ Fintype.card n) :
  ∃ a b U V R0 R1 L0 L1,
    a + b = Fintype.card n ∧
      Function.Injective U.mulVec ∧
        Function.Surjective V.mulVec ∧
          Matrix.fromBlocks 1 0 0 0 = U * R0 + L0 * V ∧ Matrix.fromBlocks A B C D = U * R1 + L1 * V
info: MatCP1Converse/RankDecompositionAudit.lean:7:0: MatCP1Converse.Pencil.exists_rank_mixed_factorization.{u_1, u_2, u_3} {F : Type u_1} {m : Type u_2} {n : Type u_3}
