import ConeExclusion

open scoped BigOperators Matrix ComplexOrder
open Matrix

namespace PPTCone

variable {A B : Type*} [Fintype A] [Fintype B]

/-- The cone generated by pure positive matrices whose vectors satisfy a
specified property. In the applications the property is an actual Schmidt
rank bound; no relaxation or finite sample is involved. -/
def PureCone (V : (A × B → ℂ) → Prop) (R : Matrix (A × B) (A × B) ℂ) : Prop :=
  ∃ n : ℕ, ∃ v : Fin n → A × B → ℂ,
    (∀ k, V (v k)) ∧ R = ∑ k, pure (v k)

def TransposeConeSum (V : (A × B → ℂ) → Prop)
    (R : Matrix (A × B) (A × B) ℂ) : Prop :=
  ∃ Q T, PureCone V Q ∧ PureCone V T ∧ R = Q + partialTranspose T

omit [Fintype A] [Fintype B] in
theorem PureCone.mono {V W : (A × B → ℂ) → Prop}
    {R : Matrix (A × B) (A × B) ℂ}
    (h : PureCone V R) (hVW : ∀ v, V v → W v) : PureCone W R := by
  obtain ⟨n, v, hv, hR⟩ := h
  exact ⟨n, v, fun i => hVW (v i) (hv i), hR⟩

omit [Fintype A] [Fintype B] in
theorem TransposeConeSum.mono {V W : (A × B → ℂ) → Prop}
    {R : Matrix (A × B) (A × B) ℂ}
    (h : TransposeConeSum V R) (hVW : ∀ v, V v → W v) :
    TransposeConeSum W R := by
  obtain ⟨Q, T, hQ, hT, hR⟩ := h
  exact ⟨Q, T, hQ.mono hVW, hT.mono hVW, hR⟩

theorem pureCone_trace_nonneg (V : (A × B → ℂ) → Prop)
    (K R : Matrix (A × B) (A × B) ℂ)
    (hK : K.PosSemidef) (hR : PureCone V R) : 0 ≤ Matrix.trace (K * R) := by
  obtain ⟨n, v, hv, rfl⟩ := hR
  rw [Matrix.mul_sum, Matrix.trace_sum]
  apply Finset.sum_nonneg
  intro i hi
  rw [trace_mul_pure]
  exact hK.2 (v i)

theorem pureCone_eq_zero_of_trace_zero (V : (A × B → ℂ) → Prop)
    (K R : Matrix (A × B) (A × B) ℂ)
    (hK : K.PosSemidef) (hR : PureCone V R)
    (hker : ∀ v, V v → K *ᵥ v = 0 → v = 0)
    (hzero : Matrix.trace (K * R) = 0) : R = 0 := by
  obtain ⟨n, v, hv, rfl⟩ := hR
  rw [Matrix.mul_sum, Matrix.trace_sum] at hzero
  have hi : ∀ i : Fin n, Matrix.trace (K * pure (v i)) = 0 := by
    intro i
    exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => by
      rw [trace_mul_pure]
      exact hK.2 (v j))).mp hzero i (Finset.mem_univ i)
  have hvzero : ∀ i, v i = 0 := by
    intro i
    apply hker (v i) (hv i)
    apply (hK.dotProduct_mulVec_zero_iff (v i)).mp
    simpa only [trace_mul_pure] using hi i
  simp only [hvzero, pure_zero, Finset.sum_const_zero]

theorem not_transposeConeSum_of_separator (V : (A × B → ℂ) → Prop)
    (P K : Matrix (A × B) (A × B) ℂ)
    (hK : K.PosSemidef) (hpt : partialTranspose K = K)
    (hzero : Matrix.trace (K * P) = 0) (hne : P ≠ 0)
    (hker : ∀ v, V v → K *ᵥ v = 0 → v = 0) : ¬ TransposeConeSum V P := by
  rintro ⟨Q, R, hQ, hR, heq⟩
  have hsum : Matrix.trace (K * Q) + Matrix.trace (K * R) = 0 := by
    simpa only [heq, Matrix.mul_add, Matrix.trace_add, trace_partialTranspose, hpt]
      using hzero
  have hQ0 : Matrix.trace (K * Q) = 0 :=
    (add_eq_zero_iff_of_nonneg (pureCone_trace_nonneg V K Q hK hQ)
      (pureCone_trace_nonneg V K R hK hR)).mp hsum |>.1
  have hR0 : Matrix.trace (K * R) = 0 :=
    (add_eq_zero_iff_of_nonneg (pureCone_trace_nonneg V K Q hK hQ)
      (pureCone_trace_nonneg V K R hK hR)).mp hsum |>.2
  have hQzero := pureCone_eq_zero_of_trace_zero V K Q hK hQ hker hQ0
  have hRzero := pureCone_eq_zero_of_trace_zero V K R hK hR hker hR0
  apply hne
  simpa only [hQzero, hRzero, partialTranspose_zero, add_zero] using heq

end PPTCone
