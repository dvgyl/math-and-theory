@EllipsoidCounterexample.infinite_ClassD_counterexamples : ∀ {p : ℝ},
  0 < p →
    p < 1 / 2 →
      EllipsoidCounterexample.Admissible (EllipsoidCounterexample.canonicalEllipsoid (EllipsoidCounterexample.W p)) ∧
        EllipsoidCounterexample.ClassD (EllipsoidCounterexample.W p) ∧
          EllipsoidCounterexample.ClassD (EllipsoidCounterexample.W (1 - p)) ∧
            EllipsoidCounterexample.canonicalEllipsoid (EllipsoidCounterexample.W p) =
                EllipsoidCounterexample.canonicalEllipsoid (EllipsoidCounterexample.W (1 - p)) ∧
              EllipsoidCounterexample.StrictlyFiner (EllipsoidCounterexample.W (1 - p)) (EllipsoidCounterexample.W p) ∧
                ¬EllipsoidCounterexample.OptimalIn
                    (EllipsoidCounterexample.canonicalEllipsoid (EllipsoidCounterexample.W p))
                    (EllipsoidCounterexample.W p)
GeometryCertificates.raw_LMI_with_marginal_bound : ∀ (a b c : GeometryCertificates.R3) (T H P : GeometryCertificates.M3)
  (lam : ℝ),
  0 ≤ lam →
    GeometryCertificates.normSq3 b < 1 →
      ((GeometryCertificates.mul3 P fun i => a i - c i) = fun i => a i - c i) →
        P * GeometryCertificates.deviationMatrix T c b = GeometryCertificates.deviationMatrix T c b →
          GeometryCertificates.PSD4
              (GeometryCertificates.rawCertificate (fun i => a i - c i) (fun i j => T i j - c i * b j) b H lam) →
            GeometryCertificates.fractionalEllipsoid a T b ⊆ GeometryCertificates.metricEnclosure c H P
ProductVector.dimension_at_least_two_contains_product : ∀ (S : Submodule ℂ EllipsoidCounterexample.V4),
  2 ≤ Module.finrank ℂ ↥S → ∃ a b, EllipsoidCounterexample.product a b ∈ S ∧ EllipsoidCounterexample.product a b ≠ 0
OptimalityReduction.QuantumConnection.quantum_classification_given_structural_inputs : ∀
  (S C : Set EllipsoidCounterexample.M4),
  C ⊆ S →
    (∀ W ∈ S, ∃ U ∈ C, EllipsoidCounterexample.Finer U W) →
      (∀ W ∈ C, ∀ U ∈ C, EllipsoidCounterexample.Finer U W → EllipsoidCounterexample.Finer W U) →
        (∀ W ∈ S,
            ∀ U ∈ S,
              OptimalityReduction.QuantumConnection.detected W = OptimalityReduction.QuantumConnection.detected U →
                W = U) →
          ∀ W ∈ S, EllipsoidCounterexample.OptimalAmong S W ↔ W ∈ C
@OptimalityReduction.finite_rank_one_refinement : ∀ {α : Type u_1} {β : Type u_2} [inst : AddCommMonoid β]
  (rank : α → ℕ) (image : α → β) (Positive : β → Prop),
  Positive 0 →
    (∀ (x y : β), Positive x → Positive y → Positive (x + y)) →
      (∀ (q : α), rank q = 0 → Positive (image q)) →
        (∀ (q : α), 2 ≤ rank q → ∃ r, OptimalityReduction.RankStep rank image Positive q r) →
          ∀ (q : α),
            ¬Positive (image q) →
              ∃ r p k,
                rank r = 1 ∧
                  Positive p ∧
                    image q = image r + p ∧
                      OptimalityReduction.ReductionChain (OptimalityReduction.RankStep rank image Positive) q r k ∧
                        k + 1 ≤ rank q
