/-!
Scalar consequences of the sharp centre/marginal envelope.
These statements make NO quantum-state claim: the analytic reduction from a
density matrix to this envelope is proved in the accompanying report.
All variables, hypotheses and conclusions below are explicit real arithmetic.
-/
set_option autoImplicit false
noncomputable section
namespace MilneRefinement

def envelope (c b : ℝ) : ℝ :=
  (Real.sqrt (1+b) + Real.sqrt (1-c) * Real.sqrt (1-b))^2 / 4

def defect (c b : ℝ) : ℝ :=
  (Real.sqrt (1-b) - Real.sqrt (1-c) * Real.sqrt (1+b))^2 / 4

theorem deficit_identity (c b : ℝ) (hc : c ≤ 1) (hb0 : -1 ≤ b) (hb1 : b ≤ 1) :
    1 - c/2 - envelope c b = defect c b := by
  have h0 := Real.sq_sqrt (show 0 ≤ 1-c by linarith)
  have h1 := Real.sq_sqrt (show 0 ≤ 1+b by linarith)
  have h2 := Real.sq_sqrt (show 0 ≤ 1-b by linarith)
  unfold envelope defect
  nlinarith [h0, h1, h2, mul_self_nonneg (Real.sqrt (1-c))]

theorem envelope_le_milne (c b : ℝ) (hc : c ≤ 1) (hb0 : -1 ≤ b) (hb1 : b ≤ 1) :
    envelope c b ≤ 1 - c/2 := by
  have hid := deficit_identity c b hc hb0 hb1
  have hnn : 0 ≤ defect c b := by unfold defect; positivity
  linarith

theorem deficit_zero_iff (c b : ℝ) (hc : c ≤ 1) (hb0 : -1 ≤ b) (hb1 : b ≤ 1) :
    defect c b = 0 ↔ (2-c)*b = c := by
  have h0 := Real.sq_sqrt (show 0 ≤ 1-c by linarith)
  have h1 := Real.sq_sqrt (show 0 ≤ 1+b by linarith)
  have h2 := Real.sq_sqrt (show 0 ≤ 1-b by linarith)
  have hs0 := Real.sqrt_nonneg (1-c)
  have hs1 := Real.sqrt_nonneg (1+b)
  have hs2 := Real.sqrt_nonneg (1-b)
  have hp : 0 ≤ Real.sqrt (1-c) * Real.sqrt (1+b) := mul_nonneg hs0 hs1
  constructor
  · intro h
    have he : Real.sqrt (1-b) = Real.sqrt (1-c) * Real.sqrt (1+b) := by
      unfold defect at h
      nlinarith [sq_nonneg (Real.sqrt (1-b) - Real.sqrt (1-c) * Real.sqrt (1+b))]
    nlinarith [he, h0, h1, h2]
  · intro h
    have he : Real.sqrt (1-b) = Real.sqrt (1-c) * Real.sqrt (1+b) := by
      nlinarith [h0, h1, h2, sq_nonneg (Real.sqrt (1-b) - Real.sqrt (1-c) * Real.sqrt (1+b))]
    simp [defect, he]

theorem unique_marginal_at_milne (c b : ℝ) (hc : c ≤ 1)
    (hb0 : -1 ≤ b) (hb1 : b ≤ 1) :
    envelope c b = 1-c/2 ↔ b = c/(2-c) := by
  have hd : 0 < 2-c := by linarith
  have hid := deficit_identity c b hc hb0 hb1
  have hz := deficit_zero_iff c b hc hb0 hb1
  constructor
  · intro h
    have he : (2-c)*b = c := hz.mp (by linarith)
    apply (eq_div_iff (ne_of_gt hd)).mpr
    nlinarith
  · intro h
    have he : (2-c)*b = c := by
      have hx := (eq_div_iff (ne_of_gt hd)).mp h
      nlinarith
    have hzero := hz.mpr he
    linarith

theorem deficit_square_stability (c b : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    ((2-c)*b-c)^2 ≤ 8*(2-c)*defect c b := by
  have h0 := Real.sq_sqrt (show 0 ≤ 1-c by linarith)
  have h1 := Real.sq_sqrt (show 0 ≤ 1+b by linarith)
  have h2 := Real.sq_sqrt (show 0 ≤ 1-b by linarith)
  let u := Real.sqrt (1-b)
  let v := Real.sqrt (1-c) * Real.sqrt (1+b)
  have huv : u^2-v^2 = c-(2-c)*b := by
    dsimp [u,v]
    nlinarith [h0,h1,h2]
  have hsum : (u+v)^2 ≤ 2*(2-c) := by
    dsimp [u,v]
    nlinarith [sq_nonneg (Real.sqrt (1+b) - Real.sqrt (1-c)*Real.sqrt (1-b)),h0,h1,h2]
  have hmul := mul_le_mul_of_nonneg_right hsum (sq_nonneg (u-v))
  have hid : ((2-c)*b-c)^2 = (u+v)^2*(u-v)^2 := by nlinarith [sq_nonneg ((2-c)*b-c),huv]
  change ((2-c)*b-c)^2 ≤ 8*(2-c)*((u-v)^2/4)
  nlinarith [hmul,hid]

theorem near_saturation_controls_marginal (c b f eps : ℝ)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1)
    (hf : f ≤ envelope c b) (hnear : 1-c/2-f ≤ eps) :
    ((2-c)*b-c)^2 ≤ 8*(2-c)*eps := by
  have hid := deficit_identity c b hc1 (by linarith) hb1
  have hstab := deficit_square_stability c b hc0 hc1 hb0 hb1
  have hde : defect c b ≤ eps := by linarith
  have hscale : 0 ≤ 8*(2-c) := by linarith
  nlinarith [mul_le_mul_of_nonneg_left hde hscale]

#print axioms deficit_identity
#print axioms envelope_le_milne
#print axioms deficit_zero_iff
#print axioms unique_marginal_at_milne
#print axioms deficit_square_stability
#print axioms near_saturation_controls_marginal
end MilneRefinement

