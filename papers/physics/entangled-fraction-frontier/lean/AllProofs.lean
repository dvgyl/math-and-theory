theorem endpoint_frontier_sharp (c : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1) :
    ∃ ρ : Joint, ρ.PosSemidef ∧ trace ρ = 1 ∧
      vlen (centre ρ) = c ∧ vlen (blochB ρ) = 1 ∧ fef ρ = (1+c)/4 := by
  have hp := endpointState_posSemidef c hc0 hc1
  have ht := endpointState_trace c
  have hc := endpointState_centre c hc0
