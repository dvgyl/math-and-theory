/-!
# Actual-state stability and marginal rigidity

The input is an actual complex two-qubit positive semidefinite trace-one
matrix.  The new frontier theorem, rather than an assumed scalar bound,
supplies the quantum hypothesis needed by the exact deficit identity.
Pure Bob marginals are included via the separately checked endpoint bound.
-/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped ComplexOrder Kronecker
open D5.S3.Quantum.Entanglement.SteeringEllipsoidFullyEntangledFraction
namespace MilneNew.Qubit

/-- The continuous formula remains a valid upper bound at pure Bob marginals,
although the piecewise endpoint theorem is sharper there. -/
theorem fef_continuous_frontier (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1) :
    fef ρ ≤ MilneRefinement.envelope (vlen (centre ρ)) (vlen (blochB ρ)) := by
  by_cases hb : vlen (blochB ρ) = 1
  · have hs := fef_singular_frontier ρ hρ htr hb
    have hc := centre_radius_le_one ρ hρ htr
    have he : MilneRefinement.envelope (vlen (centre ρ)) (vlen (blochB ρ)) = 1/2 := by
      rw [hb]
      norm_num [MilneRefinement.envelope, Real.sq_sqrt]
    rw [he]
    linarith
  · exact fef_frontier_standard ρ hρ htr
      (lt_of_le_of_ne (bob_radius_le_one ρ hρ htr) hb)

/-- Near saturation of Milne's bound forces the actual Bob marginal radius
close to its unique maximizing value. No scalar frontier assumption remains. -/
theorem quantum_marginal_stability (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1)
    (eps : ℝ) (hnear : 1-vlen (centre ρ)/2-fef ρ ≤ eps) :
    ((2-vlen (centre ρ))*vlen (blochB ρ)-vlen (centre ρ))^2 ≤
      8*(2-vlen (centre ρ))*eps := by
  exact MilneRefinement.near_saturation_controls_marginal
    (vlen (centre ρ)) (vlen (blochB ρ)) (fef ρ) eps
    (vlen_nonneg _) (centre_radius_le_one ρ hρ htr)
    (vlen_nonneg _) (bob_radius_le_one ρ hρ htr)
    (fef_continuous_frontier ρ hρ htr) hnear

/-- Every actual state saturating Milne's original inequality has this exact
Bob marginal radius, including both singular endpoints. -/
theorem quantum_saturation_marginal (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1)
    (hsat : fef ρ = 1-vlen (centre ρ)/2) :
    vlen (blochB ρ) = vlen (centre ρ)/(2-vlen (centre ρ)) := by
  have hf := fef_continuous_frontier ρ hρ htr
  have hc := centre_radius_le_one ρ hρ htr
  have hb := bob_radius_le_one ρ hρ htr
  have hb0 : -1 ≤ vlen (blochB ρ) := by linarith [vlen_nonneg (blochB ρ)]
  have hu := MilneRefinement.envelope_le_milne
    (vlen (centre ρ)) (vlen (blochB ρ)) hc hb0 hb
  have he : MilneRefinement.envelope (vlen (centre ρ)) (vlen (blochB ρ)) =
      1-vlen (centre ρ)/2 := by linarith
  exact (MilneRefinement.unique_marginal_at_milne
    (vlen (centre ρ)) (vlen (blochB ρ)) hc hb0 hb).mp he

end MilneNew.Qubit

