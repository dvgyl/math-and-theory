/-!
# Optimal stability coefficient for the Milne deficit

The fixed-centre coefficient is 4 (1 + sqrt (1-c))^2.  The proof first
establishes the exact scalar factorization, then applies the actual-state
frontier.  For every 0 < c <= 1, the explicit density matrix at Bob radius
zero proves that no smaller coefficient works for all states of centre c.
Endpoint optimality at c=0 is proved without a limit theorem: a suitable
strictly positive Bob radius supplies a counterexample to any K<16.
-/

set_option autoImplicit false
noncomputable section

namespace MilneRefinement

def stabilityConstant (c : ℝ) : ℝ :=
  4 * (1 + Real.sqrt (1-c))^2

theorem stabilityConstant_nonneg (c : ℝ) : 0 ≤ stabilityConstant c := by
  unfold stabilityConstant
  positivity

/-- The exact multiplier relating marginal displacement to frontier deficit. -/
theorem stability_factorization (c b : ℝ) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    ((2-c)*b-c)^2 =
      4 * (Real.sqrt (1-b) + Real.sqrt (1-c)*Real.sqrt (1+b))^2 * defect c b := by
  let u := Real.sqrt (1-b)
  let v := Real.sqrt (1-c)*Real.sqrt (1+b)
  have hu : u^2 = 1-b := Real.sq_sqrt (by linarith)
  have hv : v^2 = (1-c)*(1+b) := by
    dsimp [v]
    rw [mul_pow, Real.sq_sqrt (by linarith : (0:ℝ) ≤ 1-c),
      Real.sq_sqrt (by linarith : (0:ℝ) ≤ 1+b)]
  have hdiff : u^2-v^2 = c-(2-c)*b := by rw [hu,hv]; ring
  calc
    ((2-c)*b-c)^2 = (u^2-v^2)^2 := by rw [hdiff]; ring
    _ = (u+v)^2*(u-v)^2 := by ring
    _ = 4 * (Real.sqrt (1-b) + Real.sqrt (1-c)*Real.sqrt (1+b))^2 * defect c b := by
      dsimp [u,v,defect]
      ring

/-- On the physical half interval b>=0, the multiplier is maximized at b=0. -/
theorem stability_multiplier_le (c b : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    (Real.sqrt (1-b) + Real.sqrt (1-c)*Real.sqrt (1+b))^2 ≤
      (1+Real.sqrt (1-c))^2 := by
  have hr := Real.sq_sqrt (show (0:ℝ) ≤ 1-c by linarith)
  have hs := Real.sq_sqrt (show (0:ℝ) ≤ 1-b by linarith)
  have ht := Real.sq_sqrt (show (0:ℝ) ≤ 1+b by linarith)
  have hp : (Real.sqrt (1-b)*Real.sqrt (1+b))^2 = 1-b^2 := by
    rw [mul_pow,hs,ht]
    ring
  have hcross : Real.sqrt (1-b)*Real.sqrt (1+b) ≤ 1 := by
    apply (sq_le_sq₀
      (mul_nonneg (Real.sqrt_nonneg (1-b)) (Real.sqrt_nonneg (1+b)))
      (by norm_num : (0:ℝ) ≤ 1)).mp
    rw [hp]
    nlinarith [sq_nonneg b]
  have hv : (Real.sqrt (1-c)*Real.sqrt (1+b))^2 = (1-c)*(1+b) := by
    rw [mul_pow,hr,ht]
  have hweighted := mul_le_mul_of_nonneg_left hcross (Real.sqrt_nonneg (1-c))
  nlinarith [mul_nonneg hc0 hb0]

theorem optimal_deficit_stability (c b : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    ((2-c)*b-c)^2 ≤ stabilityConstant c * defect c b := by
  rw [stability_factorization c b hc1 hb0 hb1]
  unfold stabilityConstant
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left (stability_multiplier_le c b hc0 hc1 hb0 hb1)
      (by norm_num)) (by unfold defect; positivity)

theorem optimal_near_saturation_controls_marginal (c b f eps : ℝ)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1)
    (hf : f ≤ envelope c b) (hnear : 1-c/2-f ≤ eps) :
    ((2-c)*b-c)^2 ≤ stabilityConstant c * eps := by
  have hid := deficit_identity c b hc1 (by linarith) hb1
  have hde : defect c b ≤ eps := by linarith
  exact (optimal_deficit_stability c b hc0 hc1 hb0 hb1).trans
    (mul_le_mul_of_nonneg_left hde (stabilityConstant_nonneg c))

theorem stability_at_zero (c : ℝ) (hc1 : c ≤ 1) :
    stabilityConstant c * defect c 0 = c^2 := by
  have hr := Real.sq_sqrt (show (0:ℝ) ≤ 1-c by linarith)
  calc
    stabilityConstant c * defect c 0 = (1-(Real.sqrt (1-c))^2)^2 := by
      simp [stabilityConstant,defect]
      ring
    _ = c^2 := by rw [hr]; ring

theorem defect_zero_positive (c : ℝ) (hc0 : 0 < c) (hc1 : c ≤ 1) :
    0 < defect c 0 := by
  have hr := Real.sq_sqrt (show (0:ℝ) ≤ 1-c by linarith)
  have hr0 := Real.sqrt_nonneg (1-c)
  have hr1 : Real.sqrt (1-c) < 1 := by nlinarith
  have hp : 0 < (1-Real.sqrt (1-c))^2 := sq_pos_of_pos (by linarith)
  simpa [defect] using div_pos hp (show (0:ℝ) < 4 by norm_num)

/-- A smaller coefficient fails already for the scalar frontier at b=0. -/
theorem stabilityConstant_le_of_uniform (c K : ℝ) (hc0 : 0 < c) (hc1 : c ≤ 1)
    (hK : ∀ b : ℝ, 0 ≤ b → b < 1 →
      ((2-c)*b-c)^2 ≤ K * defect c b) : stabilityConstant c ≤ K := by
  have h := hK 0 (by norm_num) (by norm_num)
  have h' : c^2 ≤ K * defect c 0 := by simpa using h
  rw [← stability_at_zero c hc1] at h'
  exact (mul_le_mul_iff_of_pos_right (defect_zero_positive c hc0 hc1)).mp h'

theorem defect_centre_zero_positive (b : ℝ) (hb0 : 0 < b) (hb1 : b < 1) :
    0 < defect 0 b := by
  have hnonneg : 0 ≤ defect 0 b := by unfold defect; positivity
  have hne : defect 0 b ≠ 0 := by
    intro he
    have h := (deficit_zero_iff 0 b (by norm_num) (by linarith) hb1.le).mp he
    norm_num at h
    linarith
  exact lt_of_le_of_ne hnonneg (Ne.symm hne)

/-- At zero centre, the multiplier approaches 16 with a quantitative lower bound. -/
theorem stability_multiplier_zero_lower (b : ℝ) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    4-2*b^2 ≤ (Real.sqrt (1-b)+Real.sqrt (1+b))^2 := by
  have hs := Real.sq_sqrt (show (0:ℝ) ≤ 1-b by linarith)
  have ht := Real.sq_sqrt (show (0:ℝ) ≤ 1+b by linarith)
  have hp : (Real.sqrt (1-b)*Real.sqrt (1+b))^2 = 1-b^2 := by
    rw [mul_pow,hs,ht]
    ring
  have hcross0 := mul_nonneg (Real.sqrt_nonneg (1-b)) (Real.sqrt_nonneg (1+b))
  have hcross1 : Real.sqrt (1-b)*Real.sqrt (1+b) ≤ 1 := by
    apply (sq_le_sq₀ hcross0 (by norm_num : (0:ℝ) ≤ 1)).mp
    rw [hp]
    nlinarith [sq_nonneg b]
  have hq := mul_nonneg hcross0 (sub_nonneg.mpr hcross1)
  nlinarith

/-- Zero-centre optimality is witnessed at a sufficiently small positive radius. -/
theorem stabilityConstant_zero_le_of_uniform (K : ℝ)
    (hK : ∀ b : ℝ, 0 ≤ b → b < 1 →
      ((2-0)*b-0)^2 ≤ K * defect 0 b) : stabilityConstant 0 ≤ K := by
  have hpositive : 0 < K := by
    have h := hK (1/2) (by norm_num) (by norm_num)
    have hd := defect_centre_zero_positive (1/2) (by norm_num) (by norm_num)
    norm_num at h
    nlinarith
  have hlocal : ∀ b : ℝ, 0 < b → b < 1 → 16-8*b^2 ≤ K := by
    intro b hb0 hb1
    have h := hK b hb0.le hb1
    rw [stability_factorization 0 b (by norm_num) hb0.le hb1.le] at h
    simp only [sub_zero, Real.sqrt_one, one_mul] at h
    have hdiv := (mul_le_mul_iff_of_pos_right (defect_centre_zero_positive b hb0 hb1)).mp h
    have hlower := stability_multiplier_zero_lower b hb0.le hb1.le
    linarith
  have h16 : 16 ≤ K := by
    by_contra h
    have hK16 : K < 16 := lt_of_not_ge h
    let b := Real.sqrt ((16-K)/16)
    have hb0 : 0 < b := Real.sqrt_pos.mpr (by linarith)
    have hbsq : b^2 = (16-K)/16 := Real.sq_sqrt (by linarith)
    have hb1 : b < 1 := by nlinarith
    have hbound := hlocal b hb0 hb1
    nlinarith
  have hC : stabilityConstant 0 = 16 := by norm_num [stabilityConstant]
  rw [hC]
  exact h16

end MilneRefinement

open Matrix
open scoped ComplexOrder
open D5.S3.Quantum.Entanglement.SteeringEllipsoidFullyEntangledFraction

namespace MilneNew.Qubit

/-- The optimal coefficient applied to every actual two-qubit density matrix. -/
theorem quantum_optimal_marginal_stability (ρ : Joint) (hρ : ρ.PosSemidef)
    (htr : trace ρ = 1) (eps : ℝ)
    (hnear : 1-vlen (centre ρ)/2-fef ρ ≤ eps) :
    ((2-vlen (centre ρ))*vlen (blochB ρ)-vlen (centre ρ))^2 ≤
      MilneRefinement.stabilityConstant (vlen (centre ρ)) * eps := by
  exact MilneRefinement.optimal_near_saturation_controls_marginal
    (vlen (centre ρ)) (vlen (blochB ρ)) (fef ρ) eps
    (vlen_nonneg _) (centre_radius_le_one ρ hρ htr)
    (vlen_nonneg _) (bob_radius_le_one ρ hρ htr)
    (fef_continuous_frontier ρ hρ htr) hnear

/-- Actual density matrices attain the optimal stability coefficient for every c>0. -/
theorem quantum_stability_sharp (c : ℝ) (hc0 : 0 < c) (hc1 : c ≤ 1) :
    ∃ ρ : Joint, ρ.PosSemidef ∧ trace ρ = 1 ∧
      vlen (centre ρ) = c ∧ vlen (blochB ρ) = 0 ∧
      0 < 1-c/2-fef ρ ∧
      c^2 = MilneRefinement.stabilityConstant c * (1-c/2-fef ρ) := by
  obtain ⟨ρ,hρ,htr,hc,hb,hf⟩ := frontier_sharp c 0 hc0.le hc1
    (by norm_num) (by norm_num)
  have hf' : fef ρ = MilneRefinement.envelope c 0 := by
    simpa [frontierStandard,MilneRefinement.envelope] using hf
  have hd : 1-c/2-fef ρ = MilneRefinement.defect c 0 := by
    rw [hf']
    exact MilneRefinement.deficit_identity c 0 hc1 (by norm_num) (by norm_num)
  refine ⟨ρ,hρ,htr,hc,hb,?_,?_⟩
  · rw [hd]
    exact MilneRefinement.defect_zero_positive c hc0 hc1
  · rw [hd]
    exact (MilneRefinement.stability_at_zero c hc1).symm

/-- The coefficient is best among bounds for all actual states of a fixed centre. -/
theorem quantum_stability_coefficient_optimal (c K : ℝ) (hc0 : 0 < c) (hc1 : c ≤ 1)
    (hK : ∀ ρ : Joint, ρ.PosSemidef → trace ρ = 1 → vlen (centre ρ) = c →
      ((2-c)*vlen (blochB ρ)-c)^2 ≤ K * (1-c/2-fef ρ)) :
    MilneRefinement.stabilityConstant c ≤ K := by
  obtain ⟨ρ,hρ,htr,hc,hb,hd,he⟩ := quantum_stability_sharp c hc0 hc1
  have h := hK ρ hρ htr hc
  rw [hb] at h
  have h' : c^2 ≤ K * (1-c/2-fef ρ) := by simpa using h
  rw [he] at h'
  exact (mul_le_mul_iff_of_pos_right hd).mp h'

/-- Optimality also includes c=0, where extremizing states approach b=0. -/
theorem quantum_stability_coefficient_optimal_closed (c K : ℝ)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hK : ∀ ρ : Joint, ρ.PosSemidef → trace ρ = 1 → vlen (centre ρ) = c →
      ((2-c)*vlen (blochB ρ)-c)^2 ≤ K * (1-c/2-fef ρ)) :
    MilneRefinement.stabilityConstant c ≤ K := by
  by_cases hc : c=0
  · subst c
    apply MilneRefinement.stabilityConstant_zero_le_of_uniform K
    intro b hb0 hb1
    obtain ⟨ρ,hρ,htr,hcentre,hbob,hf⟩ := frontier_sharp 0 b
      (by norm_num) (by norm_num) hb0 hb1
    have hd : 1-(0:ℝ)/2-fef ρ = MilneRefinement.defect 0 b := by
      rw [hf]
      exact MilneRefinement.deficit_identity 0 b (by norm_num) (by linarith) hb1.le
    have h := hK ρ hρ htr hcentre
    rw [hbob,hd] at h
    exact h
  · exact quantum_stability_coefficient_optimal c K
      (lt_of_le_of_ne hc0 (Ne.symm hc)) hc1 hK

end MilneNew.Qubit

