/-!
# Exact active-constraint certificates for the centre--purity envelope

These are the three real quadratic optimization steps of the new sharp
two-invariant ellipsoid envelope. The assumptions are explicitly the
specialized spectral constraints. Bravyi's quantum marginal theorem is
not postulated here and is not formalized by this file.
-/

set_option autoImplicit false
namespace MilneExpanded.PurityCertificates

theorem phase_one (c l u v w : ℝ)
    (hsum : l + u + v + w = 1)
    (hsmall : v + w ≤ (1-c)/2)
    (hgap : c/2 ≤ u-w)
    (hlow : (1+c)/4 ≤ l)
    (hhigh : l ≤ (2+3*c)/8) :
    (1+c^2)/4 + 4*(l-(1+c)/4)^2 ≤ l^2+u^2+v^2+w^2 := by
  let U := u-(1/2-l+c/2)
  let V := v-(l-c/2)
  let W := w-(1/2-l)
  let d := 2*l-c/2-1/2
  have hU : 0 ≤ U := by dsimp [U]; linarith
  have hUV : 0 ≤ 2*U+V := by dsimp [U,V]; linarith
  have hd : 0 ≤ d := by dsimp [d]; linarith
  have he : 0 ≤ c/2-2*d := by dsimp [d]; linarith
  have hp := mul_nonneg hd hUV
  have hq := mul_nonneg he hU
  have hU2 := sq_nonneg U
  have hV2 := sq_nonneg V
  have hW2 := sq_nonneg W
  dsimp [U,V,W,d] at hp hq hU2 hV2 hW2
  nlinarith

theorem phase_two (c l u v w : ℝ)
    (hc : 0 ≤ c) (hsum : l+u+v+w=1) (hgap : c/2 ≤ u-w) :
    l^2+(1-l)^2/3+c^2/8 ≤ l^2+u^2+v^2+w^2 := by
  let r := (1-l)/3
  let U := u-(r+c/4)
  let V := v-r
  let W := w-(r-c/4)
  have hd : 0 ≤ U-W := by dsimp [U,W]; linarith
  have hp := mul_nonneg hc hd
  have hU2 := sq_nonneg U
  have hV2 := sq_nonneg V
  have hW2 := sq_nonneg W
  dsimp [U,V,W,r] at hp hU2 hV2 hW2
  nlinarith

theorem phase_three (c l u v w : ℝ)
    (hc : 0 ≤ c) (hsum : l+u+v+w=1) (hw : 0 ≤ w)
    (hgap : c/2 ≤ u-w) (hl : 1-3*c/4 ≤ l) :
    l^2+c^2/4+(1-l-c/2)^2 ≤ l^2+u^2+v^2+w^2 := by
  let U := u-c/2
  let V := v-(1-l-c/2)
  have hUW : 0 ≤ U-w := by dsimp [U]; linarith
  have hcoef1 : 0 ≤ c/2-(1-l-c/2) := by linarith
  have hcoef2 : 0 ≤ c/2-2*(1-l-c/2) := by linarith
  have hp := mul_nonneg hcoef1 hUW
  have hq := mul_nonneg hcoef2 hw
  have hU2 := sq_nonneg U
  have hV2 := sq_nonneg V
  have hw2 := sq_nonneg w
  dsimp [U,V] at hp hU2 hV2
  nlinarith

theorem phase_one_attains (c l : ℝ) :
    l^2+(1/2-l+c/2)^2+(l-c/2)^2+(1/2-l)^2 =
      (1+c^2)/4+4*(l-(1+c)/4)^2 := by ring

theorem phase_two_attains (c l : ℝ) :
    l^2+((1-l)/3+c/4)^2+((1-l)/3)^2+((1-l)/3-c/4)^2 =
      l^2+(1-l)^2/3+c^2/8 := by ring

theorem phase_three_attains (c l : ℝ) :
    l^2+(c/2)^2+(1-l-c/2)^2 =
      l^2+c^2/4+(1-l-c/2)^2 := by ring

end MilneExpanded.PurityCertificates

