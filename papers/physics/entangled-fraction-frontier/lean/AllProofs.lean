        sharpState_blochB c b hc1 hb0 hb1.le, h2] using hk
  rw [he, vlen_e3, abs_of_nonneg hc0]

theorem sharpState_bell (c b : ℝ) :
    (star bell ⬝ᵥ (sharpState c b *ᵥ bell)).re = frontierStandard c b := by
  have hm : ((1+Complex.I)/2:ℂ) * (starRingEnd ℂ) ((1+Complex.I)/2) = 2⁻¹ := by
    rw [Complex.mul_conj]
    simp [Complex.normSq_apply]
    norm_num
  have he : star bell ⬝ᵥ (sharpState c b *ᵥ bell) =
      (((1+Complex.I)/2:ℂ) * (starRingEnd ℂ) ((1+Complex.I)/2)) *
      (sharpState c b (0,0) (0,0) + sharpState c b (0,0) (1,1) +
        sharpState c b (1,1) (0,0) + sharpState c b (1,1) (1,1)) := by
    simp [dotProduct, mulVec, Fintype.sum_prod_type, Fin.sum_univ_two, bell]
    ring
  rw [he, hm]
  simp [sharpState_entry, sharpVector, ev, frontierStandard]
  ring

/-- Every interior pair is attained by an explicit actual density matrix. -/
theorem frontier_sharp (c b : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hb1 : b < 1) :
    ∃ ρ : Joint, ρ.PosSemidef ∧ trace ρ = 1 ∧
      vlen (centre ρ) = c ∧ vlen (blochB ρ) = b ∧ fef ρ = frontierStandard c b := by
  have hp := sharpState_posSemidef c b hc0 hb1.le
  have ht := sharpState_trace c b hc1 hb0 hb1.le
  have hc := sharpState_centre c b hc0 hc1 hb0 hb1
  have hb : vlen (blochB (sharpState c b)) = b := by
    rw [sharpState_blochB c b hc1 hb0 hb1.le, vlen_e3, abs_of_nonneg hb0]
  have hb' : vlen (blochB (sharpState c b)) < 1 := by rwa [hb]
  refine ⟨sharpState c b,hp,ht,hc,hb,le_antisymm ?_ ?_⟩
  · have hu := fef_frontier_standard (sharpState c b) hp ht hb'
    simpa [hc,hb,frontierStandard] using hu
  · have hbounded : BddAbove {f | ∃ e, IsMaxEntangled e ∧
        f = (star e ⬝ᵥ (sharpState c b *ᵥ e)).re} :=
      ⟨frontier (vlen (centre (sharpState c b))) (vlen (blochB (sharpState c b))),
        fun _ ⟨e,he,hf⟩ => hf ▸ maxent_frontier _ hp ht hb' e he⟩
    rw [← sharpState_bell c b]
    exact le_csSup hbounded ⟨bell,bell_maxent,rfl⟩


/-- The endpoint family has a pure Bob marginal and Alice radius exactly c. -/
def endpointVector0 (k : Fin 2 × Fin 2) : ℂ := if k=(0,0) then 1 else 0

def endpointVector1 (k : Fin 2 × Fin 2) : ℂ := if k=(1,0) then 1 else 0

def endpointState (c : ℝ) : Joint :=
  ((1+c)/2 : ℝ) • pure endpointVector0 +
    ((1-c)/2 : ℝ) • pure endpointVector1

theorem endpointState_posSemidef (c : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1) :
    (endpointState c).PosSemidef :=
  ((posSemidef_vecMulVec_self_star _).smul (show (0:ℝ) ≤ (1+c)/2 by linarith)).add
