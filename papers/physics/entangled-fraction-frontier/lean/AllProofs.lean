/-!
Actual-matrix structural components for the expanded research:
* complementary residuals around an invertible target have total rank ≤ d;
* the resulting low-dimensional residual rank alternative;
* no local-sum dual slack can annihilate a diagonal coherent vector at a
  missing coordinate where a full-Schmidt target has nonzero overlap.

The global SDP attainment, optimal-face reconstruction and sparse transport
existence arguments are written proofs in the report. This module does not
present those remaining arguments as hypotheses named after their conclusions.
-/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped Kronecker
namespace MilneExpanded.Structure

/-- The actual square-matrix rank step behind the full-Schmidt optimizer rank bound. -/
theorem residual_rank_sum_le_dimension {d : ℕ}
    (A B X : Matrix (Fin d) (Fin d) ℂ)
    (hX : IsUnit X.det) (hzero : A * X * B = 0) :
    A.rank + B.rank ≤ d := by
  have h := Matrix.rank_add_rank_le_card_of_mul_eq_zero hzero
  rw [Matrix.rank_mul_eq_left_of_isUnit_det X A hX, Fintype.card_fin] at h
  exact h

/-- The product-support rank estimate, with no subtraction on natural numbers. -/
theorem residual_product_rank_cap {d : ℕ}
    (A B X : Matrix (Fin d) (Fin d) ℂ)
    (hX : IsUnit X.det) (hzero : A * X * B = 0) :
    4 * (A.rank * B.rank) ≤ d^2 := by
  have h := residual_rank_sum_le_dimension A B X hX hzero
  have hz : (A.rank : ℤ) + (B.rank : ℤ) ≤ (d : ℤ) := by exact_mod_cast h
  have ha : (0 : ℤ) ≤ A.rank := by positivity
  have hb : (0 : ℤ) ≤ B.rank := by positivity
  have hd : (0 : ℤ) ≤ d := by positivity
  have hs : 4 * ((A.rank : ℤ) * (B.rank : ℤ)) ≤ (d : ℤ)^2 := by
    nlinarith [sq_nonneg ((A.rank : ℤ)-(B.rank : ℤ))]
  exact_mod_cast hs

/-- Nonzero complementary residuals in dimensions two or three have a one-dimensional side. -/
theorem residual_one_dimensional_side {d : ℕ}
    (A B X : Matrix (Fin d) (Fin d) ℂ)
    (hX : IsUnit X.det) (hzero : A * X * B = 0)
    (hd : d ≤ 3) (ha : 0 < A.rank) (hb : 0 < B.rank) :
    A.rank = 1 ∨ B.rank = 1 := by
  have h := residual_rank_sum_le_dimension A B X hX hzero
  omega

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def diagonalVector (z : ι → ℂ) : ι × ι → ℂ :=
  fun ij => if ij.1 = ij.2 then z ij.1 else 0

/-- At a diagonal coordinate, local operators see only that coherent coefficient. -/
theorem local_sum_diagonal_coordinate (A B : Matrix ι ι ℂ) (z : ι → ℂ) (i : ι) :
    (((A ⊗ₖ (1 : Matrix ι ι ℂ)) + ((1 : Matrix ι ι ℂ) ⊗ₖ B)) *ᵥ
      diagonalVector z) (i,i) = (A i i+B i i)*z i := by
  classical
  simp [Matrix.mulVec, dotProduct, diagonalVector,
    Fintype.sum_prod_type, Matrix.kroneckerMap_apply, Matrix.one_apply,
    Matrix.add_apply, Finset.sum_add_distrib, add_mul]

theorem outer_mulVec_coordinate (x z : ι × ι → ℂ) (i : ι × ι) :
    (vecMulVec x (star x) *ᵥ z) i = x i * (star x ⬝ᵥ z) := by
  simp [Matrix.mulVec, dotProduct, vecMulVec, Finset.mul_sum, mul_assoc]

/-- A missing coherent coefficient obstructs a zero dual-slack vector.
This identity holds for all local matrices, without any Hermiticity assumption. -/
theorem local_dual_missing_coordinate (A B : Matrix ι ι ℂ)
    (z : ι → ℂ) (x : ι × ι → ℂ) (i : ι) (hz : z i = 0) :
    ((((A ⊗ₖ (1 : Matrix ι ι ℂ)) + ((1 : Matrix ι ι ℂ) ⊗ₖ B)) -
      vecMulVec x (star x)) *ᵥ diagonalVector z) (i,i) =
      -(x (i,i) * (star x ⬝ᵥ diagonalVector z)) := by
  rw [Matrix.sub_mulVec, Pi.sub_apply, local_sum_diagonal_coordinate,
    outer_mulVec_coordinate, hz, mul_zero, zero_sub]

/-- The exact algebraic obstruction used by the singular dual nonattainment proof. -/
theorem local_dual_cannot_annihilate (A B : Matrix ι ι ℂ)
    (z : ι → ℂ) (x : ι × ι → ℂ) (i : ι)
    (hz : z i = 0) (hx : x (i,i) ≠ 0)
    (hov : star x ⬝ᵥ diagonalVector z ≠ 0) :
    ((((A ⊗ₖ (1 : Matrix ι ι ℂ)) + ((1 : Matrix ι ι ℂ) ⊗ₖ B)) -
      vecMulVec x (star x)) *ᵥ diagonalVector z) ≠ 0 := by
  intro h
  have he := congrFun h (i,i)
  rw [local_dual_missing_coordinate A B z x i hz] at he
  have hp : x (i,i) * (star x ⬝ᵥ diagonalVector z) ≠ 0 := mul_ne_zero hx hov
  exact (neg_ne_zero.mpr hp) he

