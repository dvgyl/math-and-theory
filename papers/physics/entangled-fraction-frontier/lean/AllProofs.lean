/-!
Exact optimization of the sharp qubit envelope under a success-probability
constraint. This file is scalar analysis; the matrix/Kraus interpretation is
stated and proved separately in the report. No quantum bound is postulated
as an axiom.
-/
set_option autoImplicit false
noncomputable section
namespace MilneRefinement

/-- The sharp envelope increases up to its unique maximizing marginal.
The endpoint condition avoids division and includes c=0 and c=1. -/
theorem envelope_monotone_before_peak (c b B : ℝ)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hbB : b ≤ B) (hB1 : B ≤ 1)
    (hpeak : (2-c)*B ≤ c) :
    envelope c b ≤ envelope c B := by
  let x := Real.sqrt (1+b)
  let y := Real.sqrt (1-b)
  let X := Real.sqrt (1+B)
  let Y := Real.sqrt (1-B)
  let s := Real.sqrt (1-c)
  have hb1 : b ≤ 1 := hbB.trans hB1
  have hB0 : 0 ≤ B := hb0.trans hbB
  have hx0 : 0 ≤ x := Real.sqrt_nonneg _
  have hy0 : 0 ≤ y := Real.sqrt_nonneg _
  have hX0 : 0 ≤ X := Real.sqrt_nonneg _
  have hY0 : 0 ≤ Y := Real.sqrt_nonneg _
  have hs0 : 0 ≤ s := Real.sqrt_nonneg _
  have hx2 : x^2 = 1+b := Real.sq_sqrt (by linarith)
  have hy2 : y^2 = 1-b := Real.sq_sqrt (by linarith)
  have hX2 : X^2 = 1+B := Real.sq_sqrt (by linarith)
  have hY2 : Y^2 = 1-B := Real.sq_sqrt (by linarith)
  have hs2 : s^2 = 1-c := Real.sq_sqrt (by linarith)
  have hxX : x ≤ X := Real.sqrt_le_sqrt (by linarith)
  have hYy : Y ≤ y := Real.sqrt_le_sqrt (by linarith)
  have hsX : s*X ≤ Y := by
    have hprod : (s*X)^2 = (1-c)*(1+B) := by
      rw [mul_pow, hs2, hX2]
    nlinarith [mul_nonneg hs0 hX0]
  have hfactor : 0 ≤ y+Y-s*(X+x) := by
    nlinarith [mul_le_mul_of_nonneg_left hxX hs0]
  have hnonneg : 0 ≤ (y-Y)*(y+Y-s*(X+x)) :=
    mul_nonneg (sub_nonneg.mpr hYy) hfactor
  have hid : (X-x-s*(y-Y))*(X+x) =
      (y-Y)*(y+Y-s*(X+x)) := by nlinarith [hx2,hy2,hX2,hY2]
  have hpos : 0 < X+x := by nlinarith [hx2]
  have hinc : x+s*y ≤ X+s*Y := by
    have hmul : 0 ≤ (X-x-s*(y-Y))*(X+x) := by rw [hid]; exact hnonneg
    have : 0 ≤ X-x-s*(y-Y) := (mul_nonneg_iff_of_pos_right hpos).mp hmul
    linarith
  change (x+s*y)^2/4 ≤ (X+s*Y)^2/4
  nlinarith [mul_nonneg hs0 hy0, mul_nonneg hs0 hY0]

/-- Every feasible Bob length is below the success-constrained endpoint. -/
theorem success_implies_marginal_cap (q b : ℝ) (hq : 0 < q)
    (hsuccess : q*(1+b) ≤ 1) : b ≤ (1-q)/q := by
  apply (le_div_iff₀ hq).mpr
  nlinarith

/-- High required success forces operation before the unconstrained peak. -/
theorem success_cap_before_peak (c q : ℝ) (hc : c ≤ 1)
    (hq : 0 < q) (hhigh : 1-c/2 ≤ q) :
    (2-c)*((1-q)/q) ≤ c := by
  have h : (2-c)*(1-q) ≤ c*q := by nlinarith
  simpa [mul_div_assoc] using (div_le_iff₀ hq).mpr h

/-- The exact scalar upper bound at high required success probability. -/
theorem high_success_envelope_bound (c q b : ℝ)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hq0 : 0 < q) (hq1 : q ≤ 1) (hhigh : 1-c/2 ≤ q)
    (hb0 : 0 ≤ b) (hsuccess : q*(1+b) ≤ 1) :
    envelope c b ≤ envelope c ((1-q)/q) := by
  have hcap := success_implies_marginal_cap q b hq0 hsuccess
  have hB1 : (1-q)/q ≤ 1 := (div_le_iff₀ hq0).mpr (by nlinarith)
  apply envelope_monotone_before_peak c b ((1-q)/q) hc0 hc1 hb0 hcap hB1
  have h : (2-c)*(1-q) ≤ c*q := by nlinarith
  simpa [mul_div_assoc] using (div_le_iff₀ hq0).mpr h

#print axioms envelope_monotone_before_peak
#print axioms success_implies_marginal_cap
#print axioms success_cap_before_peak
#print axioms high_success_envelope_bound
