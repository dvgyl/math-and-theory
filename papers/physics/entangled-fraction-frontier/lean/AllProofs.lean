/-!
# Partial traces and exact positive completion

This module uses the actual finite complex matrices and partial traces in
the audited prerequisite file.  It proves that a rank-one operator can be
completed to prescribed marginals exactly when both marginal differences
are positive.  No existence or positivity claim is assumed as an axiom.
-/

set_option autoImplicit false
noncomputable section
open Matrix
open scoped ComplexOrder Kronecker
open D5.S3.Quantum.Information.PartialTraceMutualInformation
open D5.S3.Quantum.Divergence.ConditionalHockeyStickOrthogonalReduction

namespace MilneExpanded

variable {a b : Type*} [Fintype a] [Fintype b] [DecidableEq a] [DecidableEq b]

theorem partialTraceRight_sub (M N : Matrix (a × b) (a × b) ℂ) :
    partialTraceRight (M - N) = partialTraceRight M - partialTraceRight N := by
  ext i j
  simp [partialTraceRight, Finset.sum_sub_distrib]

theorem partialTraceLeft_sub (M N : Matrix (a × b) (a × b) ℂ) :
    partialTraceLeft (M - N) = partialTraceLeft M - partialTraceLeft N := by
  ext i j
  simp [partialTraceLeft, Finset.sum_sub_distrib]

theorem partialTraceLeft_smul (z : ℂ) (M : Matrix (a × b) (a × b) ℂ) :
    partialTraceLeft (z • M) = z • partialTraceLeft M := by
  ext i j
  simp [partialTraceLeft, Finset.mul_sum]

def outer (w : a × b → ℂ) : Matrix (a × b) (a × b) ℂ :=
  vecMulVec w (star w)

def Compatible (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (M : Matrix (a × b) (a × b) ℂ) : Prop :=
  M.PosSemidef ∧ partialTraceRight M = A ∧ partialTraceLeft M = B

def Admissible (A : Matrix a a ℂ) (B : Matrix b b ℂ) (w : a × b → ℂ) : Prop :=
  (A - partialTraceRight (outer w)).PosSemidef ∧
  (B - partialTraceLeft (outer w)).PosSemidef

theorem outer_posSemidef (w : a × b → ℂ) : (outer w).PosSemidef :=
  posSemidef_vecMulVec_self_star w

theorem psd_trace_real {n : Type*} [Fintype n] {M : Matrix n n ℂ}
    (h : M.PosSemidef) : M.trace = (M.trace.re : ℂ) := by
  have him := (Complex.nonneg_iff.mp h.trace_nonneg).2
  apply Complex.ext <;> simp [him]

/-- Constructive completion, including zero residual trace and singular marginals. -/
theorem admissible_completion (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1) (w : a × b → ℂ)
    (hw : Admissible A B w) :
    ∃ M : Matrix (a × b) (a × b) ℂ,
      Compatible A B M ∧ (M - outer w).PosSemidef := by
  let RA := A - partialTraceRight (outer w)
  let RB := B - partialTraceLeft (outer w)
  have hpA : RA.PosSemidef := hw.1
  have hpB : RB.PosSemidef := hw.2
  have htr : RA.trace = RB.trace := by
    simp [RA, RB, trace_partialTraceRight, trace_partialTraceLeft, hA, hB]
  let δ : ℝ := RA.trace.re
  have hδ : 0 ≤ δ := (Complex.nonneg_iff.mp hpA.trace_nonneg).1
  have hRA : RA.trace = (δ : ℂ) := psd_trace_real hpA
  have hRB : RB.trace = (δ : ℂ) := htr.symm.trans hRA
  by_cases hz : δ = 0
  · have hzeroA : RA = 0 := hpA.trace_eq_zero_iff.mp (by simpa [hz] using hRA)
    have hzeroB : RB = 0 := hpB.trace_eq_zero_iff.mp (by simpa [hz] using hRB)
    refine ⟨outer w, ⟨outer_posSemidef w, ?_, ?_⟩, ?_⟩
    · exact (sub_eq_zero.mp hzeroA).symm
    · exact (sub_eq_zero.mp hzeroB).symm
    · simpa using (Matrix.PosSemidef.zero :
        (0 : Matrix (a × b) (a × b) ℂ).PosSemidef)
  · have hδp : 0 < δ := lt_of_le_of_ne hδ (Ne.symm hz)
    let R : Matrix (a × b) (a × b) ℂ := ((δ⁻¹ : ℝ) : ℂ) • (RA ⊗ₖ RB)
    have hpR : R.PosSemidef :=
      (hpA.kronecker hpB).smul (Complex.zero_le_real.mpr (inv_nonneg.mpr hδ))
    have hscale : ((δ⁻¹ : ℝ) : ℂ) * (δ : ℂ) = 1 := by
      norm_cast
      exact inv_mul_cancel₀ hz
    have hRight : partialTraceRight R = RA := by
      change partialTraceRight (((δ⁻¹ : ℝ) : ℂ) • Matrix.kronecker RA RB) = RA
      rw [partialTraceRight_smul, partialTraceRight_kronecker, hRB, smul_smul,
        hscale, one_smul]
    have hLeft : partialTraceLeft R = RB := by
      change partialTraceLeft (((δ⁻¹ : ℝ) : ℂ) • Matrix.kronecker RA RB) = RB
      rw [partialTraceLeft_smul, partialTraceLeft_kronecker, hRA, smul_smul,
        hscale, one_smul]
    refine ⟨outer w + R, ⟨(outer_posSemidef w).add hpR, ?_, ?_⟩, ?_⟩
    · rw [partialTraceRight_add, hRight]
      dsimp [RA]
      abel
    · rw [partialTraceLeft_add, hLeft]
      dsimp [RB]
      abel
    · convert hpR using 1 <;> abel

/-- Conversely, actual positive rank-one subtraction forces the two marginal caps. -/
theorem admissible_of_completion (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (M : Matrix (a × b) (a × b) ℂ) (w : a × b → ℂ)
    (hM : Compatible A B M) (hsub : (M - outer w).PosSemidef) :
    Admissible A B w := by
  constructor
  · simpa [partialTraceRight_sub, hM.2.1] using partialTraceRight_posSemidef hsub
  · simpa [partialTraceLeft_sub, hM.2.2] using partialTraceLeft_posSemidef hsub

theorem admissible_iff_completion (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1) (w : a × b → ℂ) :
    Admissible A B w ↔ ∃ M, Compatible A B M ∧ (M - outer w).PosSemidef := by
  constructor
  · exact admissible_completion A B hA hB w
  · rintro ⟨M, hM, hs⟩
    exact admissible_of_completion A B M w hM hs

end MilneExpanded

#print axioms MilneExpanded.admissible_completion
#print axioms MilneExpanded.admissible_iff_completion

end -- explicit closure of the constituent EOF section
end Source_GeneralPartialTrace

