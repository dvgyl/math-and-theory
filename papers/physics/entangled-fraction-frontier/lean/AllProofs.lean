  rw [canonical_bloch]
  funext i
  fin_cases i <;>
    simp [blochVec_zero_eq, blochVec_one_eq, blochVec_two_eq, partialTraceRight,
      Fin.sum_univ_two, endpointState, pure, vecMulVec_apply, Pi.star_apply,
      endpointVector0, endpointVector1] <;> ring

theorem endpointState_blochB (c : ℝ) : blochB (endpointState c) = ![0,0,1] := by
  rw [bob_bloch]
  funext i
  fin_cases i <;>
    simp [blochVec_zero_eq, blochVec_one_eq, blochVec_two_eq, partialTraceLeft,
      Fin.sum_univ_two, endpointState, pure, vecMulVec_apply, Pi.star_apply,
      endpointVector0, endpointVector1] <;> ring

theorem endpointState_centre (c : ℝ) (hc0 : 0 ≤ c) :
    vlen (centre (endpointState c)) = c := by
  have hb : vlen (blochB (endpointState c)) = 1 := by
    rw [endpointState_blochB, vlen_e3]
    norm_num
  rw [centre, if_pos hb, endpointState_blochA, vlen_e3, abs_of_nonneg hc0]

theorem endpointState_bell (c : ℝ) :
    (star bell ⬝ᵥ (endpointState c *ᵥ bell)).re = (1+c)/4 := by
  have hm : ((1+Complex.I)/2:ℂ) * (starRingEnd ℂ) ((1+Complex.I)/2) = 2⁻¹ := by
    rw [Complex.mul_conj]
    simp [Complex.normSq_apply]
