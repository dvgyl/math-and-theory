-- moved to the generated import header

open scoped BigOperators ComplexConjugate ComplexOrder
open Matrix

namespace MilneCoherentMin

noncomputable section
set_option linter.unusedSectionVars false

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def commonMass (a b : ι → ℝ) (i : ι) : ℝ := min (a i) (b i)
def deficit (a b : ι → ℝ) : ℝ := 1 - ∑ i, commonMass a b i
def leftLoss (a b : ι → ℝ) (i : ι) : ℝ := a i - commonMass a b i
def rightLoss (a b : ι → ℝ) (i : ι) : ℝ := b i - commonMass a b i

lemma leftLoss_nonneg (a b : ι → ℝ) (i : ι) : 0 ≤ leftLoss a b i :=
  sub_nonneg.mpr (min_le_left _ _)

lemma rightLoss_nonneg (a b : ι → ℝ) (i : ι) : 0 ≤ rightLoss a b i :=
  sub_nonneg.mpr (min_le_right _ _)

lemma losses_disjoint (a b : ι → ℝ) (i : ι) :
    leftLoss a b i * rightLoss a b i = 0 := by
  unfold leftLoss rightLoss commonMass
  rcases le_total (a i) (b i) with h | h
  · simp [min_eq_left h]
  · simp [min_eq_right h]

lemma sum_leftLoss (a b : ι → ℝ) (ha : ∑ i, a i = 1) :
    ∑ i, leftLoss a b i = deficit a b := by
  simp [leftLoss, deficit, Finset.sum_sub_distrib, ha]

lemma sum_rightLoss (a b : ι → ℝ) (hb : ∑ i, b i = 1) :
    ∑ i, rightLoss a b i = deficit a b := by
  simp [rightLoss, deficit, Finset.sum_sub_distrib, hb]

lemma deficit_nonneg (a b : ι → ℝ) (ha : ∑ i, a i = 1) :
    0 ≤ deficit a b := by
  rw [← sum_leftLoss a b ha]
  exact Finset.sum_nonneg (fun i _ => leftLoss_nonneg a b i)

lemma leftLoss_zero (a b : ι → ℝ) (ha : ∑ i, a i = 1)
    (hzero : deficit a b = 0) (i : ι) : leftLoss a b i = 0 := by
  have hs : ∑ j, leftLoss a b j = 0 := by rw [sum_leftLoss a b ha, hzero]
  exact (Finset.sum_eq_zero_iff_of_nonneg
    (fun j _ => leftLoss_nonneg a b j)).mp hs i (Finset.mem_univ i)

lemma rightLoss_zero (a b : ι → ℝ) (hb : ∑ i, b i = 1)
    (hzero : deficit a b = 0) (i : ι) : rightLoss a b i = 0 := by
  have hs : ∑ j, rightLoss a b j = 0 := by rw [sum_rightLoss a b hb, hzero]
  exact (Finset.sum_eq_zero_iff_of_nonneg
    (fun j _ => rightLoss_nonneg a b j)).mp hs i (Finset.mem_univ i)

def residual (a b : ι → ℝ) (ij : ι × ι) : ℝ :=
  leftLoss a b ij.1 * rightLoss a b ij.2 / deficit a b

lemma residual_nonneg (a b : ι → ℝ) (ha : ∑ i, a i = 1) (ij : ι × ι) :
    0 ≤ residual a b ij :=
  div_nonneg (mul_nonneg (leftLoss_nonneg a b ij.1)
    (rightLoss_nonneg a b ij.2)) (deficit_nonneg a b ha)

lemma residual_diag_zero (a b : ι → ℝ) (i : ι) : residual a b (i,i) = 0 := by
  simp [residual, losses_disjoint]

lemma residual_row (a b : ι → ℝ) (ha : ∑ i, a i = 1)
    (hb : ∑ i, b i = 1) (i : ι) :
    ∑ j, residual a b (i,j) = leftLoss a b i := by
  unfold residual
  simp only
  rw [← Finset.sum_div, ← Finset.mul_sum, sum_rightLoss a b hb]
  by_cases hz : deficit a b = 0
  · simp [hz, leftLoss_zero a b ha hz i]
  · exact mul_div_cancel_right₀ _ hz

lemma residual_col (a b : ι → ℝ) (ha : ∑ i, a i = 1)
    (hb : ∑ i, b i = 1) (j : ι) :
    ∑ i, residual a b (i,j) = rightLoss a b j := by
  unfold residual
  simp only
  rw [← Finset.sum_div, ← Finset.sum_mul, sum_leftLoss a b ha]
  by_cases hz : deficit a b = 0
  · simp [hz, rightLoss_zero a b hb hz j]
  · exact mul_div_cancel_left₀ _ hz

def diagonalVector (m : ι → ℝ) (ij : ι × ι) : ℝ :=
  if ij.1 = ij.2 then Real.sqrt (m ij.1) else 0

def coherentState (a b : ι → ℝ) : Matrix (ι × ι) (ι × ι) ℝ :=
  fun ij kl => diagonalVector (commonMass a b) ij * diagonalVector (commonMass a b) kl
      + if ij = kl then residual a b ij else 0

lemma coherentState_symmetric (a b : ι → ℝ) (ij kl : ι × ι) :
    coherentState a b ij kl = coherentState a b kl ij := by
  by_cases h : ij = kl
  · subst kl; rfl
  · simp [coherentState, h, Ne.symm h, mul_comm]

def partialA (M : Matrix (ι × ι) (ι × ι) ℝ) : Matrix ι ι ℝ :=
  fun i k => ∑ j, M (i,j) (k,j)

def partialB (M : Matrix (ι × ι) (ι × ι) ℝ) : Matrix ι ι ℝ :=
  fun j l => ∑ i, M (i,j) (i,l)

lemma diagonalVector_partialA (m : ι → ℝ) (hm : ∀ i, 0 ≤ m i) (i k : ι) :
    (∑ j, diagonalVector m (i,j) * diagonalVector m (k,j)) =
      if i=k then m i else 0 := by
  by_cases h : i = k
  · subst k
    simp [diagonalVector, ← ite_mul, Real.mul_self_sqrt (hm i)]
  · apply Eq.trans (Finset.sum_eq_zero (fun j _ => ?_))
      (by simp [h])
    by_cases hij : i=j
    · subst j; simp [diagonalVector, h, Ne.symm h]
    · simp [diagonalVector, hij]

lemma diagonalVector_partialB (m : ι → ℝ) (hm : ∀ i, 0 ≤ m i) (j l : ι) :
    (∑ i, diagonalVector m (i,j) * diagonalVector m (i,l)) =
      if j=l then m j else 0 := by
  by_cases h : j = l
  · subst l
    simp [diagonalVector, ← ite_mul, Real.mul_self_sqrt, hm]
  · apply Eq.trans (Finset.sum_eq_zero (fun i _ => ?_))
      (by simp [h])
    by_cases hij : i=j
    · subst i; simp [diagonalVector, h]
    · simp [diagonalVector, hij]

theorem coherentState_partialA (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    partialA (coherentState a b) = Matrix.diagonal a := by
  ext i k
  have hm : ∀ i, 0 ≤ commonMass a b i := fun i => le_min (ha0 i) (hb0 i)
  simp only [partialA, coherentState, Finset.sum_add_distrib]
  rw [diagonalVector_partialA _ hm]
  by_cases h : i = k
  · subst k
    simp [residual_row a b ha hb, leftLoss]
  · simp [h]

theorem coherentState_partialB (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    partialB (coherentState a b) = Matrix.diagonal b := by
  ext j l
  have hm : ∀ i, 0 ≤ commonMass a b i := fun i => le_min (ha0 i) (hb0 i)
  simp only [partialB, coherentState, Finset.sum_add_distrib]
  rw [diagonalVector_partialB _ hm]
  by_cases h : j = l
  · subst l
    simp [residual_col a b ha hb, rightLoss]
  · simp [h]

def quadratic (M : Matrix (ι × ι) (ι × ι) ℝ) (x : ι × ι → ℝ) : ℝ :=
  ∑ i, ∑ j, x i * M i j * x j

lemma coherentState_quadratic (a b : ι → ℝ) (x : ι × ι → ℝ) :
    quadratic (coherentState a b) x =
      (∑ i, x i * diagonalVector (commonMass a b) i)^2
      + ∑ i, residual a b i * (x i)^2 := by
  unfold quadratic coherentState
  simp only [mul_add, add_mul, Finset.sum_add_distrib]
  congr 1
  · rw [pow_two, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring
  · apply Finset.sum_congr rfl
    intro i _
    simp only [mul_ite, mul_zero, ite_mul, zero_mul]
    simp [mul_comm, pow_two, mul_left_comm, mul_assoc]

theorem coherentState_quadratic_nonneg (a b : ι → ℝ)
    (ha : ∑ i, a i = 1) (x : ι × ι → ℝ) :
    0 ≤ quadratic (coherentState a b) x := by
  rw [coherentState_quadratic]
  exact add_nonneg (sq_nonneg _) (Finset.sum_nonneg
    (fun i _ => mul_nonneg (residual_nonneg a b ha i) (sq_nonneg _)))

lemma diagonalVector_inner (p m : ι → ℝ) :
    (∑ i : ι × ι, diagonalVector p i * diagonalVector m i) =
      ∑ i, Real.sqrt (p i) * Real.sqrt (m i) := by
  simp [Fintype.sum_prod_type, diagonalVector, ← ite_mul]

theorem coherentState_target_overlap (a b p : ι → ℝ) :
    quadratic (coherentState a b) (diagonalVector p) =
      (∑ i, Real.sqrt (p i) * Real.sqrt (commonMass a b i))^2 := by
  rw [coherentState_quadratic, diagonalVector_inner]
  suffices h : (∑ ij : ι × ι, residual a b ij * diagonalVector p ij ^ 2) = 0 by
    rw [h, add_zero]
  apply Finset.sum_eq_zero
  intro ij _
  rcases ij with ⟨i,j⟩
  by_cases h : i=j
  · subst j; simp [residual_diag_zero]
  · simp [diagonalVector, h]

theorem coherentState_trace_one (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    Matrix.trace (coherentState a b) = 1 := by
  have h := congrArg Matrix.trace (coherentState_partialA a b ha0 hb0 ha hb)
  simpa [Matrix.trace, Matrix.diag_apply, partialA, Fintype.sum_prod_type, ha] using h

theorem diagonalVector_norm (p : ι → ℝ) (hp0 : ∀ i, 0 ≤ p i)
    (hp : ∑ i, p i = 1) :
    (∑ ij : ι × ι, diagonalVector p ij ^ 2) = 1 := by
  simp [Fintype.sum_prod_type, diagonalVector, Real.sq_sqrt, hp0, hp]

def complexQuadratic (M : Matrix (ι × ι) (ι × ι) ℝ) (x : ι × ι → ℂ) : ℂ :=
  ∑ i, ∑ j, conj (x i) * (M i j : ℂ) * x j

lemma complexQuadratic_re (M : Matrix (ι × ι) (ι × ι) ℝ) (x : ι × ι → ℂ) :
    (complexQuadratic M x).re =
      quadratic M (fun i => (x i).re) + quadratic M (fun i => (x i).im) := by
  unfold complexQuadratic quadratic
  simp only [Complex.re_sum, Complex.mul_re, Complex.mul_im, Complex.conj_re,
    Complex.conj_im, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero,
    zero_mul, zero_add]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem coherentState_complex_quadratic_nonneg (a b : ι → ℝ)
    (ha : ∑ i, a i = 1) (x : ι × ι → ℂ) :
    0 ≤ (complexQuadratic (coherentState a b) x).re := by
  rw [complexQuadratic_re]
  exact add_nonneg (coherentState_quadratic_nonneg a b ha _)
    (coherentState_quadratic_nonneg a b ha _)

theorem coherentState_complex_hermitian (a b : ι → ℝ) (ij kl : ι × ι) :
    conj (coherentState a b ij kl : ℂ) = (coherentState a b kl ij : ℂ) := by
  simp only [Complex.conj_ofReal]
  exact congrArg Complex.ofReal (coherentState_symmetric a b ij kl)

lemma complexQuadratic_ofReal (M : Matrix (ι × ι) (ι × ι) ℝ) (x : ι × ι → ℝ) :
    complexQuadratic M (fun i => (x i : ℂ)) = (quadratic M x : ℂ) := by
  simp [complexQuadratic, quadratic]

theorem coherentState_complex_target_overlap (a b p : ι → ℝ) :
    complexQuadratic (coherentState a b) (fun i => (diagonalVector p i : ℂ)) =
      ((∑ i, Real.sqrt (p i) * Real.sqrt (commonMass a b i))^2 : ℝ) := by
  rw [complexQuadratic_ofReal, coherentState_target_overlap]

/-- This certificate constructs a genuine positive semidefinite, trace-one
matrix over C, specified by real entries; gives both partial traces; and
computes its overlap with a normalized vector having the prescribed Schmidt
amplitudes.  Complex PSD is expressed directly by Hermitian symmetry plus
nonnegativity of every Hermitian quadratic form.  No spectral inequality or
optimization upper bound is assumed in this construction. -/
theorem coherentMin_sharpness_certificate (a b p : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i) (hp0 : ∀ i, 0 ≤ p i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) (hp : ∑ i, p i = 1) :
    (Matrix.trace (coherentState a b) = 1) ∧
    (partialA (coherentState a b) = Matrix.diagonal a) ∧
    (partialB (coherentState a b) = Matrix.diagonal b) ∧
    (∀ ij kl, conj (coherentState a b ij kl : ℂ) = (coherentState a b kl ij : ℂ)) ∧
    (∀ x : ι × ι → ℂ, 0 ≤ (complexQuadratic (coherentState a b) x).re) ∧
    ((∑ ij : ι × ι, diagonalVector p ij ^ 2) = 1) ∧
    (complexQuadratic (coherentState a b) (fun i => (diagonalVector p i : ℂ)) =
      ((∑ i, Real.sqrt (p i) * Real.sqrt (commonMass a b i))^2 : ℝ)) := by
  exact ⟨coherentState_trace_one a b ha0 hb0 ha hb,
    coherentState_partialA a b ha0 hb0 ha hb,
    coherentState_partialB a b ha0 hb0 ha hb,
    coherentState_complex_hermitian a b,
    coherentState_complex_quadratic_nonneg a b ha,
    diagonalVector_norm p hp0 hp,
    coherentState_complex_target_overlap a b p⟩

#print axioms coherentState_partialA
#print axioms coherentState_partialB
#print axioms coherentState_quadratic_nonneg
#print axioms coherentState_target_overlap
#print axioms coherentState_trace_one
#print axioms diagonalVector_norm
#print axioms coherentState_complex_quadratic_nonneg
#print axioms coherentState_complex_hermitian
