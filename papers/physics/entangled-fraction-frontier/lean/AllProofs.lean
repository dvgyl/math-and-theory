theorem qEig_formula {M : Qubit} (hM : M.IsHermitian) :
    qEig hM 0 = ((trace M).re + vlen (blochVec M)) / 2 ∧
    qEig hM 1 = ((trace M).re - vlen (blochVec M)) / 2 := by
  have hs := qEig_sum hM
  have hp := qEig_prod hM
  have ho := qEig_order hM
  have hr := radius_square hM
  have hdiff : (qEig hM 0 - qEig hM 1)^2 = vlen (blochVec M)^2 := by
    calc
