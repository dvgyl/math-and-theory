open Matrix
open scoped ComplexOrder MatrixOrder Kronecker
open D5.S3.Quantum.Information.PartialTraceMutualInformation
open D5.S3.Quantum.Entanglement.SteeringEllipsoidFullyEntangledFraction
namespace MilneNew.Qubit

def sharpVector (c b : ℝ) (k : Fin 2 × Fin 2) : ℝ :=
  ![![Real.sqrt (1+b), 0], ![0, Real.sqrt (1-c)*Real.sqrt (1-b)]] k.1 k.2

def sharpState (c b : ℝ) : Joint :=
  (1/2:ℂ) • (pure (fun k => (sharpVector c b k : ℂ)) +
    (c*(1-b):ℝ) • pure (fun k => (ev k : ℂ)))

theorem sharpState_posSemidef (c b : ℝ) (hc0 : 0 ≤ c) (hb1 : b ≤ 1) :
    (sharpState c b).PosSemidef := by
  have hr : (0:ℝ) ≤ c*(1-b) := mul_nonneg hc0 (by linarith)
  have hR : ((c*(1-b):ℝ) • pure (fun k => (ev k : ℂ))).PosSemidef :=
    (posSemidef_vecMulVec_self_star _).smul hr
  exact ((posSemidef_vecMulVec_self_star _).add hR).smul
    (show (0:ℂ) ≤ 1/2 by norm_num [Complex.le_def])

theorem sharpState_entry (c b : ℝ) (x y : Fin 2 × Fin 2) :
    sharpState c b x y =
      (((sharpVector c b x * sharpVector c b y + c*(1-b)*(ev x*ev y))/2 : ℝ):ℂ) := by
  simp only [sharpState, pure, Matrix.smul_apply, Matrix.add_apply,
    vecMulVec_apply, Pi.star_apply, Complex.star_def, Complex.conj_ofReal,
    smul_eq_mul, Complex.real_smul]
  push_cast
  ring

private theorem sharp_squares (c b : ℝ) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    (Real.sqrt (1+b))^2 = 1+b ∧
      (Real.sqrt (1-c)*Real.sqrt (1-b))^2 = (1-c)*(1-b) := by
  constructor
  · exact Real.sq_sqrt (by linarith)
  · rw [mul_pow, Real.sq_sqrt (by linarith : (0:ℝ) ≤ 1-c),
      Real.sq_sqrt (by linarith : (0:ℝ) ≤ 1-b)]

theorem sharpState_trace (c b : ℝ) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    trace (sharpState c b) = 1 := by
  obtain ⟨hs,ht⟩ := sharp_squares c b hc1 hb0 hb1
  apply Complex.ext
  · simp [Matrix.trace, Matrix.diag, Fintype.sum_prod_type, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
    nlinarith
  · simp [Matrix.trace, Matrix.diag, Fintype.sum_prod_type, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]

theorem sharpState_blochB (c b : ℝ) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    blochB (sharpState c b) = ![0,0,b] := by
  obtain ⟨hs,ht⟩ := sharp_squares c b hc1 hb0 hb1
  rw [bob_bloch]
  funext j
  fin_cases j
  · simp [blochVec_zero_eq, partialTraceLeft, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
  · simp [blochVec_one_eq, partialTraceLeft, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
  · simp [blochVec_two_eq, partialTraceLeft, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
    nlinarith

theorem sharpState_blochA (c b : ℝ) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    blochA (sharpState c b) = ![0,0,c+b-c*b] := by
  obtain ⟨hs,ht⟩ := sharp_squares c b hc1 hb0 hb1
  rw [canonical_bloch]
  funext j
  fin_cases j
  · simp [blochVec_zero_eq, partialTraceRight, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
  · simp [blochVec_one_eq, partialTraceRight, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
  · simp [blochVec_two_eq, partialTraceRight, Fin.sum_univ_two,
      sharpState_entry, sharpVector, ev]
    nlinarith

theorem sharpState_corr (c b : ℝ) (hc1 : c ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    corr (sharpState c b) 0 2 = 0 ∧ corr (sharpState c b) 1 2 = 0 ∧
      corr (sharpState c b) 2 2 = 1-c+c*b := by
  obtain ⟨hs,ht⟩ := sharp_squares c b hc1 hb0 hb1
  refine ⟨?_,?_,?_⟩
  · simp [corr, pauli_zero, pauli_two, Matrix.trace, Matrix.mul_apply,
      Fintype.sum_prod_type, Fin.sum_univ_two, sharpState_entry, sharpVector, ev]
  · simp [corr, pauli_one, pauli_two, Matrix.trace, Matrix.mul_apply,
      Fintype.sum_prod_type, Fin.sum_univ_two, sharpState_entry, sharpVector, ev]
  · simp [corr, pauli_two, Matrix.trace, Matrix.mul_apply,
      Fintype.sum_prod_type, Fin.sum_univ_two, sharpState_entry, sharpVector, ev]
    nlinarith

theorem sharpState_centre (c b : ℝ) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hb0 : 0 ≤ b) (hb1 : b < 1) : vlen (centre (sharpState c b)) = c := by
  have hblen : vlen (blochB (sharpState c b)) = b := by
    rw [sharpState_blochB c b hc1 hb0 hb1.le, vlen_e3, abs_of_nonneg hb0]
  have hbn : vlen (blochB (sharpState c b)) ≠ 1 := by rw [hblen]; exact hb1.ne
  obtain ⟨h0,h1,h2⟩ := sharpState_corr c b hc1 hb0 hb1.le
  have hden : 1-b^2 ≠ 0 := by nlinarith
  have he : centre (sharpState c b) = ![0,0,c] := by
    rw [centre, if_neg hbn, hblen]
    funext i
    fin_cases i
    · simp [Fin.sum_univ_three, sharpState_blochA c b hc1 hb0 hb1.le,
        sharpState_blochB c b hc1 hb0 hb1.le, h0]
    · simp [Fin.sum_univ_three, sharpState_blochA c b hc1 hb0 hb1.le,
        sharpState_blochB c b hc1 hb0 hb1.le, h1]
    · have hk : (c+b-c*b-(1-c+c*b)*b)/(1-b^2) = c := by
        rw [div_eq_iff hden]
        ring
