open Matrix
open scoped ComplexOrder MatrixOrder Kronecker
open D5.S3.Quantum.Information.PartialTraceMutualInformation
open D5.S3.Quantum.Entanglement.SteeringEllipsoidFullyEntangledFraction
namespace MilneNew.Qubit

abbrev Qubit := Matrix (Fin 2) (Fin 2) ℂ
abbrev Joint := Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ

/-- Ordered eigenvalues, with the canonical descending index transported to Fin 2. -/
def qEig {M : Qubit} (hM : M.IsHermitian) (i : Fin 2) : ℝ :=
  hM.eigenvalues₀ (Fin.cast (Fintype.card_fin 2).symm i)

theorem qEig_order {M : Qubit} (hM : M.IsHermitian) : qEig hM 1 ≤ qEig hM 0 :=
  hM.eigenvalues₀_antitone (by decide)

theorem qEig_sum {M : Qubit} (hM : M.IsHermitian) :
    qEig hM 0 + qEig hM 1 = (trace M).re := by
  obtain ⟨U,hU⟩ := MilneExpanded.ordered_spectral_decomposition hM
  change M = (U : Qubit) * diagonal (fun i => (qEig hM i : ℂ)) *
    (U : Qubit)ᴴ at hU
  have hUU : (U : Qubit)ᴴ * (U : Qubit) = 1 :=
    Unitary.star_mul_self_of_mem U.property
  have ht : trace M = (qEig hM 0 : ℂ) + (qEig hM 1 : ℂ) := by
    conv_lhs => rw [hU]
    rw [Matrix.trace_mul_cycle, hUU, Matrix.one_mul,
      Matrix.trace_diagonal, Fin.sum_univ_two]
  have := congrArg Complex.re ht
  simpa using this.symm

theorem qEig_prod {M : Qubit} (hM : M.IsHermitian) :
    qEig hM 0 * qEig hM 1 = (det M).re := by
  obtain ⟨U,hU⟩ := MilneExpanded.ordered_spectral_decomposition hM
  change M = (U : Qubit) * diagonal (fun i => (qEig hM i : ℂ)) *
    (U : Qubit)ᴴ at hU
  have hUU : (U : Qubit) * (U : Qubit)ᴴ = 1 :=
    Unitary.mul_star_self_of_mem U.property
  have hd : det M = (qEig hM 0 : ℂ) * (qEig hM 1 : ℂ) := by
    conv_lhs => rw [hU]
    rw [Matrix.det_mul_right_comm, hUU, Matrix.one_mul,
      Matrix.det_diagonal, Fin.prod_univ_two]
  have := congrArg Complex.re hd
  simpa using this.symm

theorem radius_square {M : Qubit} (hM : M.IsHermitian) :
    vlen (blochVec M) ^ 2 = (trace M).re ^ 2 - 4 * (det M).re := by
  rw [vlen_eq_norm, blochVec_eq_bloch M hM]
  have he : (det M).re = ((trace M).re ^ 2 -
      ‖D5.S3.Quantum.Information.ActualPureQubitCostInfimum.bloch M‖ ^ 2) / 4 := by
    rw [(D5.S3.Quantum.Information.ActualPureQubitCostInfimum.bloch_geometry_of_isHermitian M hM).1]
    rw [D5.S3.Quantum.Information.ActualPureQubitCostInfimum.blochMatrix_trace,
      D5.S3.Quantum.Information.ActualPureQubitCostInfimum.bloch_blochMatrix]
    rw [EuclideanSpace.real_norm_sq_eq]
    simp [D5.S3.Quantum.Information.ActualPureQubitCostInfimum.blochMatrix,
