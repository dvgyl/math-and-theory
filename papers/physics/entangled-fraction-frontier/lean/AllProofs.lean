/-!
# Weighted complex overlap in singular-vector coordinates

The result below proves the triangle, Cauchy--Schwarz, and rearrangement steps
of the von Neumann trace inequality, in all finite dimensions.
-/

open Finset Matrix
open scoped ComplexOrder

namespace MilneSharp

private theorem norm_product_sum_le_one {ι : Type*} [Fintype ι]
    (u v : ι → ℂ) (hu : ∑ i, ‖u i‖ ^ 2 ≤ 1) (hv : ∑ i, ‖v i‖ ^ 2 ≤ 1) :
    ∑ i, ‖u i‖ * ‖v i‖ ≤ 1 := by
  have hcs := sum_mul_sq_le_sq_mul_sq univ (fun i => ‖u i‖) (fun i => ‖v i‖)
  have hp : (∑ i, ‖u i‖ ^ 2) * (∑ i, ‖v i‖ ^ 2) ≤ (1 : ℝ) := by
    simpa using mul_le_mul hu hv (sum_nonneg fun i _ => sq_nonneg ‖v i‖)
      (show (0 : ℝ) ≤ 1 by norm_num)
  nlinarith [sq_nonneg ((∑ i, ‖u i‖ * ‖v i‖) - 1)]

/-- A weighted complex overlap between two arrays whose rows and columns
have squared norm at most one is bounded by the aligned weight pairing. -/
theorem weighted_complex_overlap {n : ℕ} (A B : Matrix (Fin n) (Fin n) ℂ)
    (s w : Fin n → ℝ)
    (hAr : ∀ i, ∑ j, ‖A i j‖ ^ 2 ≤ 1)
    (hAc : ∀ j, ∑ i, ‖A i j‖ ^ 2 ≤ 1)
    (hBr : ∀ i, ∑ j, ‖B i j‖ ^ 2 ≤ 1)
    (hBc : ∀ j, ∑ i, ‖B i j‖ ^ 2 ≤ 1)
    (hs : ∀ i, 0 ≤ s i) (hw : ∀ i, 0 ≤ w i)
    (hsm : Antitone s) (hwm : Antitone w) :
    ‖∑ i, ∑ j, (s i : ℂ) * A i j * (w j : ℂ) * B i j‖ ≤
      ∑ i, s i * w i := by
  let C : Fin n → Fin n → ℝ := fun i j => ‖A i j‖ * ‖B i j‖
  have hC : ∀ i j, 0 ≤ C i j := fun i j => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hrow : ∀ i, ∑ j, C i j ≤ 1 :=
    fun i => norm_product_sum_le_one (A i) (B i) (hAr i) (hBr i)
  have hcol : ∀ j, ∑ i, C i j ≤ 1 :=
    fun j => norm_product_sum_le_one (fun i => A i j) (fun i => B i j) (hAc j) (hBc j)
  calc
    _ ≤ ∑ i, ‖∑ j, (s i : ℂ) * A i j * (w j : ℂ) * B i j‖ := norm_sum_le _ _
    _ ≤ ∑ i, ∑ j, ‖(s i : ℂ) * A i j * (w j : ℂ) * B i j‖ := by
      apply sum_le_sum
      intro i _
      exact norm_sum_le _ _
    _ = ∑ i, ∑ j, s i * C i j * w j := by
      apply sum_congr rfl
      intro i _
      apply sum_congr rfl
      intro j _
      simp only [C, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (hs i), abs_of_nonneg (hw j)]
      ring
    _ ≤ _ := substochastic_rearrangement_fin C s w hC hrow hcol hs hw hsm hwm

private theorem unitary_row_sq_norm {n : ℕ} {U : Matrix (Fin n) (Fin n) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin n) ℂ) (i : Fin n) :
    ∑ j, ‖U i j‖ ^ 2 = 1 := by
  have hdiag : (U * Uᴴ) i i = ((∑ j, ‖U i j‖ ^ 2 : ℝ) : ℂ) := by
    simp only [Matrix.mul_apply, Matrix.conjTranspose_apply, ← starRingEnd_apply,
      RCLike.mul_conj]
    norm_cast
  have hunit : U * Uᴴ = 1 := Unitary.mul_star_self_of_mem hU
  rw [hunit, Matrix.one_apply_eq] at hdiag
  exact_mod_cast hdiag.symm

private theorem unitary_col_sq_norm {n : ℕ} {U : Matrix (Fin n) (Fin n) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin n) ℂ) (j : Fin n) :
    ∑ i, ‖U i j‖ ^ 2 = 1 := by
  have hdiag : (Uᴴ * U) j j = ((∑ i, ‖U i j‖ ^ 2 : ℝ) : ℂ) := by
    simp only [Matrix.mul_apply, Matrix.conjTranspose_apply, ← starRingEnd_apply,
      RCLike.conj_mul]
    norm_cast
  have hunit : Uᴴ * U = 1 := Unitary.star_mul_self_of_mem hU
  rw [hunit, Matrix.one_apply_eq] at hdiag
  exact_mod_cast hdiag.symm

/-- The full weighted von Neumann trace inequality in diagonal-unitary
coordinates, in every finite dimension. No singular-value bound is assumed:
only nonnegative ordered diagonal entries and actual matrix unitarity. -/
theorem weighted_diagonal_unitary_trace {n : ℕ}
    (U V : Matrix (Fin n) (Fin n) ℂ) (s w : Fin n → ℝ)
    (hU : U ∈ Matrix.unitaryGroup (Fin n) ℂ)
    (hV : V ∈ Matrix.unitaryGroup (Fin n) ℂ)
    (hs : ∀ i, 0 ≤ s i) (hw : ∀ i, 0 ≤ w i)
    (hsm : Antitone s) (hwm : Antitone w) :
    ‖Matrix.trace (Matrix.diagonal (fun i => (s i : ℂ)) * U *
        Matrix.diagonal (fun i => (w i : ℂ)) * V)‖ ≤ ∑ i, s i * w i := by
  have hAr : ∀ i, ∑ j, ‖U i j‖ ^ 2 ≤ 1 := fun i => (unitary_row_sq_norm hU i).le
  have hAc : ∀ j, ∑ i, ‖U i j‖ ^ 2 ≤ 1 := fun j => (unitary_col_sq_norm hU j).le
  have hBr : ∀ i, ∑ j, ‖Vᵀ i j‖ ^ 2 ≤ 1 := fun i => (unitary_col_sq_norm hV i).le
  have hBc : ∀ j, ∑ i, ‖Vᵀ i j‖ ^ 2 ≤ 1 := fun j => (unitary_row_sq_norm hV j).le
  have hb := weighted_complex_overlap U Vᵀ s w hAr hAc hBr hBc hs hw hsm hwm
  have he : Matrix.trace (Matrix.diagonal (fun i => (s i : ℂ)) * U *
        Matrix.diagonal (fun i => (w i : ℂ)) * V) =
      ∑ i, ∑ j, (s i : ℂ) * U i j * (w j : ℂ) * Vᵀ i j := by
    simp [Matrix.trace, Matrix.mul_apply, Matrix.diagonal_apply]
  rw [he]
  exact hb

end MilneSharp

