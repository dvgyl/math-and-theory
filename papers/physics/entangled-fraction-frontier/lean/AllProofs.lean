      _ = vlen (blochVec M)^2 := hr.symm
  have hgap : qEig hM 0 - qEig hM 1 = vlen (blochVec M) :=
    (sq_eq_sq₀ (sub_nonneg.mpr ho) (vlen_nonneg _)).mp hdiff
  constructor <;> linarith

