/-!
# Rank-one extraction in arbitrary finite dimension

A positive semidefinite matrix M and a test vector x with t = <x,Mx> > 0
admit the exact rank-one extraction M >= |Mx><Mx|/t. The normalized
w = Mx/sqrt(t) has <x,w> = sqrt(t).

This generic result extends the finite two-qubit extraction used in the
public Milne proof. It is a standard PSD Cauchy--Schwarz lemma; it is included
as the matrix-level foundation for the separately derived weighted Schmidt
bound, without claiming this lemma itself is new.
-/

set_option autoImplicit false
noncomputable section
open Matrix
open scoped ComplexOrder
namespace MilneNew.RankOneExtraction

variable {n : Type*} [Fintype n] [DecidableEq n]

theorem form_conj {M : Matrix n n ℂ} (hM : M.IsHermitian) (x y : n → ℂ) :
    star (star x ⬝ᵥ (M *ᵥ y)) = star y ⬝ᵥ (M *ᵥ x) := by
  rw [← star_dotProduct_star, star_star, star_mulVec, ← dotProduct_mulVec, hM.eq]

theorem form_real {M : Matrix n n ℂ} (hM : M.PosSemidef) (x : n → ℂ) :
    star x ⬝ᵥ (M *ᵥ x) = ((star x ⬝ᵥ (M *ᵥ x)).re : ℂ) := by
  have h := Complex.le_def.mp (hM.dotProduct_mulVec_nonneg x)
  apply Complex.ext <;> simp
  simpa using h.2.symm

theorem psd_cauchy_schwarz {M : Matrix n n ℂ} (hM : M.PosSemidef) (x y : n → ℂ) :
    Complex.normSq (star x ⬝ᵥ (M *ᵥ y)) ≤
      (star x ⬝ᵥ (M *ᵥ x)).re * (star y ⬝ᵥ (M *ᵥ y)).re := by
  let _ := M.toSeminormedAddCommGroup hM
  let _ := M.toInnerProductSpace hM
  have e : ∀ u v : n → ℂ, inner ℂ u v = star u ⬝ᵥ (M *ᵥ v) :=
    fun u v => dotProduct_comm _ _
  have h := inner_mul_inner_self_le (𝕜 := ℂ) x y
  rwa [e, e, e, e, ← form_conj hM.isHermitian x y, norm_star, ← sq,
    ← Complex.normSq_eq_norm_sq] at h

theorem form_vecMulVec (w x : n → ℂ) :
    star x ⬝ᵥ (vecMulVec w (star w) *ᵥ x) =
      (star x ⬝ᵥ w) * (star w ⬝ᵥ x) := by
  simp only [dotProduct, mulVec, vecMulVec_apply, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

/-- Exact PSD rank-one subtraction, with no dimension or normalization assumption. -/
theorem psd_sub_rank_one {M : Matrix n n ℂ} (hM : M.PosSemidef) (x : n → ℂ)
    {t : ℝ} (ht : t = (star x ⬝ᵥ (M *ᵥ x)).re) (hpos : 0 < t) :
    (M - ((t⁻¹ : ℝ) : ℂ) • vecMulVec (M *ᵥ x) (star (M *ᵥ x))).PosSemidef := by
  have hc : (0 : ℂ) ≤ ((t⁻¹ : ℝ) : ℂ) :=
    Complex.zero_le_real.mpr (inv_nonneg.mpr hpos.le)
  have hW := (posSemidef_vecMulVec_self_star (M *ᵥ x)).smul hc
  refine PosSemidef.of_dotProduct_mulVec_nonneg
    (hM.isHermitian.sub hW.isHermitian) fun y => ?_
  rw [sub_mulVec, dotProduct_sub, smul_mulVec, dotProduct_smul,
    form_vecMulVec, smul_eq_mul]
  have hxy : star (M *ᵥ x) ⬝ᵥ y = star (star y ⬝ᵥ (M *ᵥ x)) := by
    rw [form_conj hM.isHermitian, star_mulVec, ← dotProduct_mulVec, hM.isHermitian.eq]
  rw [hxy, form_real hM y, Complex.star_def, Complex.mul_conj]
  have hcs := psd_cauchy_schwarz hM y x
  rw [← ht] at hcs
  rw [Complex.le_def]
  constructor
  · simp only [Complex.zero_re, Complex.sub_re, Complex.ofReal_re, Complex.mul_re,
      Complex.ofReal_im, zero_mul, sub_zero]
    have : t⁻¹ * Complex.normSq (star y ⬝ᵥ (M *ᵥ x)) ≤
        (star y ⬝ᵥ (M *ᵥ y)).re := by
      rw [inv_mul_le_iff₀ hpos]
      linarith
    linarith
  · simp

/-- The unnormalized vector has the exact real overlap t with the test vector. -/
theorem overlap_unnormalized {M : Matrix n n ℂ} (hM : M.PosSemidef) (x : n → ℂ)
    {t : ℝ} (ht : t = (star x ⬝ᵥ (M *ᵥ x)).re) :
    star x ⬝ᵥ (M *ᵥ x) = (t : ℂ) := by
  rw [form_real hM x, ← ht]

/-- The normalized extraction vector has precisely square-root overlap. -/
theorem normalized_overlap {M : Matrix n n ℂ} (hM : M.PosSemidef) (x : n → ℂ)
    {t : ℝ} (ht : t = (star x ⬝ᵥ (M *ᵥ x)).re) (hpos : 0 < t) :
    star x ⬝ᵥ ((((Real.sqrt t)⁻¹ : ℝ) : ℂ) • (M *ᵥ x)) =
      (Real.sqrt t : ℂ) := by
  rw [dotProduct_smul, overlap_unnormalized hM x ht, smul_eq_mul]
  norm_cast
  have hs : Real.sqrt t ≠ 0 := (Real.sqrt_pos.2 hpos).ne'
  rw [inv_mul_eq_iff_eq_mul₀ hs, Real.mul_self_sqrt hpos.le]

/-- The normalized extraction outer product equals the unnormalized one divided by t. -/
theorem normalized_outer (v : n → ℂ) {t : ℝ} (ht : 0 ≤ t) :
    vecMulVec ((((Real.sqrt t)⁻¹ : ℝ) : ℂ) • v)
      (star ((((Real.sqrt t)⁻¹ : ℝ) : ℂ) • v)) =
        ((t⁻¹ : ℝ) : ℂ) • vecMulVec v (star v) := by
  have hs : ((Real.sqrt t)⁻¹ : ℝ) ^ 2 = t⁻¹ := by
    rw [inv_pow, Real.sq_sqrt ht]
  have hc : (((Real.sqrt t)⁻¹ : ℝ) : ℂ) ^ 2 = ((t⁻¹ : ℝ) : ℂ) := by
    exact_mod_cast hs
  ext i j
  simp only [vecMulVec_apply, Pi.smul_apply, Pi.star_apply, Matrix.smul_apply,
    smul_eq_mul, star_mul', Complex.star_def, Complex.conj_ofReal]
  calc
    _ = ((((Real.sqrt t)⁻¹ : ℝ) : ℂ) ^ 2) * (v i * (starRingEnd ℂ) (v j)) := by ring
    _ = _ := by rw [hc]

/-- Existence of a genuine vector w with M >= ww* and <x,w> = sqrt(t). -/
theorem normalized_extraction {M : Matrix n n ℂ} (hM : M.PosSemidef) (x : n → ℂ)
    {t : ℝ} (ht : t = (star x ⬝ᵥ (M *ᵥ x)).re) (hpos : 0 < t) :
    ∃ w : n → ℂ, (M - vecMulVec w (star w)).PosSemidef ∧
      star x ⬝ᵥ w = (Real.sqrt t : ℂ) := by
  refine ⟨(((Real.sqrt t)⁻¹ : ℝ) : ℂ) • (M *ᵥ x), ?_,
    normalized_overlap hM x ht hpos⟩
  rw [normalized_outer _ hpos.le]
  exact psd_sub_rank_one hM x ht hpos

/-- Matrix and overlap parts together; the core variational extraction certificate. -/
theorem extraction {M : Matrix n n ℂ} (hM : M.PosSemidef) (x : n → ℂ)
    {t : ℝ} (ht : t = (star x ⬝ᵥ (M *ᵥ x)).re) (hpos : 0 < t) :
    (M - ((t⁻¹ : ℝ) : ℂ) • vecMulVec (M *ᵥ x) (star (M *ᵥ x))).PosSemidef ∧
      star x ⬝ᵥ ((((Real.sqrt t)⁻¹ : ℝ) : ℂ) • (M *ᵥ x)) =
        (Real.sqrt t : ℂ) :=
  ⟨psd_sub_rank_one hM x ht hpos, normalized_overlap hM x ht hpos⟩

end MilneNew.RankOneExtraction

#print axioms MilneNew.RankOneExtraction.psd_sub_rank_one
#print axioms MilneNew.RankOneExtraction.normalized_overlap
#print axioms MilneNew.RankOneExtraction.extraction

#print axioms MilneNew.RankOneExtraction.normalized_extraction

end -- explicit closure of the constituent EOF section
