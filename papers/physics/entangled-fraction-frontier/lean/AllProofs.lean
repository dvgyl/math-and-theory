    (partialTraceLeft σ-partialTraceLeft (pure w)).PosSemidef := by
  have hA := partialTraceRight_posSemidef hD
  have hB := partialTraceLeft_posSemidef hD
  have eA : partialTraceRight (σ-pure w) = partialTraceRight σ-partialTraceRight (pure w) := by
    ext i j
    simp [partialTraceRight, Finset.sum_sub_distrib]
  have eB : partialTraceLeft (σ-pure w) = partialTraceLeft σ-partialTraceLeft (pure w) := by
    ext i j
    simp [partialTraceLeft, Finset.sum_sub_distrib]
  exact ⟨eA ▸ hA, eB ▸ hB⟩

theorem canonical_bloch (σ : Joint) : blochA σ = blochVec (partialTraceRight σ) := by
  funext i
  simp only [blochA.eq_def, blochVec.eq_def, trace_mul_kron_one]

theorem bob_bloch (ρ : Joint) : blochB ρ = blochVec (partialTraceLeft ρ) := by
  funext j
  simp only [blochB.eq_def, blochVec.eq_def, trace_mul_one_kron]

theorem bob_radius_le_one (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1) :
    vlen (blochB ρ) ≤ 1 := by
  have h := radius_le_trace (partialTraceLeft_posSemidef hρ)
  rw [trace_partialTraceLeft, htr, Complex.one_re, ← bob_bloch] at h
  exact h

theorem alice_radius_le_one (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1) :
    vlen (blochA ρ) ≤ 1 := by
  have h := radius_le_trace (partialTraceRight_posSemidef hρ)
  rw [trace_partialTraceRight, htr, Complex.one_re, ← canonical_bloch] at h
  exact h

theorem centre_radius_le_one (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1) :
    vlen (centre ρ) ≤ 1 := by
  by_cases hb : vlen (blochB ρ) = 1
  · rw [centre, if_pos hb]
    exact alice_radius_le_one ρ hρ htr
  · have hblt := lt_of_le_of_ne (bob_radius_le_one ρ hρ htr) hb
    obtain ⟨σ,F,hσ,hσB,hσA,hback,hFF,hdet⟩ := canonical_filter ρ hρ htr hblt
    rw [← hσA]
    exact alice_radius_le_one σ hσ (canonical_trace σ hσB)

theorem qEig_congr {A B : Qubit} (hA : A.IsHermitian) (hB : B.IsHermitian)
    (h : A=B) (i : Fin 2) : qEig hA i = qEig hB i := by
  subst B
  rfl

theorem half_identity_qEig (hI : (((1/2:ℂ) • (1:Qubit))).IsHermitian) (i : Fin 2) :
    qEig hI i = 1/2 := by
  have hf := qEig_formula hI
  have hr : vlen (blochVec ((1/2:ℂ) • (1:Qubit))) = 0 := by
    simp [vlen, Fin.sum_univ_three, blochVec_zero_eq, blochVec_one_eq, blochVec_two_eq]
  fin_cases i
  · change qEig hI 0 = 1/2
    rw [hf.1, hr]
    norm_num [trace_smul]
  · change qEig hI 1 = 1/2
    rw [hf.2, hr]
    norm_num [trace_smul]

/-- The two decisive Schmidt caps come from the two actual marginal inequalities. -/
theorem canonical_schmidt_caps (σ : Joint) (hσ : σ.PosSemidef)
    (hB : partialTraceLeft σ = (1/2:ℂ) • 1) (w : Fin 2 × Fin 2 → ℂ)
    (hD : (σ-pure w).PosSemidef) :
    qEig (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star w)).isHermitian 0 ≤ 1/2 ∧
    qEig (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star w)).isHermitian 1 ≤
      (1-vlen (blochA σ))/2 := by
  have hm := residual_marginals w hD
  have hwA := partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star w)
  have hwB := partialTraceLeft_posSemidef (posSemidef_vecMulVec_self_star w)
  have hsA := partialTraceRight_posSemidef hσ
  have hsB := partialTraceLeft_posSemidef hσ
  have hcapA := qEig_mono hwA.isHermitian hsA.isHermitian hm.1 1
  have hcapB := qEig_mono hwB.isHermitian hsB.isHermitian hm.2 0
  have htr : trace (partialTraceRight σ) = 1 := by
    rw [trace_partialTraceRight]
    exact canonical_trace σ hB
  have hcapA' : qEig hsA.isHermitian 1 = (1-vlen (blochA σ))/2 := by
    rw [(qEig_formula hsA.isHermitian).2, htr, Complex.one_re, ← canonical_bloch]
  have hI : ((1/2:ℂ) • (1:Qubit)).PosSemidef :=
    PosSemidef.one.smul (by norm_num [Complex.le_def])
  have hcapB' : qEig hsB.isHermitian 0 = 1/2 := by
    rw [qEig_congr hsB.isHermitian hI.isHermitian hB]
    exact half_identity_qEig hI.isHermitian 0
  constructor
  · rw [pure_qEig_eq w 0]
    exact hcapB.trans_eq hcapB'
  · exact hcapA.trans_eq hcapA'

end MilneNew.Qubit

#print axioms MilneNew.Qubit.qEig_formula
#print axioms MilneNew.Qubit.pure_qEig_eq
#print axioms MilneNew.Qubit.canonical_schmidt_caps


/-! The actual reverse filter preserves test-vector norm and converts the
Bob Bloch radius into the test vector's Schmidt imbalance. This closes the
filter/Schmidt interface without assuming a singular-value formula. -/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped ComplexOrder MatrixOrder Kronecker
open D5.S3.Quantum.Information.PartialTraceMutualInformation
open D5.S3.Quantum.Entanglement.SteeringEllipsoidFullyEntangledFraction
namespace MilneNew.Qubit

theorem coeff_bob_action {d : ℕ} (F : Matrix (Fin d) (Fin d) ℂ)
    (e : Fin d × Fin d → ℂ) :
    coeff (((1 : Matrix (Fin d) (Fin d) ℂ) ⊗ₖ F) *ᵥ e) = coeff e * Fᵀ := by
  ext i j
  simp [coeff, Matrix.mulVec, dotProduct, Fintype.sum_prod_type,
    Matrix.mul_apply, Matrix.one_apply, mul_comm]

theorem det_pure_A (w : Fin 2 × Fin 2 → ℂ) :
    det (partialTraceRight (pure w)) = (Complex.normSq (det (coeff w)) : ℂ) := by
  rw [partialTraceRight_pure, Matrix.det_mul, Matrix.det_conjTranspose,
    Complex.star_def, Complex.mul_conj]

theorem maxent_coeff_det (e : Fin 2 × Fin 2 → ℂ) (he : IsMaxEntangled e) :
    Complex.normSq (det (coeff e)) = 1/4 := by
  have h := congrArg Matrix.det he.2.1
  change det (partialTraceRight (pure e)) = det ((1/2:ℂ) • (1:Qubit)) at h
  rw [det_pure_A] at h
  have hr := congrArg Complex.re h
  norm_num [Matrix.det_smul] at hr
  exact hr

theorem form_conj_mul (X σ : Joint) (x : Fin 2 × Fin 2 → ℂ) :
    star x ⬝ᵥ ((X * σ * Xᴴ) *ᵥ x) =
      star (Xᴴ *ᵥ x) ⬝ᵥ (σ *ᵥ (Xᴴ *ᵥ x)) := by
  rw [← mulVec_mulVec, ← mulVec_mulVec, dotProduct_mulVec,
    star_mulVec, conjTranspose_conjTranspose]

theorem form_one_kron (B : Qubit) (x : Fin 2 × Fin 2 → ℂ) :
    star x ⬝ᵥ (((1 : Qubit) ⊗ₖ B) *ᵥ x) =
      trace (B * partialTraceLeft (pure x)) := by
  simp [dotProduct, mulVec, Fintype.sum_prod_type, Fin.sum_univ_two,
    Matrix.trace, Matrix.mul_apply, partialTraceLeft, pure, vecMulVec_apply, Matrix.one_apply]
  ring

/-- A reverse Bob filter applied to a maximally entangled test vector has
unit norm and marginal radius equal to the original Bob marginal radius. -/
theorem filtered_test_geometry (ρ : Joint) (htr : trace ρ = 1)
    (F : Qubit) (hFF : F * Fᴴ = (2:ℂ) • partialTraceLeft ρ)
    (hdet : Complex.normSq (det F) = 1-vlen (blochB ρ)^2)
    (e : Fin 2 × Fin 2 → ℂ) (he : IsMaxEntangled e) :
    let x := (((1:Qubit) ⊗ₖ F)ᴴ) *ᵥ e
    trace (partialTraceRight (pure x)) = 1 ∧
      vlen (blochVec (partialTraceRight (pure x))) = vlen (blochB ρ) := by
  let Y : Joint := (1:Qubit) ⊗ₖ F
  let x : Fin 2 × Fin 2 → ℂ := Yᴴ *ᵥ e
  change trace (partialTraceRight (pure x)) = 1 ∧
    vlen (blochVec (partialTraceRight (pure x))) = vlen (blochB ρ)
  have hYY : Y * Yᴴ = (2:ℂ) • ((1:Qubit) ⊗ₖ partialTraceLeft ρ) := by
    dsimp [Y]
    rw [conjTranspose_kronecker, conjTranspose_one, ← mul_kronecker_mul,
      Matrix.one_mul, hFF, kronecker_smul]
  have hxx : star x ⬝ᵥ x = 1 := by
    have h := form_conj_mul Y 1 e
    rw [Matrix.mul_one, hYY, one_mulVec] at h
    change star (Yᴴ *ᵥ e) ⬝ᵥ (Yᴴ *ᵥ e) = 1
    rw [← h, smul_mulVec, dotProduct_smul, smul_eq_mul, form_one_kron]
    change (2:ℂ) * trace (partialTraceLeft ρ * partialTraceLeft (vecMulVec e (star e))) = 1
    rw [he.2.2, Matrix.mul_smul, Matrix.mul_one, trace_smul, trace_partialTraceLeft, htr]
    norm_num
  have htA : trace (partialTraceRight (pure x)) = 1 := by
    rw [trace_partialTraceRight, pure, Matrix.trace_vecMulVec, dotProduct_comm]
    exact hxx
  have hc : coeff x = coeff e * (Fᴴ)ᵀ := by
    dsimp [x,Y]
    rw [conjTranspose_kronecker, conjTranspose_one, coeff_bob_action]
  have hdA : (det (partialTraceRight (pure x))).re = (1-vlen (blochB ρ)^2)/4 := by
    rw [det_pure_A, Complex.ofReal_re, hc, Matrix.det_mul, Matrix.det_transpose,
      Matrix.det_conjTranspose, Complex.normSq_mul, Complex.star_def, Complex.normSq_conj,
      maxent_coeff_det e he, hdet]
    ring
  have hrad := radius_square
    (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star x)).isHermitian
  change vlen (blochVec (partialTraceRight (pure x)))^2 =
    (trace (partialTraceRight (pure x))).re^2 -
      4*(det (partialTraceRight (pure x))).re at hrad
  rw [htA, Complex.one_re, hdA] at hrad
  have heq : vlen (blochVec (partialTraceRight (pure x)))^2 = vlen (blochB ρ)^2 := by
    nlinarith
  exact ⟨htA, (sq_eq_sq₀ (vlen_nonneg _) (vlen_nonneg _)).mp heq⟩

end MilneNew.Qubit

#print axioms MilneNew.Qubit.filtered_test_geometry


/-!
# The sharp two-qubit centre--Bob-marginal FEF frontier

The principal theorem is about an arbitrary actual complex two-qubit density
matrix, with the original Pauli steering centre and fully entangled fraction.
All Schmidt decompositions, marginal caps, filtering interfaces and trace
inequalities are proved in imported modules, rather than supplied as hypotheses.
-/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped ComplexOrder MatrixOrder Kronecker
open D5.S3.Quantum.Information.PartialTraceMutualInformation
open D5.S3.Quantum.Entanglement.SteeringEllipsoidFullyEntangledFraction
open MilneExpanded
namespace MilneNew.Qubit

/-- Symmetric square-root form of the sharp frontier. -/
def frontier (c b : ℝ) : ℝ :=
  (Real.sqrt ((1+b)/2) * Real.sqrt (1/2) +
    Real.sqrt ((1-b)/2) * Real.sqrt ((1-c)/2))^2

/-- Conventional form used in the accompanying mathematical statement. -/
def frontierStandard (c b : ℝ) : ℝ :=
  (Real.sqrt (1+b) + Real.sqrt (1-c) * Real.sqrt (1-b))^2 / 4

theorem schmidtCoeff_coeff_eq (x : Fin 2 × Fin 2 → ℂ) (i : Fin 2) :
    schmidtCoeff (coeff x) i =
      Real.sqrt (qEig (partialTraceRight_posSemidef
        (posSemidef_vecMulVec_self_star x)).isHermitian i) := by
  unfold schmidtCoeff
  exact congrArg Real.sqrt (qEig_congr
    (Matrix.posSemidef_self_mul_conjTranspose (coeff x)).isHermitian
    (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star x)).isHermitian
    (partialTraceRight_pure x).symm i)

theorem canonical_spectrum (σ : Joint) (hσ : σ.PosSemidef)
    (hB : partialTraceLeft σ = (1/2:ℂ) • 1) :
    qEig (partialTraceRight_posSemidef hσ).isHermitian 0 = (1+vlen (blochA σ))/2 ∧
    qEig (partialTraceRight_posSemidef hσ).isHermitian 1 = (1-vlen (blochA σ))/2 ∧
    qEig (partialTraceLeft_posSemidef hσ).isHermitian 0 = 1/2 ∧
    qEig (partialTraceLeft_posSemidef hσ).isHermitian 1 = 1/2 := by
  have htr : trace (partialTraceRight σ) = 1 := by
    rw [trace_partialTraceRight]
    exact canonical_trace σ hB
  have hf := qEig_formula (partialTraceRight_posSemidef hσ).isHermitian
  rw [htr, Complex.one_re, ← canonical_bloch] at hf
  have hI : ((1/2:ℂ) • (1:Qubit)).PosSemidef :=
    PosSemidef.one.smul (by norm_num [Complex.le_def])
  refine ⟨hf.1,hf.2,?_,?_⟩
  · rw [qEig_congr (partialTraceLeft_posSemidef hσ).isHermitian hI.isHermitian hB]
    exact half_identity_qEig hI.isHermitian 0
  · rw [qEig_congr (partialTraceLeft_posSemidef hσ).isHermitian hI.isHermitian hB]
    exact half_identity_qEig hI.isHermitian 1

/-- Actual canonical-state overlap bound for every normalized test vector. -/
theorem canonical_frontier (σ : Joint) (hσ : σ.PosSemidef)
    (hB : partialTraceLeft σ = (1/2:ℂ) • 1)
    (x : Fin 2 × Fin 2 → ℂ) (hx : trace (partialTraceRight (pure x)) = 1) :
    (star x ⬝ᵥ (σ *ᵥ x)).re ≤
      frontier (vlen (blochA σ)) (vlen (blochVec (partialTraceRight (pure x)))) := by
  have h := quantum_overlap_bound σ hσ x
  obtain ⟨hA0,hA1,hB0,hB1⟩ := canonical_spectrum σ hσ hB
  have hc := vlen_nonneg (blochA σ)
  have hxspec := qEig_formula
    (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star x)).isHermitian
  change qEig (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star x)).isHermitian 0 =
      ((trace (partialTraceRight (pure x))).re+vlen (blochVec (partialTraceRight (pure x))))/2 ∧
    qEig (partialTraceRight_posSemidef (posSemidef_vecMulVec_self_star x)).isHermitian 1 =
      ((trace (partialTraceRight (pure x))).re-vlen (blochVec (partialTraceRight (pure x))))/2
    at hxspec
  rw [hx, Complex.one_re] at hxspec
  change (star x ⬝ᵥ (σ *ᵥ x)).re ≤
    (∑ i, schmidtCoeff (coeff x) i * Real.sqrt
      (min (qEig (partialTraceRight_posSemidef hσ).isHermitian i)
        (qEig (partialTraceLeft_posSemidef hσ).isHermitian i)))^2 at h
  rw [Fin.sum_univ_two, hA0,hA1,hB0,hB1,
    min_eq_right (by linarith : (1/2:ℝ) ≤ (1+vlen (blochA σ))/2),
    min_eq_left (by linarith : (1-vlen (blochA σ))/2 ≤ (1/2:ℝ)),
    schmidtCoeff_coeff_eq x 0, schmidtCoeff_coeff_eq x 1, hxspec.1,hxspec.2] at h
  exact h

/-- The fully general interior bound for each maximally entangled test vector. -/
theorem maxent_frontier (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1)
    (hb : vlen (blochB ρ) < 1) (e : Fin 2 × Fin 2 → ℂ) (he : IsMaxEntangled e) :
    (star e ⬝ᵥ (ρ *ᵥ e)).re ≤ frontier (vlen (centre ρ)) (vlen (blochB ρ)) := by
  obtain ⟨σ,F,hσ,hσB,hσA,hback,hFF,hdet⟩ := canonical_filter ρ hρ htr hb
  let Y : Joint := (1:Qubit) ⊗ₖ F
  let x : Fin 2 × Fin 2 → ℂ := Yᴴ *ᵥ e
  have hg := filtered_test_geometry ρ htr F hFF hdet e he
  change trace (partialTraceRight (pure x)) = 1 ∧
    vlen (blochVec (partialTraceRight (pure x))) = vlen (blochB ρ) at hg
  have h := canonical_frontier σ hσ hσB x hg.1
  have hform : star e ⬝ᵥ (ρ *ᵥ e) = star x ⬝ᵥ (σ *ᵥ x) := by
    conv_lhs => rw [hback]
    exact form_conj_mul Y σ e
  rw [hσA, hg.2, ← hform] at h
  exact h

/-- A concrete maximally entangled vector uses rational complex entries. -/
def bell (k : Fin 2 × Fin 2) : ℂ := if k.1=k.2 then (1+Complex.I)/2 else 0

theorem bell_maxent : IsMaxEntangled bell := by
  have hm : ((1+Complex.I)/2 : ℂ) * (starRingEnd ℂ) ((1+Complex.I)/2) = 2⁻¹ := by
    rw [Complex.mul_conj]
    simp [Complex.normSq_apply]
    norm_num
  have hn : ‖((1+Complex.I)/2 : ℂ)‖^2 = 1/2 := by
    rw [Complex.sq_norm]
    simp [Complex.normSq_apply]
    norm_num
  unfold IsMaxEntangled bell
  generalize hz : ((1+Complex.I)/2 : ℂ) = z at hm hn ⊢
  refine ⟨?_,?_,?_⟩
  · simp [Fintype.sum_prod_type, Fin.sum_univ_two, hn]
    norm_num
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [partialTraceRight, vecMulVec_apply, hm]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [partialTraceLeft, vecMulVec_apply, hm]

/-- The sharp interior FEF bound with no spectral or optimization certificate hypotheses. -/
theorem fef_frontier (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1)
    (hb : vlen (blochB ρ) < 1) :
    fef ρ ≤ frontier (vlen (centre ρ)) (vlen (blochB ρ)) := by
  exact csSup_le ⟨_,bell,bell_maxent,rfl⟩
    (fun _ ⟨e,he,hf⟩ => hf ▸ maxent_frontier ρ hρ htr hb e he)

/-- Every maximally entangled test vector has the actual Schmidt coefficients 1/sqrt(2). -/
theorem maxent_schmidt_coeff (e : Fin 2 × Fin 2 → ℂ) (he : IsMaxEntangled e)
    (i : Fin 2) : schmidtCoeff (coeff e) i = Real.sqrt (1/2) := by
  rw [schmidtCoeff_coeff_eq]
  congr 1
  have hI : ((1/2:ℂ) • (1:Qubit)).PosSemidef :=
    PosSemidef.one.smul (by norm_num [Complex.le_def])
  rw [qEig_congr (partialTraceRight_posSemidef
    (posSemidef_vecMulVec_self_star e)).isHermitian hI.isHermitian he.2.1]
  exact half_identity_qEig hI.isHermitian i

/-- The pure-Bob endpoint is handled using actual marginals and no limiting convention. -/
theorem maxent_singular_frontier (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1)
    (hb : vlen (blochB ρ) = 1) (e : Fin 2 × Fin 2 → ℂ) (he : IsMaxEntangled e) :
    (star e ⬝ᵥ (ρ *ᵥ e)).re ≤ (1+vlen (centre ρ))/4 := by
  have h := quantum_overlap_bound ρ hρ e
  let hA := partialTraceRight_posSemidef hρ
  let hB := partialTraceLeft_posSemidef hρ
  have htA : trace (partialTraceRight ρ) = 1 := by rw [trace_partialTraceRight,htr]
  have htB : trace (partialTraceLeft ρ) = 1 := by rw [trace_partialTraceLeft,htr]
  have hBe := qEig_formula hB.isHermitian
  rw [htB, Complex.one_re, ← bob_bloch, hb] at hBe
  have hB0 : qEig hB.isHermitian 0 = 1 := by linarith [hBe.1]
  have hB1 : qEig hB.isHermitian 1 = 0 := by linarith [hBe.2]
  have hA0le : qEig hA.isHermitian 0 ≤ 1 := by
    have hs := qEig_sum hA.isHermitian
    rw [htA, Complex.one_re] at hs
    linarith [qEig_nonneg hA 1]
  change (star e ⬝ᵥ (ρ *ᵥ e)).re ≤
    (∑ i, schmidtCoeff (coeff e) i * Real.sqrt
      (min (qEig hA.isHermitian i) (qEig hB.isHermitian i)))^2 at h
  rw [Fin.sum_univ_two, maxent_schmidt_coeff e he 0, maxent_schmidt_coeff e he 1,
    hB0,hB1,min_eq_left hA0le,min_eq_right (qEig_nonneg hA 1),
    Real.sqrt_zero,mul_zero,add_zero,mul_pow,
    Real.sq_sqrt (show (0:ℝ) ≤ 1/2 by norm_num),
    Real.sq_sqrt (qEig_nonneg hA 0)] at h
  have hc : centre ρ = blochA ρ := by rw [centre,if_pos hb]
  rw [(qEig_formula hA.isHermitian).1,htA,Complex.one_re,← canonical_bloch,← hc] at h
  convert h using 1 <;> ring

/-- The singular endpoint FEF upper bound uses the original point-ellipsoid centre. -/
theorem fef_singular_frontier (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1)
    (hb : vlen (blochB ρ) = 1) : fef ρ ≤ (1+vlen (centre ρ))/4 := by
  exact csSup_le ⟨_,bell,bell_maxent,rfl⟩
    (fun _ ⟨e,he,hf⟩ => hf ▸ maxent_singular_frontier ρ hρ htr hb e he)

/-- All physical states, including pure Bob marginals, have this piecewise frontier. -/
def sharpFrontier (ρ : Joint) : ℝ :=
  if vlen (blochB ρ) = 1 then (1+vlen (centre ρ))/4
  else frontier (vlen (centre ρ)) (vlen (blochB ρ))

theorem fef_sharpFrontier (ρ : Joint) (hρ : ρ.PosSemidef) (htr : trace ρ = 1) :
    fef ρ ≤ sharpFrontier ρ := by
  unfold sharpFrontier
  by_cases hb : vlen (blochB ρ) = 1
  · rw [if_pos hb]
    exact fef_singular_frontier ρ hρ htr hb
  · rw [if_neg hb]
    exact fef_frontier ρ hρ htr (lt_of_le_of_ne (bob_radius_le_one ρ hρ htr) hb)

/-- Algebraic identification with the conventional closed formula. -/
theorem frontier_eq_standard (c b : ℝ) (hc : c ≤ 1) (hb0 : -1 ≤ b) (hb1 : b ≤ 1) :
    frontier c b = frontierStandard c b := by
  have hfirst : Real.sqrt ((1+b)/2) * Real.sqrt (1/2) = Real.sqrt (1+b)/2 := by
    rw [← Real.sqrt_mul (by linarith : (0:ℝ) ≤ (1+b)/2)]
    have he : ((1+b)/2)*(1/2) = (1+b)/4 := by ring
    rw [he, Real.sqrt_div (by linarith : (0:ℝ) ≤ 1+b)]
    norm_num
  have hsecond : Real.sqrt ((1-b)/2) * Real.sqrt ((1-c)/2) =
      Real.sqrt (1-c) * Real.sqrt (1-b)/2 := by
    rw [← Real.sqrt_mul (by linarith : (0:ℝ) ≤ (1-b)/2)]
    have he : ((1-b)/2)*((1-c)/2) = ((1-c)*(1-b))/4 := by ring
    have hp : (0:ℝ) ≤ (1-c)*(1-b) := mul_nonneg (by linarith) (by linarith)
    rw [he, Real.sqrt_div hp,
      Real.sqrt_mul (by linarith : (0:ℝ) ≤ 1-c)]
    norm_num
  unfold frontier frontierStandard
  rw [hfirst,hsecond]
  ring

/-- Closed-form new bound for every non-pure Bob marginal, in the stated notation. -/
