/-!
# Rearrangement for doubly substochastic matrices

This file proves the finite substochastic rearrangement inequality used in the
singular-value trace bound. The matrix, row capacities and column capacities
are explicit. There is no assumption of the desired weighted inequality.

Proof: each prefix of `C * w` is bounded by the corresponding prefix of the
nonnegative decreasing vector `w`; Abel's comparison inequality then weights
these prefixes by a second nonnegative decreasing vector.
-/

open Finset

namespace MilneSharp

private theorem sum_range_by_parts_real (f g : ℕ → ℝ) (n : ℕ) :
    ∑ i ∈ range n, f i * g i =
      (∑ i ∈ range n, f i) * g (n - 1) -
        ∑ i ∈ range (n - 1), (∑ j ∈ range (i + 1), f j) * (g (i + 1) - g i) := by
  simpa only [smul_eq_mul, mul_comm] using (Finset.sum_range_by_parts g f n)

/-- Abel comparison, specialized to real sequences. The proof is the
Mathlib 4.35 `Finset.sum_mul_le_sum_mul_of_sum_range_le` proof, replayed here
because the cached Mathlib 4.32 does not yet contain that declaration.
Original file: Mathlib/Algebra/Order/Chebyshev.lean; Apache 2.0,
copyright (c) 2023 Mantas Bakšys, Yaël Dillies. -/
theorem abel_comparison {n : ℕ} {f c g : ℕ → ℝ}
    (hfc : ∀ k ≤ n, ∑ i ∈ range k, f i ≤ ∑ i ∈ range k, c i)
    (hg₀ : 0 ≤ g) (hg : AntitoneOn g (Set.Iio n)) :
    ∑ i ∈ range n, f i * g i ≤ ∑ i ∈ range n, c i * g i := by
  rw [← sub_nonneg, ← sum_sub_distrib]
  have hD (k) (hk : k ≤ n) : 0 ≤ ∑ i ∈ range k, (c i - f i) := by
    simpa [sub_nonneg] using hfc k hk
  simp_rw [← sub_mul, sum_range_by_parts_real (fun i ↦ c i - f i) g n]
  rw [sub_nonneg]
  refine (sum_nonpos fun i hi ↦ ?_).trans (mul_nonneg (hD n le_rfl) (hg₀ (n - 1)))
  have hi' : i < n - 1 := mem_range.1 hi
  exact mul_nonpos_of_nonneg_of_nonpos (hD (i + 1) (by omega))
    (sub_nonpos.2 (hg (Set.mem_Iio.2 (by omega)) (Set.mem_Iio.2 (by omega))
      (Nat.le_succ i)))

/-- A decreasing nonnegative vector puts the greatest mass in its first `k`
positions, even when the fractional selection uses at most `k` units of mass. -/
theorem weighted_selection_le_prefix (n k : ℕ) (w u : ℕ → ℝ)
    (hk : k ≤ n)
    (hw : ∀ i < n, 0 ≤ w i)
    (hmono : AntitoneOn w (Set.Iio n))
    (hu0 : ∀ i < n, 0 ≤ u i)
    (hu1 : ∀ i < n, u i ≤ 1)
    (hmass : ∑ i ∈ range n, u i ≤ (k : ℝ)) :
    ∑ i ∈ range n, w i * u i ≤ ∑ i ∈ range k, w i := by
  by_cases hkn : k < n
  · let c := w k
    have hc : 0 ≤ c := hw k hkn
    have hsub : range k ⊆ range n := range_mono hk
    have htail : ∑ i ∈ range n \ range k, (w i - c) * u i ≤ 0 := by
      apply sum_nonpos
      intro i hi
      rw [mem_sdiff, mem_range, mem_range, not_lt] at hi
      exact mul_nonpos_of_nonpos_of_nonneg
        (sub_nonpos.mpr (hmono hkn hi.1 hi.2)) (hu0 i hi.1)
    have hhead : ∑ i ∈ range k, (w i - c) * u i ≤
        ∑ i ∈ range k, (w i - c) := by
      apply sum_le_sum
      intro i hi
      have hik : i < k := mem_range.mp hi
      have hin : i < n := lt_trans hik hkn
      exact mul_le_of_le_one_right
        (sub_nonneg.mpr (hmono hin hkn (le_of_lt hik))) (hu1 i hin)
    have hcenter : ∑ i ∈ range n, (w i - c) * u i ≤
        ∑ i ∈ range k, (w i - c) := by
      calc
        _ = (∑ i ∈ range n \ range k, (w i - c) * u i) +
            (∑ i ∈ range k, (w i - c) * u i) :=
          (sum_sdiff hsub (f := fun i => (w i - c) * u i)).symm
        _ ≤ 0 + ∑ i ∈ range k, (w i - c) := add_le_add htail hhead
        _ = _ := zero_add _
    calc
      (∑ i ∈ range n, w i * u i) =
          (∑ i ∈ range n, (w i - c) * u i) + c * ∑ i ∈ range n, u i := by
        rw [mul_sum, ← sum_add_distrib]
        apply sum_congr rfl
        intro i _
        ring
      _ ≤ (∑ i ∈ range k, (w i - c)) + c * (k : ℝ) :=
        add_le_add hcenter (mul_le_mul_of_nonneg_left hmass hc)
      _ = ∑ i ∈ range k, w i := by
        simp only [sum_sub_distrib, sum_const, card_range, nsmul_eq_mul]
        ring
  · have hkn' : k = n := le_antisymm hk (Nat.le_of_not_lt hkn)
    subst k
    apply sum_le_sum
    intro i hi
    exact mul_le_of_le_one_right (hw i (mem_range.mp hi)) (hu1 i (mem_range.mp hi))

/-- **Substochastic rearrangement.** A nonnegative finite matrix with row and
column sums at most one cannot increase the aligned pairing of two decreasing
nonnegative vectors. Entries outside `[0,n) × [0,n)` are immaterial. -/
theorem substochastic_rearrangement (n : ℕ) (C : ℕ → ℕ → ℝ) (s w : ℕ → ℝ)
    (hC : ∀ i < n, ∀ j < n, 0 ≤ C i j)
    (hrow : ∀ i < n, ∑ j ∈ range n, C i j ≤ 1)
    (hcol : ∀ j < n, ∑ i ∈ range n, C i j ≤ 1)
    (hs : 0 ≤ s)
    (hw : ∀ j < n, 0 ≤ w j)
    (hsm : AntitoneOn s (Set.Iio n))
    (hwm : AntitoneOn w (Set.Iio n)) :
    ∑ i ∈ range n, ∑ j ∈ range n, s i * C i j * w j ≤
      ∑ i ∈ range n, s i * w i := by
  let f : ℕ → ℝ := fun i => ∑ j ∈ range n, C i j * w j
  have hp : ∀ k ≤ n, ∑ i ∈ range k, f i ≤ ∑ i ∈ range k, w i := by
    intro k hk
    let u : ℕ → ℝ := fun j => ∑ i ∈ range k, C i j
    have hu0 : ∀ j < n, 0 ≤ u j := by
      intro j hj
      exact sum_nonneg fun i hi => hC i (lt_of_lt_of_le (mem_range.mp hi) hk) j hj
    have hu1 : ∀ j < n, u j ≤ 1 := by
      intro j hj
      exact (sum_le_sum_of_subset_of_nonneg (range_mono hk)
        (fun i hi _ => hC i (mem_range.mp hi) j hj)).trans (hcol j hj)
    have hmass : ∑ j ∈ range n, u j ≤ (k : ℝ) := by
      dsimp [u]
      rw [sum_comm]
      calc
        _ ≤ ∑ i ∈ range k, (1 : ℝ) := by
          apply sum_le_sum
          intro i hi
          exact hrow i (lt_of_lt_of_le (mem_range.mp hi) hk)
        _ = (k : ℝ) := by simp
    have hbound := weighted_selection_le_prefix n k w u hk hw hwm hu0 hu1 hmass
    calc
      (∑ i ∈ range k, f i) = ∑ j ∈ range n, w j * u j := by
        dsimp [f, u]
        rw [sum_comm]
        apply sum_congr rfl
        intro j _
        rw [mul_sum]
        apply sum_congr rfl
        intro i _
        exact mul_comm _ _
      _ ≤ _ := hbound
  have hbound := abel_comparison hp hs hsm
  simpa only [f, sum_mul, mul_sum, mul_comm, mul_left_comm, mul_assoc] using hbound

/-- Fin-indexed matrix form of substochastic rearrangement. -/
theorem substochastic_rearrangement_fin {n : ℕ} (C : Fin n → Fin n → ℝ)
    (s w : Fin n → ℝ)
    (hC : ∀ i j, 0 ≤ C i j)
    (hrow : ∀ i, ∑ j, C i j ≤ 1)
    (hcol : ∀ j, ∑ i, C i j ≤ 1)
    (hs : ∀ i, 0 ≤ s i) (hw : ∀ i, 0 ≤ w i)
    (hsm : Antitone s) (hwm : Antitone w) :
    ∑ i, ∑ j, s i * C i j * w j ≤ ∑ i, s i * w i := by
  let Cn : ℕ → ℕ → ℝ := fun i j =>
    if hi : i < n then if hj : j < n then C ⟨i, hi⟩ ⟨j, hj⟩ else 0 else 0
  let sn : ℕ → ℝ := fun i => if hi : i < n then s ⟨i, hi⟩ else 0
  let wn : ℕ → ℝ := fun i => if hi : i < n then w ⟨i, hi⟩ else 0
  have hCn : ∀ i < n, ∀ j < n, 0 ≤ Cn i j := by
    intro i hi j hj
    simpa [Cn, hi, hj] using hC ⟨i, hi⟩ ⟨j, hj⟩
  have hrn : ∀ i < n, ∑ j ∈ range n, Cn i j ≤ 1 := by
    intro i hi
    rw [Finset.sum_range]
    simpa [Cn, hi] using hrow ⟨i, hi⟩
  have hcn : ∀ j < n, ∑ i ∈ range n, Cn i j ≤ 1 := by
    intro j hj
    rw [Finset.sum_range]
    simpa [Cn, hj] using hcol ⟨j, hj⟩
  have hsn : 0 ≤ sn := by
    intro i
    dsimp [sn]
    split_ifs with hi
    · exact hs ⟨i, hi⟩
    · exact le_rfl
  have hwn : ∀ i < n, 0 ≤ wn i := by
    intro i hi
    simpa [wn, hi] using hw ⟨i, hi⟩
  have hsmn : AntitoneOn sn (Set.Iio n) := by
    intro i hi j hj hij
    change i < n at hi
    change j < n at hj
    simpa [sn, hi, hj] using hsm (show (⟨i, hi⟩ : Fin n) ≤ ⟨j, hj⟩ from hij)
  have hwmn : AntitoneOn wn (Set.Iio n) := by
    intro i hi j hj hij
    change i < n at hi
    change j < n at hj
    simpa [wn, hi, hj] using hwm (show (⟨i, hi⟩ : Fin n) ≤ ⟨j, hj⟩ from hij)
  have hb := substochastic_rearrangement n Cn sn wn hCn hrn hcn hsn hwn hsmn hwmn
  simpa [Cn, sn, wn, Finset.sum_range] using hb

end MilneSharp

