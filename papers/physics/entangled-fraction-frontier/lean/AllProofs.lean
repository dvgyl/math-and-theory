/-!
# Complete prescribed-Schmidt quantum overlap theorem

This module constructs sorted SVDs from actual Gram matrices, proves the
actual-matrix von Neumann overlap inequality, derives both marginal spectral
caps, and combines them with positive rank-one extraction. The final theorem
assumes only positivity of the actual joint matrix; no SVD, cap, extraction,
or overlap bound is supplied as a hypothesis.

The equal-Gram-to-unitary extension is a separately audited QICLean slice.
The weighted diagonal-unitary trace estimate and Weyl slice were checked in
the first investigation. All definitions and connecting proofs below are
part of this expansion.
-/

noncomputable section
open Matrix
open scoped Matrix ComplexOrder MatrixOrder InnerProductSpace
open D5.S3.Quantum.Information.PartialTraceMutualInformation

/-! ## Coefficient matrices and actual partial traces

The following generic definitions and identities are copied unchanged from
this expansion's CoefficientMatrices draft, consolidated to avoid another
cold compiler/import cycle.
-/
namespace MilneNew.Qubit

def coeff {d : ℕ} (w : Fin d × Fin d → ℂ) : Matrix (Fin d) (Fin d) ℂ :=
  fun i j => w (i,j)

def pure {d : ℕ} (w : Fin d × Fin d → ℂ) :
    Matrix (Fin d × Fin d) (Fin d × Fin d) ℂ := vecMulVec w (star w)

/-- Actual partial trace equals the left coefficient Gram matrix. -/
theorem partialTraceRight_pure {d : ℕ} (w : Fin d × Fin d → ℂ) :
    partialTraceRight (pure w) = coeff w * (coeff w)ᴴ := by
  ext i j
  simp [partialTraceRight, pure, coeff, Matrix.mul_apply, Matrix.conjTranspose_apply,
    Matrix.vecMulVec_apply, Pi.star_apply]

/-- Actual Bob partial trace is the transpose of the right coefficient Gram matrix. -/
theorem partialTraceLeft_pure {d : ℕ} (w : Fin d × Fin d → ℂ) :
    partialTraceLeft (pure w) = ((coeff w)ᴴ * coeff w)ᵀ := by
  ext i j
  simp only [partialTraceLeft, pure, vecMulVec_apply, Pi.star_apply,
    Matrix.transpose_apply, Matrix.mul_apply, Matrix.conjTranspose_apply, coeff]
  apply Finset.sum_congr rfl
  intro k hk
  ring

/-- The vector overlap is the coefficient-matrix Hilbert--Schmidt trace. -/
theorem overlap_eq_trace {d : ℕ} (x w : Fin d × Fin d → ℂ) :
    star x ⬝ᵥ w = trace ((coeff x)ᴴ * coeff w) := by
  simp only [dotProduct, Fintype.sum_prod_type, Matrix.trace, Matrix.diag,
    Matrix.mul_apply, Matrix.conjTranspose_apply, coeff, Pi.star_apply]
  exact Finset.sum_comm


end MilneNew.Qubit

open MilneNew.Qubit

namespace MilneExpanded

/-! ## Canonical ordered Gram spectrum and spectral decomposition -/

/-- Canonical decreasing eigenvalues, with the cardinality cast exposed. -/
def orderedEigenvalue {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) (i : Fin d) : ℝ :=
  hA.eigenvalues₀ (Fin.cast (Fintype.card_fin d).symm i)

private def spectralIndex (d : ℕ) : Fin d ≃ Fin d :=
  (finCongr (Fintype.card_fin d).symm).trans
    (Fintype.equivOfCardEq (Fintype.card_fin (Fintype.card (Fin d))))

theorem orderedEigenvalue_eq_eigenvalue {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) (i : Fin d) :
    orderedEigenvalue hA i = hA.eigenvalues (spectralIndex d i) := by
  simp [orderedEigenvalue, Matrix.IsHermitian.eigenvalues, spectralIndex]

theorem orderedEigenvalue_antitone {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) : Antitone (orderedEigenvalue hA) := by
  intro i j hij
  exact hA.eigenvalues₀_antitone hij

theorem orderedEigenvalue_nonneg {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.PosSemidef) (i : Fin d) : 0 ≤ orderedEigenvalue hA.isHermitian i := by
  rw [orderedEigenvalue_eq_eigenvalue]
  exact hA.eigenvalues_nonneg _

/-- Actual squared Schmidt coefficients of the coefficient matrix. -/
def gramEig {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) : Fin d → ℝ :=
  orderedEigenvalue (Matrix.posSemidef_self_mul_conjTranspose C).isHermitian

/-- Actual singular values, decreasing and zero padded. -/
def schmidtCoeff {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) (i : Fin d) : ℝ :=
  Real.sqrt (gramEig C i)

theorem gramEig_nonneg {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) (i : Fin d) :
    0 ≤ gramEig C i :=
  orderedEigenvalue_nonneg (Matrix.posSemidef_self_mul_conjTranspose C) i

theorem schmidtCoeff_nonneg {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) (i : Fin d) :
    0 ≤ schmidtCoeff C i := Real.sqrt_nonneg _

theorem schmidtCoeff_antitone {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) :
    Antitone (schmidtCoeff C) := by
  intro i j hij
  exact Real.sqrt_le_sqrt (orderedEigenvalue_antitone _ hij)

private def orderedUnitary {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) : Matrix.unitaryGroup (Fin d) ℂ :=
  let b := hA.eigenvectorBasis.reindex (spectralIndex d).symm
  ⟨(EuclideanSpace.basisFun (Fin d) ℂ).toBasis.toMatrix b.toBasis,
    (EuclideanSpace.basisFun (Fin d) ℂ).toMatrix_orthonormalBasis_mem_unitary b⟩

private theorem orderedUnitary_apply {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) (i j : Fin d) :
    orderedUnitary hA i j = hA.eigenvectorBasis (spectralIndex d j) i := by
  change (hA.eigenvectorBasis.reindex (spectralIndex d).symm) j i = _
  simp only [OrthonormalBasis.reindex_apply, Equiv.symm_symm]

private theorem orderedUnitary_intertwine {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) :
    A * (orderedUnitary hA : Matrix (Fin d) (Fin d) ℂ) =
      (orderedUnitary hA : Matrix (Fin d) (Fin d) ℂ) *
        Matrix.diagonal (fun i => (orderedEigenvalue hA i : ℂ)) := by
  ext i j
  rw [Matrix.mul_diagonal]
  change (A *ᵥ (fun k => orderedUnitary hA k j)) i = _
  simp only [orderedUnitary_apply, orderedEigenvalue_eq_eigenvalue]
  have hv := congrFun (hA.mulVec_eigenvectorBasis (spectralIndex d j)) i
  simpa [Pi.smul_apply, RCLike.real_smul_eq_coe_smul, smul_eq_mul, mul_comm] using hv

/-- Spectral decomposition with the explicitly decreasing coefficient list. -/
theorem ordered_spectral_decomposition {d : ℕ} {A : Matrix (Fin d) (Fin d) ℂ}
    (hA : A.IsHermitian) :
    ∃ U : Matrix.unitaryGroup (Fin d) ℂ,
      A = (U : Matrix (Fin d) (Fin d) ℂ) *
        Matrix.diagonal (fun i => (orderedEigenvalue hA i : ℂ)) *
          (U : Matrix (Fin d) (Fin d) ℂ)ᴴ := by
  refine ⟨orderedUnitary hA, ?_⟩
  have h := congrArg (fun M : Matrix (Fin d) (Fin d) ℂ =>
    M * (orderedUnitary hA : Matrix (Fin d) (Fin d) ℂ)ᴴ)
    (orderedUnitary_intertwine hA)
  have hUU : (orderedUnitary hA : Matrix (Fin d) (Fin d) ℂ) *
      (orderedUnitary hA : Matrix (Fin d) (Fin d) ℂ)ᴴ = 1 :=
    Unitary.mul_star_self_of_mem (orderedUnitary hA).property
  simpa only [Matrix.mul_assoc, hUU, Matrix.mul_one] using h



/-! ## Constructive sorted SVD, including zero singular values -/

/-- Every square complex matrix has a sorted SVD, with the coefficients
identified with the actual decreasing eigenvalues of its left Gram matrix. -/
theorem exists_sorted_svd {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) :
    ∃ U V : Matrix.unitaryGroup (Fin d) ℂ,
      C = (U : Matrix (Fin d) (Fin d) ℂ) *
        Matrix.diagonal (fun i => (schmidtCoeff C i : ℂ)) *
          (V : Matrix (Fin d) (Fin d) ℂ)ᴴ := by
  have hG := Matrix.posSemidef_self_mul_conjTranspose C
  obtain ⟨U, hU⟩ := ordered_spectral_decomposition hG.isHermitian
  let D : Matrix (Fin d) (Fin d) ℂ :=
    Matrix.diagonal (fun i => (schmidtCoeff C i : ℂ))
  have hDstar : Dᴴ = D := by simp [D]
  have hDsq : D * D = Matrix.diagonal (fun i => (gramEig C i : ℂ)) := by
    dsimp only [D]
    rw [Matrix.diagonal_mul_diagonal]
    congr 1
    funext i
    rw [← Complex.ofReal_mul]
    congr 1
    exact Real.mul_self_sqrt (gramEig_nonneg C i)
  have hGram : Cᴴᴴ * Cᴴ =
      (D * (U : Matrix (Fin d) (Fin d) ℂ)ᴴ)ᴴ *
        (D * (U : Matrix (Fin d) (Fin d) ℂ)ᴴ) := by
    rw [Matrix.conjTranspose_conjTranspose, Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hDstar]
    rw [Matrix.mul_assoc, ← Matrix.mul_assoc D D, hDsq]
    simpa only [Matrix.mul_assoc, gramEig] using hU
  obtain ⟨V, hV⟩ := Matrix.exists_unitary_mul_eq_of_conjTranspose_mul_eq
    Cᴴ (D * (U : Matrix (Fin d) (Fin d) ℂ)ᴴ) hGram
  refine ⟨U, V, ?_⟩
  have h := congrArg Matrix.conjTranspose hV
  simpa only [Matrix.conjTranspose_conjTranspose, Matrix.conjTranspose_mul,
    hDstar, Matrix.mul_assoc] using h


/-! ## Actual matrix overlap, marginal caps, and quantum composition -/

/-- Von Neumann's weighted trace inequality for actual finite complex matrices,
with singular values defined from their canonical decreasing Gram eigenvalues. -/
theorem coeff_overlap_le {d : ℕ} (X W : Matrix (Fin d) (Fin d) ℂ) :
    ‖Matrix.trace (Xᴴ * W)‖ ≤
      ∑ i, schmidtCoeff X i * schmidtCoeff W i := by
  obtain ⟨Ux, Vx, hX⟩ := exists_sorted_svd X
  obtain ⟨Uw, Vw, hW⟩ := exists_sorted_svd W
  let DX : Matrix (Fin d) (Fin d) ℂ :=
    Matrix.diagonal (fun i => (schmidtCoeff X i : ℂ))
  let DW : Matrix (Fin d) (Fin d) ℂ :=
    Matrix.diagonal (fun i => (schmidtCoeff W i : ℂ))
  have hDX : DXᴴ = DX := by simp [DX]
  have hU : ((Ux : Matrix (Fin d) (Fin d) ℂ)ᴴ *
      (Uw : Matrix (Fin d) (Fin d) ℂ)) ∈ Matrix.unitaryGroup (Fin d) ℂ :=
    (Matrix.unitaryGroup (Fin d) ℂ).mul_mem (Unitary.star_mem Ux.property) Uw.property
  have hV : ((Vw : Matrix (Fin d) (Fin d) ℂ)ᴴ *
      (Vx : Matrix (Fin d) (Fin d) ℂ)) ∈ Matrix.unitaryGroup (Fin d) ℂ :=
    (Matrix.unitaryGroup (Fin d) ℂ).mul_mem (Unitary.star_mem Vw.property) Vx.property
  have htrace : Matrix.trace (Xᴴ * W) =
      Matrix.trace (DX * ((Ux : Matrix (Fin d) (Fin d) ℂ)ᴴ * (Uw : Matrix (Fin d) (Fin d) ℂ)) * DW *
        ((Vw : Matrix (Fin d) (Fin d) ℂ)ᴴ * (Vx : Matrix (Fin d) (Fin d) ℂ))) := by
    change X = (Ux : Matrix (Fin d) (Fin d) ℂ) * DX *
      (Vx : Matrix (Fin d) (Fin d) ℂ)ᴴ at hX
    change W = (Uw : Matrix (Fin d) (Fin d) ℂ) * DW *
      (Vw : Matrix (Fin d) (Fin d) ℂ)ᴴ at hW
    rw [hX, hW, Matrix.conjTranspose_mul, Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hDX]
    simp only [Matrix.mul_assoc]
    rw [Matrix.trace_mul_comm (Vx : Matrix (Fin d) (Fin d) ℂ)]
    simp only [Matrix.mul_assoc]
  rw [htrace]
  exact MilneSharp.weighted_diagonal_unitary_trace _ _ (schmidtCoeff X)
    (schmidtCoeff W) hU hV (schmidtCoeff_nonneg X) (schmidtCoeff_nonneg W)
      (schmidtCoeff_antitone X) (schmidtCoeff_antitone W)

/-- Equality of characteristic polynomials identifies the ordered eigenvalue
lists without any arbitrary permutation of the matrix index type. -/
theorem orderedEigenvalue_eq_of_charpoly {d : ℕ}
    {A B : Matrix (Fin d) (Fin d) ℂ} (hA : A.IsHermitian) (hB : B.IsHermitian)
    (h : A.charpoly = B.charpoly) : orderedEigenvalue hA = orderedEigenvalue hB := by
  have he := (hA.eigenvalues_eq_eigenvalues_iff hB).mpr h
  funext i
  rw [orderedEigenvalue_eq_eigenvalue, orderedEigenvalue_eq_eigenvalue, he]

/-- A coefficient matrix and its transpose have the same squared Schmidt
coefficients, including all zero and repeated values. -/
theorem gramEig_transpose {d : ℕ} (C : Matrix (Fin d) (Fin d) ℂ) :
    gramEig Cᵀ = gramEig C := by
  apply orderedEigenvalue_eq_of_charpoly
  have ht : Cᵀ * Cᵀᴴ = (Cᴴ * C)ᵀ := by
    rw [Matrix.transpose_mul]
    rfl
  rw [ht, Matrix.charpoly_transpose, Matrix.charpoly_mul_comm]

/-- Loewner order controls the explicitly cast, decreasing eigenvalue list. -/
theorem orderedEigenvalue_mono {d : ℕ}
    {A B : Matrix (Fin d) (Fin d) ℂ} (hA : A.IsHermitian) (hB : B.IsHermitian)
    (hAB : A ≤ B) (i : Fin d) : orderedEigenvalue hA i ≤ orderedEigenvalue hB i :=
  hA.eigenvalues₀_mono hB hAB _

/-- Both marginal Gram constraints cap every squared Schmidt coefficient. -/
theorem gramEig_le_min {d : ℕ} (W A B : Matrix (Fin d) (Fin d) ℂ)
    (hA : A.IsHermitian) (hB : B.IsHermitian)
    (hWA : W * Wᴴ ≤ A) (hWB : Wᵀ * Wᵀᴴ ≤ B) (i : Fin d) :
    gramEig W i ≤ min (orderedEigenvalue hA i) (orderedEigenvalue hB i) := by
  apply le_min
  · exact orderedEigenvalue_mono _ hA hWA i
  · have h := orderedEigenvalue_mono
      (Matrix.posSemidef_self_mul_conjTranspose Wᵀ).isHermitian hB hWB i
    change gramEig Wᵀ i ≤ orderedEigenvalue hB i at h
    simpa only [gramEig_transpose] using h

/-- The sharp prescribed-Schmidt overlap upper bound under two actual Gram
matrix caps. No spectral bound or overlap inequality is a hypothesis. -/
theorem coeff_overlap_le_marginal_caps {d : ℕ}
    (X W A B : Matrix (Fin d) (Fin d) ℂ)
    (hA : A.IsHermitian) (hB : B.IsHermitian)
    (hWA : W * Wᴴ ≤ A) (hWB : Wᵀ * Wᵀᴴ ≤ B) :
    ‖Matrix.trace (Xᴴ * W)‖ ≤
      ∑ i, schmidtCoeff X i *
        Real.sqrt (min (orderedEigenvalue hA i) (orderedEigenvalue hB i)) := by
  apply (coeff_overlap_le X W).trans
  apply Finset.sum_le_sum
  intro i _
  exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt
    (gramEig_le_min W A B hA hB hWA hWB i)) (schmidtCoeff_nonneg X i)

/-- The complete prescribed-Schmidt quantum overlap bound for an arbitrary
positive semidefinite bipartite matrix. Marginals and Schmidt coefficients
are computed from the actual inputs; no spectral-cap, SVD, extraction, or
overlap certificate occurs among the hypotheses. Normalizing `M` and `x` is
unnecessary for this homogeneous bound. -/
theorem quantum_overlap_bound {d : ℕ}
    (M : Matrix (Fin d × Fin d) (Fin d × Fin d) ℂ) (hM : M.PosSemidef)
    (x : Fin d × Fin d → ℂ) :
    (star x ⬝ᵥ (M *ᵥ x)).re ≤
      (∑ i, schmidtCoeff (coeff x) i *
        Real.sqrt (min
          (orderedEigenvalue (partialTraceRight_posSemidef hM).isHermitian i)
          (orderedEigenvalue (partialTraceLeft_posSemidef hM).isHermitian i))) ^ 2 := by
  let A := partialTraceRight M
  let B := partialTraceLeft M
  have hA : A.PosSemidef := partialTraceRight_posSemidef hM
  have hB : B.PosSemidef := partialTraceLeft_posSemidef hM
  let t : ℝ := (star x ⬝ᵥ (M *ᵥ x)).re
  have ht0 : 0 ≤ t := (Complex.nonneg_iff.mp (hM.dotProduct_mulVec_nonneg x)).1
  by_cases ht : t = 0
  · change t ≤ _
    rw [ht]
    exact sq_nonneg _
  have htp : 0 < t := lt_of_le_of_ne ht0 (Ne.symm ht)
  obtain ⟨w, hsub, hinner⟩ :=
    MilneNew.RankOneExtraction.normalized_extraction hM x rfl htp
  change star x ⬝ᵥ w = (Real.sqrt t : ℂ) at hinner
  have hWA : coeff w * (coeff w)ᴴ ≤ A := by
    apply Matrix.le_iff.mpr
    have hh := partialTraceRight_posSemidef hsub
    have he : partialTraceRight (M - pure w) = A - partialTraceRight (pure w) := by
      ext i j
      simp [A, partialTraceRight, Finset.sum_sub_distrib]
    change (partialTraceRight (M - pure w)).PosSemidef at hh
    rw [he, partialTraceRight_pure] at hh
    exact hh
  have hWB : (coeff w)ᵀ * (coeff w)ᵀᴴ ≤ B := by
    apply Matrix.le_iff.mpr
    have hh := partialTraceLeft_posSemidef hsub
    have he : partialTraceLeft (M - pure w) = B - partialTraceLeft (pure w) := by
      ext i j
      simp [B, partialTraceLeft, Finset.sum_sub_distrib]
    change (partialTraceLeft (M - pure w)).PosSemidef at hh
    rw [he, partialTraceLeft_pure] at hh
    have hgram : (coeff w)ᵀ * (coeff w)ᵀᴴ = ((coeff w)ᴴ * coeff w)ᵀ := by
      rw [Matrix.transpose_mul]
      rfl
    rwa [hgram]
  have hb := coeff_overlap_le_marginal_caps (coeff x) (coeff w) A B
    hA.isHermitian hB.isHermitian hWA hWB
  rw [← overlap_eq_trace x w, hinner] at hb
  have hsqrt : Real.sqrt t ≤ ∑ i, schmidtCoeff (coeff x) i *
      Real.sqrt (min (orderedEigenvalue hA.isHermitian i)
        (orderedEigenvalue hB.isHermitian i)) := by
    simpa only [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.sqrt_nonneg t)] using hb
  have hS := (Real.sqrt_nonneg t).trans hsqrt
  have hsq := (sq_le_sq₀ (Real.sqrt_nonneg t) hS).2 hsqrt
  rw [Real.sq_sqrt ht0] at hsq
  simpa only [A, B, t] using hsq


end MilneExpanded

