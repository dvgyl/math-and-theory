/-!
# Exact pure-target overlap from marginal populations

For any finite complex positive matrix, its overlap with a vector supported
on the computational diagonal is bounded by the squared weighted sum of
the square roots of the smaller marginal populations.  The coherent-minimum
matrix attains this upper bound for every pair of probability populations.

The theorem uses actual complex matrices and Matrix.PosSemidef.  No Schmidt
decomposition, spectral-order or von Neumann trace inequality is assumed.
The diagonal populations are in the target's displayed local bases, and need
not be ordered or be eigenvalues of the marginals.
-/

set_option autoImplicit false
noncomputable section
open Matrix
open scoped BigOperators ComplexOrder
open D5.S3.Quantum.Information.PartialTraceMutualInformation

namespace MilneExpanded.PopulationOverlap

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def popA (M : Matrix (ι × ι) (ι × ι) ℂ) (i : ι) : ℝ :=
  ∑ j, (M (i,j) (i,j)).re

def popB (M : Matrix (ι × ι) (ι × ι) ℂ) (j : ι) : ℝ :=
  ∑ i, (M (i,j) (i,j)).re

def target (p : ι → ℝ) (ij : ι × ι) : ℂ :=
  if ij.1 = ij.2 then (Real.sqrt (p ij.1) : ℂ) else 0

def expectation (M : Matrix (ι × ι) (ι × ι) ℂ) (p : ι → ℝ) : ℝ :=
  (star (target p) ⬝ᵥ (M *ᵥ target p)).re

def bound (a b p : ι → ℝ) : ℝ :=
  (∑ i, Real.sqrt (p i) * Real.sqrt (min (a i) (b i))) ^ 2

lemma target_normalized (p : ι → ℝ) (hp0 : ∀ i, 0 ≤ p i)
    (hp : ∑ i, p i = 1) :
    star (target p) ⬝ᵥ target p = 1 := by
  have ht : target p = fun i => (MilneCoherentMin.diagonalVector p i : ℂ) := by
    funext i
    by_cases hi : i.1 = i.2 <;> simp [target, MilneCoherentMin.diagonalVector, hi]
  calc
    star (target p) ⬝ᵥ target p =
        ((∑ ij : ι × ι, MilneCoherentMin.diagonalVector p ij ^ 2 : ℝ) : ℂ) := by
      simp [ht, dotProduct, pow_two]
    _ = 1 := by rw [MilneCoherentMin.diagonalVector_norm p hp0 hp]; rfl

lemma diagonal_re_nonneg {M : Matrix (ι × ι) (ι × ι) ℂ}
    (hM : M.PosSemidef) (ij : ι × ι) : 0 ≤ (M ij ij).re :=
  (Complex.nonneg_iff.mp hM.diag_nonneg).1

lemma diagonal_le_popA {M : Matrix (ι × ι) (ι × ι) ℂ}
    (hM : M.PosSemidef) (i : ι) : (M (i,i) (i,i)).re ≤ popA M i := by
  exact Finset.single_le_sum (fun j _ => diagonal_re_nonneg hM (i,j))
    (Finset.mem_univ i)

lemma diagonal_le_popB {M : Matrix (ι × ι) (ι × ι) ℂ}
    (hM : M.PosSemidef) (i : ι) : (M (i,i) (i,i)).re ≤ popB M i := by
  exact Finset.single_le_sum (fun j _ => diagonal_re_nonneg hM (j,i))
    (Finset.mem_univ i)

lemma extracted_diagonal_cap {M : Matrix (ι × ι) (ι × ι) ℂ}
    (hM : M.PosSemidef) (w : ι × ι → ℂ)
    (hw : (M - vecMulVec w (star w)).PosSemidef) (i : ι) :
    Complex.normSq (w (i,i)) ≤ min (popA M i) (popB M i) := by
  have h := (Complex.nonneg_iff.mp (hw.diag_nonneg (i := (i,i)))).1
  have hdiag : Complex.normSq (w (i,i)) ≤ (M (i,i) (i,i)).re := by
    simpa only [Matrix.sub_apply, vecMulVec_apply, Pi.star_apply,
      Complex.star_def, Complex.mul_conj, Complex.sub_re, Complex.ofReal_re,
      sub_nonneg] using h
  exact le_min (hdiag.trans (diagonal_le_popA hM i))
    (hdiag.trans (diagonal_le_popB hM i))

lemma target_overlap_re (p : ι → ℝ) (w : ι × ι → ℂ) :
    (star (target p) ⬝ᵥ w).re = ∑ i, Real.sqrt (p i) * (w (i,i)).re := by
  simp [dotProduct, target, Fintype.sum_prod_type, Complex.mul_re, apply_ite, ite_mul]

/-- The population bound holds for every finite complex PSD matrix; it does
not require trace one, normalized targets, sorted populations, or diagonal
marginal matrices. -/
theorem population_overlap_bound {M : Matrix (ι × ι) (ι × ι) ℂ}
    (hM : M.PosSemidef) (p : ι → ℝ) :
    expectation M p ≤ bound (popA M) (popB M) p := by
  let t := expectation M p
  by_cases ht : 0 < t
  · obtain ⟨w, hw, hx⟩ :=
      MilneNew.RankOneExtraction.normalized_extraction hM (target p) rfl ht
    have ho : Real.sqrt t = ∑ i, Real.sqrt (p i) * (w (i,i)).re := by
      calc
        Real.sqrt t = (star (target p) ⬝ᵥ w).re := by
          simpa only [t, expectation, Complex.ofReal_re] using
            (congrArg Complex.re hx).symm
        _ = ∑ i, Real.sqrt (p i) * (w (i,i)).re := target_overlap_re p w
    have hs : Real.sqrt t ≤
        ∑ i, Real.sqrt (p i) * Real.sqrt (min (popA M i) (popB M i)) := by
      rw [ho]
      apply Finset.sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_left _ (Real.sqrt_nonneg _)
      calc
        (w (i,i)).re ≤ ‖w (i,i)‖ := Complex.re_le_norm _
        _ = Real.sqrt (Complex.normSq (w (i,i))) := Complex.norm_def _
        _ ≤ Real.sqrt (min (popA M i) (popB M i)) :=
          Real.sqrt_le_sqrt (extracted_diagonal_cap hM w hw i)
    have hn : 0 ≤ ∑ i, Real.sqrt (p i) *
        Real.sqrt (min (popA M i) (popB M i)) :=
      Finset.sum_nonneg (fun i _ => mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
    have h := (sq_le_sq₀ (Real.sqrt_nonneg t) hn).mpr hs
    rw [Real.sq_sqrt ht.le] at h
    exact h
  · exact (le_of_not_gt ht).trans (sq_nonneg _)

def attainingMatrix (a b : ι → ℝ) : Matrix (ι × ι) (ι × ι) ℂ :=
  fun ij kl => (MilneCoherentMin.coherentState a b ij kl : ℂ)

lemma attainingMatrix_hermitian (a b : ι → ℝ) :
    (attainingMatrix a b).IsHermitian := by
  ext ij kl
  exact MilneCoherentMin.coherentState_complex_hermitian a b kl ij

lemma attainingMatrix_form (a b : ι → ℝ) (x : ι × ι → ℂ) :
    star x ⬝ᵥ (attainingMatrix a b *ᵥ x) =
      MilneCoherentMin.complexQuadratic (MilneCoherentMin.coherentState a b) x := by
  simp only [dotProduct, mulVec, MilneCoherentMin.complexQuadratic,
    attainingMatrix, Finset.mul_sum, Pi.star_apply, Complex.star_def]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem attainingMatrix_posSemidef (a b : ι → ℝ) (ha : ∑ i, a i = 1) :
    (attainingMatrix a b).PosSemidef := by
  refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg
    (attainingMatrix_hermitian a b) fun x => ?_
  apply Complex.nonneg_iff.mpr
  constructor
  · rw [attainingMatrix_form]
    exact MilneCoherentMin.coherentState_complex_quadratic_nonneg a b ha x
  · have h := congrArg Complex.im
      (MilneNew.RankOneExtraction.form_conj (attainingMatrix_hermitian a b) x x)
    simp only [Complex.star_def, Complex.conj_im] at h
    linarith

lemma attainingMatrix_popA (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    popA (attainingMatrix a b) = a := by
  funext i
  have h := congrFun (congrFun
    (MilneCoherentMin.coherentState_partialA a b ha0 hb0 ha hb) i) i
  simpa [popA, attainingMatrix, MilneCoherentMin.partialA] using h

lemma attainingMatrix_popB (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    popB (attainingMatrix a b) = b := by
  funext i
  have h := congrFun (congrFun
    (MilneCoherentMin.coherentState_partialB a b ha0 hb0 ha hb) i) i
  simpa [popB, attainingMatrix, MilneCoherentMin.partialB] using h

lemma attainingMatrix_partialTraceRight (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    partialTraceRight (attainingMatrix a b) = Matrix.diagonal (fun i => (a i : ℂ)) := by
  ext i k
  have h := congrArg Complex.ofReal (congrFun (congrFun
    (MilneCoherentMin.coherentState_partialA a b ha0 hb0 ha hb) i) k)
  by_cases hik : i = k <;>
    simpa [partialTraceRight, attainingMatrix, MilneCoherentMin.partialA,
      Matrix.diagonal, hik] using h

lemma attainingMatrix_partialTraceLeft (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    partialTraceLeft (attainingMatrix a b) = Matrix.diagonal (fun i => (b i : ℂ)) := by
  ext j l
  have h := congrArg Complex.ofReal (congrFun (congrFun
    (MilneCoherentMin.coherentState_partialB a b ha0 hb0 ha hb) j) l)
  by_cases hjl : j = l <;>
    simpa [partialTraceLeft, attainingMatrix, MilneCoherentMin.partialB,
      Matrix.diagonal, hjl] using h

lemma popA_of_partialTraceRight (M : Matrix (ι × ι) (ι × ι) ℂ) (a : ι → ℝ)
    (hA : partialTraceRight M = Matrix.diagonal (fun i => (a i : ℂ))) :
    popA M = a := by
  funext i
  have h := congrArg Complex.re (congrFun (congrFun hA i) i)
  simpa [partialTraceRight, popA] using h

lemma popB_of_partialTraceLeft (M : Matrix (ι × ι) (ι × ι) ℂ) (b : ι → ℝ)
    (hB : partialTraceLeft M = Matrix.diagonal (fun i => (b i : ℂ))) :
    popB M = b := by
  funext i
  have h := congrArg Complex.re (congrFun (congrFun hB i) i)
  simpa [partialTraceLeft, popB] using h

lemma attainingMatrix_trace (a b : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    (attainingMatrix a b).trace = 1 := by
  have h := MilneCoherentMin.coherentState_trace_one a b ha0 hb0 ha hb
  simpa [Matrix.trace, attainingMatrix] using congrArg Complex.ofReal h

lemma attainingMatrix_overlap (a b p : ι → ℝ) :
    expectation (attainingMatrix a b) p = bound a b p := by
  have ht : target p = fun i => (MilneCoherentMin.diagonalVector p i : ℂ) := by
    funext i
    by_cases hi : i.1 = i.2 <;> simp [target, MilneCoherentMin.diagonalVector, hi]
  unfold expectation
  rw [attainingMatrix_form, ht, MilneCoherentMin.coherentState_complex_target_overlap]
  rfl

/-- End-to-end sharp optimization over all complex PSD matrices with the
prescribed marginal populations.  The witness is a trace-one density matrix.
The competing matrices need not have diagonal marginal matrices. -/
theorem population_overlap_exact_maximum (a b p : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    ∃ M : Matrix (ι × ι) (ι × ι) ℂ,
      M.PosSemidef ∧ M.trace = 1 ∧ popA M = a ∧ popB M = b ∧
      expectation M p = bound a b p ∧
      ∀ N : Matrix (ι × ι) (ι × ι) ℂ, N.PosSemidef →
        popA N = a → popB N = b → expectation N p ≤ expectation M p := by
  refine ⟨attainingMatrix a b, attainingMatrix_posSemidef a b ha,
    attainingMatrix_trace a b ha0 hb0 ha hb,
    attainingMatrix_popA a b ha0 hb0 ha hb,
    attainingMatrix_popB a b ha0 hb0 ha hb,
    attainingMatrix_overlap a b p, ?_⟩
  intro N hN hA hB
  rw [attainingMatrix_overlap]
  simpa only [hA, hB] using population_overlap_bound hN p

/-- Exact optimization with both full marginal matrices prescribed, including
their off-diagonal entries. The state, positivity, traces, target overlap, and
the upper bound for every competing state are all proved from finite matrix
definitions. No order of a, b or p, positivity of p, or nonsingularity is needed. -/
theorem diagonal_marginal_overlap_exact_maximum (a b p : ι → ℝ)
    (ha0 : ∀ i, 0 ≤ a i) (hb0 : ∀ i, 0 ≤ b i)
    (ha : ∑ i, a i = 1) (hb : ∑ i, b i = 1) :
    ∃ M : Matrix (ι × ι) (ι × ι) ℂ,
      M.PosSemidef ∧
      partialTraceRight M = Matrix.diagonal (fun i => (a i : ℂ)) ∧
      partialTraceLeft M = Matrix.diagonal (fun i => (b i : ℂ)) ∧
      M.trace = 1 ∧ expectation M p = bound a b p ∧
      ∀ N : Matrix (ι × ι) (ι × ι) ℂ,
        N.PosSemidef →
        partialTraceRight N = Matrix.diagonal (fun i => (a i : ℂ)) →
        partialTraceLeft N = Matrix.diagonal (fun i => (b i : ℂ)) →
        expectation N p ≤ expectation M p := by
  refine ⟨attainingMatrix a b, attainingMatrix_posSemidef a b ha,
    attainingMatrix_partialTraceRight a b ha0 hb0 ha hb,
    attainingMatrix_partialTraceLeft a b ha0 hb0 ha hb,
    attainingMatrix_trace a b ha0 hb0 ha hb,
    attainingMatrix_overlap a b p, ?_⟩
  intro N hN hRight hLeft
  have hA := popA_of_partialTraceRight N a hRight
  have hB := popB_of_partialTraceLeft N b hLeft
  rw [attainingMatrix_overlap]
  simpa only [hA, hB] using population_overlap_bound hN p

end MilneExpanded.PopulationOverlap

#print axioms MilneExpanded.PopulationOverlap.population_overlap_bound
#print axioms MilneExpanded.PopulationOverlap.target_normalized
#print axioms MilneExpanded.PopulationOverlap.attainingMatrix_posSemidef
#print axioms MilneExpanded.PopulationOverlap.population_overlap_exact_maximum
#print axioms MilneExpanded.PopulationOverlap.diagonal_marginal_overlap_exact_maximum

end -- explicit closure of the constituent EOF section
