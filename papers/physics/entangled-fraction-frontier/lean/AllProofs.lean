set_option autoImplicit false
noncomputable section
open scoped BigOperators
namespace MilneRefinement
variable {ι : Type*} [Fintype ι]

def spectralAmplitude (s a b : ι → ℝ) : ℝ :=
  ∑ i, s i * Real.sqrt (min (a i) (b i))

theorem schmidt_cap_amplitude (s q a b : ι → ℝ)
    (hs : ∀ i, 0 ≤ s i) (hqa : ∀ i, q i ≤ a i) (hqb : ∀ i, q i ≤ b i) :
    (∑ i, s i * Real.sqrt (q i)) ≤ spectralAmplitude s a b := by
  apply Finset.sum_le_sum
  intro i _
  apply mul_le_mul_of_nonneg_left _ (hs i)
  exact Real.sqrt_le_sqrt (le_min (hqa i) (hqb i))

theorem weighted_schmidt_cap (t : ℝ) (s q a b : ι → ℝ)
    (ht : 0 ≤ t) (hs : ∀ i, 0 ≤ s i)
    (hqa : ∀ i, q i ≤ a i) (hqb : ∀ i, q i ≤ b i)
    (htrace : Real.sqrt t ≤ ∑ i, s i * Real.sqrt (q i)) :
    t ≤ (spectralAmplitude s a b)^2 := by
  have hcap := schmidt_cap_amplitude s q a b hs hqa hqb
  have hn : 0 ≤ spectralAmplitude s a b := by
    unfold spectralAmplitude
    exact Finset.sum_nonneg (fun i _ => mul_nonneg (hs i) (Real.sqrt_nonneg _))
  nlinarith [Real.sq_sqrt ht, Real.sqrt_nonneg t]

theorem schmidt_cap_rigidity (s q a b : ι → ℝ)
    (hs : ∀ i, 0 < s i) (hq : ∀ i, 0 ≤ q i)
    (hqa : ∀ i, q i ≤ a i) (hqb : ∀ i, q i ≤ b i)
    (heq : (∑ i, s i * Real.sqrt (q i)) = spectralAmplitude s a b) :
    ∀ i, q i = min (a i) (b i) := by
  intro i
  have hi := le_min (hqa i) (hqb i)
  by_contra hne
  have hlt : q i < min (a i) (b i) := lt_of_le_of_ne hi hne
  have hsq : Real.sqrt (q i) < Real.sqrt (min (a i) (b i)) :=
    Real.sqrt_lt_sqrt (hq i) hlt
  have hsums : (∑ j, s j * Real.sqrt (q j)) < spectralAmplitude s a b := by
    apply Finset.sum_lt_sum
    · intro j _
      exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt (le_min (hqa j) (hqb j))) (hs j).le
    · exact ⟨i, Finset.mem_univ i, mul_lt_mul_of_pos_left hsq (hs i)⟩
  linarith

theorem weighted_schmidt_equality_caps (t : ℝ) (s q a b : ι → ℝ)
    (ht : 0 ≤ t) (hs : ∀ i, 0 < s i) (hq : ∀ i, 0 ≤ q i)
    (hqa : ∀ i, q i ≤ a i) (hqb : ∀ i, q i ≤ b i)
    (htrace : Real.sqrt t ≤ ∑ i, s i * Real.sqrt (q i))
    (heq : t = (spectralAmplitude s a b)^2) :
    ∀ i, q i = min (a i) (b i) := by
  have hcap := schmidt_cap_amplitude s q a b (fun i => (hs i).le) hqa hqb
  have hnonneg : 0 ≤ (∑ i, s i * Real.sqrt (q i)) := by
    exact Finset.sum_nonneg (fun i _ => mul_nonneg (hs i).le (Real.sqrt_nonneg _))
  have hampeq : (∑ i, s i * Real.sqrt (q i)) = spectralAmplitude s a b := by
    nlinarith [Real.sq_sqrt ht, Real.sqrt_nonneg t]
  exact schmidt_cap_rigidity s q a b hs hq hqa hqb hampeq

theorem spectral_cauchy_cap (s m : ι → ℝ) (hm : ∀ i, 0 ≤ m i)
    (hsum : (∑ i, (s i)^2) = 1) :
    (∑ i, s i * Real.sqrt (m i))^2 ≤ ∑ i, m i := by
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ s (fun i => Real.sqrt (m i))
  have hm_sum : (∑ i, (Real.sqrt (m i))^2) = ∑ i, m i := by
    apply Finset.sum_congr rfl
    intro i _
    exact Real.sq_sqrt (hm i)
  simpa [hsum,hm_sum] using hcs

#print axioms weighted_schmidt_cap
#print axioms schmidt_cap_rigidity
#print axioms weighted_schmidt_equality_caps
#print axioms spectral_cauchy_cap
end MilneRefinement

end -- explicit closure of the constituent EOF section
end Source_SchmidtCap

