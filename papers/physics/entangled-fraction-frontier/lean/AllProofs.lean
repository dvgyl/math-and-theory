section Source_FixedMarginalReduction
-- moved to the generated import header

/-!
# Exact rank-one reduction for fixed quantum marginals

The main theorem is an equivalence between every uniform pure-target
expectation bound over the actual bipartite density matrices with marginals
A,B and the corresponding overlap bound over actual vectors satisfying two
positive marginal caps. This is an exact optimization reduction, not an
inequality with an assumed spectral or trace bound.

The follow-up theorem turns any optimizer of the reduced problem into an
optimizer of the density-matrix problem. Arbitrary finite rectangular
systems and singular marginals are allowed.
-/

set_option autoImplicit false
noncomputable section
open Matrix
open scoped ComplexOrder
open D5.S3.Quantum.Information.PartialTraceMutualInformation
open MilneNew.RankOneExtraction

namespace MilneExpanded

variable {a b : Type*} [Fintype a] [Fintype b] [DecidableEq a] [DecidableEq b]

def expectation (M : Matrix (a × b) (a × b) ℂ) (x : a × b → ℂ) : ℝ :=
  (star x ⬝ᵥ (M *ᵥ x)).re

def amplitude (x w : a × b → ℂ) : ℝ := ‖star x ⬝ᵥ w‖

theorem expectation_outer (x w : a × b → ℂ) :
    expectation (outer w) x = (amplitude x w)^2 := by
  unfold expectation outer amplitude
  rw [form_vecMulVec]
  have hc : star w ⬝ᵥ x = star (star x ⬝ᵥ w) := by
    exact star_dotProduct w x
  rw [hc, Complex.star_def, Complex.mul_conj]
  simp only [Complex.ofReal_re, Complex.normSq_eq_norm_sq]

theorem expectation_mono_rank_one (M : Matrix (a × b) (a × b) ℂ)
    (x w : a × b → ℂ) (h : (M - outer w).PosSemidef) :
    (amplitude x w)^2 ≤ expectation M x := by
  have hpos := (Complex.nonneg_iff.mp (h.dotProduct_mulVec_nonneg x)).1
  rw [sub_mulVec, dotProduct_sub, Complex.sub_re] at hpos
  rw [← expectation_outer]
  exact sub_nonneg.mp hpos

/-- Every state expectation can be matched by a feasible extracted vector.
The zero-expectation case uses the zero vector; no inverse is taken there. -/
theorem compatible_extraction (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (M : Matrix (a × b) (a × b) ℂ) (hM : Compatible A B M)
    (x : a × b → ℂ) :
    ∃ w : a × b → ℂ, Admissible A B w ∧
      expectation M x = (amplitude x w)^2 := by
  have ht : 0 ≤ expectation M x :=
    (Complex.nonneg_iff.mp (hM.1.dotProduct_mulVec_nonneg x)).1
  by_cases hpos : 0 < expectation M x
  · obtain ⟨w, hw, hov⟩ := normalized_extraction hM.1 x rfl hpos
    refine ⟨w, admissible_of_completion A B M w hM hw, ?_⟩
    change star x ⬝ᵥ w = (Real.sqrt (expectation M x) : ℂ) at hov
    unfold amplitude
    rw [hov, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt ht]
  · have hz : expectation M x = 0 := by linarith
    refine ⟨0, ?_, ?_⟩
    · constructor
      · have h : A.PosSemidef := hM.2.1 ▸ partialTraceRight_posSemidef hM.1
        have hzero : partialTraceRight (outer (0 : a × b → ℂ)) = 0 := by
          ext i j
          simp [partialTraceRight, outer, vecMulVec]
        rw [hzero, sub_zero]
        exact h
      · have h : B.PosSemidef := hM.2.2 ▸ partialTraceLeft_posSemidef hM.1
        have hzero : partialTraceLeft (outer (0 : a × b → ℂ)) = 0 := by
          ext i j
          simp [partialTraceLeft, outer, vecMulVec]
        rw [hzero, sub_zero]
        exact h
    · simp [hz, amplitude]

/-- Exact equality of the two optimization problems, stated without
topological or attainment assumptions as equivalence of all upper bounds. -/
theorem fixed_marginal_bound_iff (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1) (x : a × b → ℂ)
    (r : ℝ) (hr : 0 ≤ r) :
    (∀ M, Compatible A B M → expectation M x ≤ r^2) ↔
      (∀ w, Admissible A B w → amplitude x w ≤ r) := by
  constructor
  · intro h w hw
    obtain ⟨M, hM, hs⟩ := admissible_completion A B hA hB w hw
    have hlow := expectation_mono_rank_one M x w hs
    have hu := h M hM
    exact (sq_le_sq₀ (norm_nonneg _) hr).mp (hlow.trans hu)
  · intro h M hM
    obtain ⟨w, hw, heq⟩ := compatible_extraction A B M hM x
    rw [heq]
    exact pow_le_pow_left₀ (norm_nonneg _) (h w hw) 2

/-- Exact feasible-threshold equivalence, valid for every real threshold.
This records equality of the optimization problems without requiring a
maximum or supremum operator, and includes singular and rectangular cases. -/
theorem fixed_marginal_threshold_iff (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1) (x : a × b → ℂ) (t : ℝ) :
    (∃ M, Compatible A B M ∧ t ≤ expectation M x) ↔
      (∃ w, Admissible A B w ∧ t ≤ (amplitude x w)^2) := by
  constructor
  · rintro ⟨M, hM, ht⟩
    obtain ⟨w, hw, heq⟩ := compatible_extraction A B M hM x
    exact ⟨w, hw, heq ▸ ht⟩
  · rintro ⟨w, hw, ht⟩
    obtain ⟨M, hM, hs⟩ := admissible_completion A B hA hB w hw
    exact ⟨M, hM, ht.trans (expectation_mono_rank_one M x w hs)⟩

/-- A maximizing feasible vector gives an actual maximizing density matrix,
with the constructive product residual from admissible_completion. -/
theorem reduced_optimizer_gives_state_optimizer
    (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1) (x w : a × b → ℂ)
    (hw : Admissible A B w)
    (hopt : ∀ v, Admissible A B v → amplitude x v ≤ amplitude x w) :
    ∃ M, Compatible A B M ∧ expectation M x = (amplitude x w)^2 ∧
      ∀ N, Compatible A B N → expectation N x ≤ expectation M x := by
  obtain ⟨M, hM, hs⟩ := admissible_completion A B hA hB w hw
  have hbound := (fixed_marginal_bound_iff A B hA hB x (amplitude x w)
    (norm_nonneg _)).mpr hopt
  have hlow := expectation_mono_rank_one M x w hs
  have heq : expectation M x = (amplitude x w)^2 := le_antisymm (hbound M hM) hlow
  refine ⟨M, hM, heq, ?_⟩
  intro N hN
  rw [heq]
  exact hbound N hN

/-- Every actual state optimizer yields an optimizer of the smaller vector
problem. This gives the converse optimizer transfer, not just equality of
numerical upper bounds. -/
theorem state_optimizer_gives_reduced_optimizer
    (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1)
    (M : Matrix (a × b) (a × b) ℂ) (x : a × b → ℂ)
    (hM : Compatible A B M)
    (hopt : ∀ N, Compatible A B N → expectation N x ≤ expectation M x) :
    ∃ w, Admissible A B w ∧ expectation M x = (amplitude x w)^2 ∧
      ∀ v, Admissible A B v → amplitude x v ≤ amplitude x w := by
  obtain ⟨w, hw, heq⟩ := compatible_extraction A B M hM x
  refine ⟨w, hw, heq, ?_⟩
  apply (fixed_marginal_bound_iff A B hA hB x (amplitude x w)
    (norm_nonneg _)).mp
  intro N hN
  rw [← heq]
  exact hopt N hN

/-- Any positive completion of a reduced optimizer has zero residual
expectation in the target. This is the exact algebraic starting point for
the target-rank-sensitive low-rank construction in the written proof. -/
theorem optimizer_residual_expectation_zero
    (A : Matrix a a ℂ) (B : Matrix b b ℂ)
    (hA : A.trace = 1) (hB : B.trace = 1) (x w : a × b → ℂ)
    (hopt : ∀ v, Admissible A B v → amplitude x v ≤ amplitude x w)
    (M : Matrix (a × b) (a × b) ℂ) (hM : Compatible A B M)
    (hs : (M - outer w).PosSemidef) :
    expectation (M - outer w) x = 0 := by
  have hu := (fixed_marginal_bound_iff A B hA hB x (amplitude x w)
    (norm_nonneg _)).mpr hopt M hM
  have hl := expectation_mono_rank_one M x w hs
  have heq : expectation M x = (amplitude x w)^2 := le_antisymm hu hl
  have hsub : expectation (M - outer w) x =
      expectation M x - expectation (outer w) x := by
    simp only [expectation, sub_mulVec, dotProduct_sub, Complex.sub_re]
  rw [hsub, heq, expectation_outer, sub_self]

end MilneExpanded

#print axioms MilneExpanded.compatible_extraction
#print axioms MilneExpanded.fixed_marginal_bound_iff
#print axioms MilneExpanded.reduced_optimizer_gives_state_optimizer
#print axioms MilneExpanded.fixed_marginal_threshold_iff
#print axioms MilneExpanded.state_optimizer_gives_reduced_optimizer
#print axioms MilneExpanded.optimizer_residual_expectation_zero

end -- explicit closure of the constituent EOF section
end Source_FixedMarginalReduction

