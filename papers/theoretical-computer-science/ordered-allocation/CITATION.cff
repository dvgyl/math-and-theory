cff-version: 1.2.0
message: "Please cite the unpublished manuscript using the preferred citation."
title: "Ordered-instance allocation transfer with exact extra-copy preservation"
authors:
  - family-names: Goyal
    given-names: Dev D.
license: Apache-2.0
abstract: >-
  Every set-valued ordered allocation for finite goods, nonempty finite agents,
  and nonnegative additive real valuations transfers to named goods while
  preserving the total extra-copy count exactly, respecting the same uniform
  per-good extra-copy cap, covering all goods, and weakly increasing utilities.
  Input ranks may be unused. Historical novelty remains provisional.
preferred-citation:
  type: article
  title: "Ordered-instance allocation transfer with exact extra-copy preservation"
  authors:
