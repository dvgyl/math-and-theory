/-!
Auxiliary scalar certificate only.  This file does NOT formalize the claimed
application to Markov-current cumulants or the thermodynamic uncertainty bound.
It must not be described as verification of the original conjecture.
-/
namespace UnicyclicScalar
noncomputable section
set_option maxHeartbeats 4000000

def D (z : ℝ) : ℝ := 105 - 70*z - 14*z^2 - 6*z^3
def R (t z : ℝ) : ℝ := 2 * D z * t^2 - (1-z)*(D z+105)
def F (t z : ℝ) : ℝ :=
  48*t^4 - 32*t^3 - 24*t^2 + 8 + z*(24*t^2-7)
def P (t : ℝ) : ℝ :=
  10616832*t^14 - 15261696*t^13 - 20127744*t^12 +
  20336640*t^11 + 53514240*t^10 - 47832576*t^9 -
  29349376*t^8 + 30811392*t^7 + 5745408*t^6 -
  7539040*t^5 - 671776*t^4 + 645104*t^3 +
  179568*t^2 - 17623*t - 17623

theorem D_pos {z : ℝ} (hz0 : 0 ≤ z) (hz1 : z ≤ 1) : 0 < D z := by
  have h2 : z^2 ≤ 1 := pow_le_one₀ hz0 hz1
  have h3 : z^3 ≤ 1 := pow_le_one₀ hz0 hz1
  dsimp [D]
  nlinarith

